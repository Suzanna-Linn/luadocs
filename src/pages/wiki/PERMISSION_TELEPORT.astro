
---
import DocsLayout from '/src/layouts/DocsLayout.astro';
import DocsCode from '/src/components/DocsCode.astro';
---

<DocsLayout title="Lua & LSL Docs">
<div class="dashboard summary-constant">
  <div class="dashboard-header">
    <span class="lua-section"><span class="tag lua-tag">Lua</span><DocsCode code={`PERMISSION_TELEPORT: number = 4096`} lang="slua" /></span>
    <span class="lsl-section"><span class="tag lsl-tag">LSL</span><DocsCode code={`integer PERMISSION_TELEPORT = 4096;`} lang="lsl" /></span>
  </div>

  <div class="dashboard-body">
    <div class="dash-col">
      <p>  <p>The integer constant PERMISSION_TELEPORT has the value 0x1000</p>
  <p>Permission required to use <a href="https://wiki.secondlife.com/wiki/LlTeleportAgent" target="_blank">llTeleportAgent</a>.</p>
</p>
    </div>

    <div class="dash-col">
      <div class="dash-section-title">Member Of</div>
      <ul class="meta-list">
        <li>ScriptPermission</li>
      </ul>
    </div>

    <div class="dash-col">
      <div class="dash-section-title">Tech Specs</div>

      <div class="label-stack">
      </div>
    </div>
  </div>
</div>
  <h2>Caveats</h2>
  <ul>
    <li>Cannot be granted by <a href="https://wiki.secondlife.com/wiki/LlAttachToAvatarTemp" target="_blank">temporary attachments</a>. If attempted, the following error will be returned: <i>&quot;Temporary attachments cannot request runtime permissions to teleport&quot;</i></li>
  </ul>
