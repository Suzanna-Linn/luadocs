  <div class="dashboard-body">
    <div class="dash-col">
      <p>  <p>Returns a list of object keys corresponding to public attachments worn by an <b>avatar</b> in the order they were attached.</p>
</p>
      <table class="param-table" id="parameters">
        <tr>
          <td><span class="lua-section"><span class="tag lua-tag">Lua</span>uuid</span></td>
          <td><span class="lsl-section"><span class="tag lsl-tag">LSL</span>key</span></td>
          <td>AgentID / <a href="https://wiki.secondlife.com/wiki/Category:LSL_Parameters/avatar" target="_blank">avatar</a></td>
          <td>avatar <a href="https://wiki.secondlife.com/wiki/UUID" target="_blank">UUID</a> that is in the same <a href="https://wiki.secondlife.com/wiki/Region" target="_blank">region</a></td>
        </tr>
        <tr>
          <td><span class="lua-section"><span class="tag lua-tag">Lua</span>{`{any}`}</span></td>
          <td><span class="lsl-section"><span class="tag lsl-tag">LSL</span>list</span></td>
          <td>Options / <a href="https://wiki.secondlife.com/wiki/Category:LSL_Parameters/options" target="_blank">options</a></td>
          <td>A list of option for inventory transfer.</td>
        </tr>
      </table>
