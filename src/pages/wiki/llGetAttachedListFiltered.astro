  <h2>Caveats</h2>
  <p>When an avatar first arrives in a region, there is a brief period when their attachments are not yet fully rezzed or added. During this time, those attachments will not appear in the results.</p>
  <h2>Examples</h2>
<div class="lua-block"><span class="tag lua-tag">Lua</span><DocsCode code={`ll = llcompat

local function main()
    local attachments = ll.GetAttachedListFiltered(ll.GetOwner(), {FILTER_INCLUDE, ATTACH_RHAND})

    -- Object UUIDs:
    ll.OwnerSay(ll.List2CSV(attachments))

    -- Object names:
    local i = 0
    local max = #attachments
    i = 0
    while i < max do
        local name = ll.List2String(attachments, i)
        ll.OwnerSay(ll.Key2Name(name))
        i += 1
    end
end

main()
`} lang="slua" /></div>
<div class="lsl-block"><span class="tag lsl-tag">LSL</span><DocsCode code={`default
{
    state_entry()
    {
        list attachments = llGetAttachedListFiltered(llGetOwner(), [FILTER_INCLUDE, ATTACH_RHAND]);

        // Object UUIDs:
        llOwnerSay(llList2CSV(attachments));

        // Object names:
        integer i;
        integer max = llGetListLength(attachments);
        for (i = 0; i < max; ++i)
        {
            string name = llList2String(attachments, i);
            llOwnerSay(llKey2Name(name));
        }
    }
}`} lang="lsl" /></div>
