  <div class="dashboard-body">
    <div class="dash-col">
      <p>  <p>Sets the texture <b>u</b> &amp; <b>v</b> scales for the chosen <b>face</b>.</p>
</p>
      <table class="param-table" id="parameters">
        <tr>
          <td><span class="lua-section"><span class="tag lua-tag">Lua</span>number</span></td>
          <td><span class="lsl-section"><span class="tag lsl-tag">LSL</span>float</span></td>
          <td>Horizontal / u</td>
          <td>horizontal (x) scale in the interval [-100.0, 100.0]</td>
        </tr>
        <tr>
          <td><span class="lua-section"><span class="tag lua-tag">Lua</span>number</span></td>
          <td><span class="lsl-section"><span class="tag lsl-tag">LSL</span>float</span></td>
          <td>Vertical / v</td>
          <td>vertical (y) scale in the interval [-100.0, 100.0]</td>
        </tr>
