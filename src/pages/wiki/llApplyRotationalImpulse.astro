    <tbody>
      <tr>
        <th>Signature</th>
      </tr>
      <tr>
        <td><div class="lsl-block"><span class="tag lsl-tag">LSL</span><DocsCode code={`
function void llApplyRotationalImpulse( vector force, integer local );
`} lang="lsl" /></div>

</td>
