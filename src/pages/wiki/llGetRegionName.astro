</div>
  <h2>Examples</h2>
<div class="lua-block"><span class="tag lua-tag">Lua</span><DocsCode code={`-- Say what would be said by "Copy SLURL to clipboard" in the Map of the standard client

local function wwGetSLUrl()
    local globe = "http://maps.secondlife.com/secondlife"
    local region = ll.GetRegionName()
    local pos = ll.GetPos()
    local posx = tostring(ll.Round(pos.x))
    local posy = tostring(ll.Round(pos.y))
    local posz = tostring(ll.Round(pos.z))
    return globe .. "/" .. ll.EscapeURL(region) .. "/" .. posx .. "/" .. posy .. "/" .. posz
end

local function main()
    ll.OwnerSay(wwGetSLUrl())
end

main()
`} lang="slua" /></div>
<div class="lsl-block"><span class="tag lsl-tag">LSL</span><DocsCode code={`// Say what would be said by "Copy SLURL to clipboard" in the Map of the standard client

string wwGetSLUrl()
{
    string globe = "http://maps.secondlife.com/secondlife";
    string region = llGetRegionName();
    vector pos = llGetPos();
    string posx = (string)llRound(pos.x);
    string posy = (string)llRound(pos.y);
    string posz = (string)llRound(pos.z);
    return (globe + "/" + llEscapeURL(region) +"/" + posx + "/" + posy + "/" + posz);
}

default
{
    state_entry()
    {
        llOwnerSay( wwGetSLUrl() );
    }
}`} lang="lsl" /></div>
