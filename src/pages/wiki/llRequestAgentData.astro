  <h2>Caveats</h2>
  <ul>
    <li>This function causes the script to sleep for 0.1 seconds.</li>
    <li><a href="https://wiki.secondlife.com/wiki/DATA_BORN" target="_blank">DATA_BORN</a> is not UTC. It is Pacific Time based.</li>
    <li>It&#39;s worth restating: if the requested data does not exist - or if the key given is not for an agent - then <a href="https://wiki.secondlife.com/wiki/Dataserver" target="_blank">dataserver</a> will <b>not</b> be raised.</li>
  </ul>
  <h2>Examples</h2>
  <p><b>DATA_NAME</b></p>
<div class="lua-block"><span class="tag lua-tag">Lua</span><DocsCode code={`local owner_key = NULL_KEY
local owner_name_query = NULL_KEY
local owner_name = ""

local function main()
    owner_key = ll.GetOwner()
    owner_name_query = ll.RequestAgentData(owner_key, DATA_NAME)
end
function LLEvents.dataserver(queryid, data)
    if owner_name_query == queryid then
        owner_name = data
        ll.Say(0, "The owner of this script is called : " .. owner_name)
    end
end
  --Anylyn Hax 06:19, 23 July 2007 (PDT)
main()
`} lang="slua" /></div>
<div class="lsl-block"><span class="tag lsl-tag">LSL</span><DocsCode code={`key owner_key;
key owner_name_query;
string owner_name;

default
{
    state_entry()
    {
        owner_key = llGetOwner();
        owner_name_query = llRequestAgentData(owner_key, DATA_NAME);
    }
    dataserver(key queryid, string data)
    {
        if ( owner_name_query == queryid )
        {
            owner_name = data;
            llSay(0, "The owner of this script is called : " + owner_name );
        }
    }
}//Anylyn Hax 06:19, 23 July 2007 (PDT)`} lang="lsl" /></div>
  <p><b>DATA_ONLINE</b></p>
<div class="lua-block"><span class="tag lua-tag">Lua</span><DocsCode code={`ll = llcompat

local function integer(s) return tonumber(string.match(s, "^%s*([-+]?%d+)")) or 0 end

--[[
    Server friendly online status example by Daemonika Nightfire.

    It is not a big load for the server to check every 2 minutes if there is an avatar in the region.
    But it is nonsense to trigger a dataserver event for online status when nobody is in the region.
    For this purpose, the script checks the number of avatars in the region on each pass.
]]
local owner = NULL_KEY
local repeat_t = 120.0  -- 60 - 120 sec. Recommended, faster than 60 seconds and LL will kick your XXX.

local status_request = NULL_KEY
local function Status()
    local agent_count = ll.GetRegionAgentCount()
    if agent_count > 0 then  -- skip the request if nobody is in the region
        status_request = ll.RequestAgentData(owner, DATA_ONLINE)
    end
end

local function main()
    owner = ll.GetOwner()
    ll.SetTimerEvent(repeat_t)
    Status()
end

function LLEvents.timer()
    Status()
end

function LLEvents.dataserver(queryid, data)
    if queryid == status_request then
        -- requested data contains the string "0" or "1" for DATA_ONLINE
        -- i convert it to an integer and use the boolean as index

        --list index = [   0,       1,     2(0+2), 3(1+2)  ]
        local status = {"OFFLINE", "ONLINE", vector(1, 0, 0), vector(0, 1, 0)}

        local text = ll.List2String(status, integer(data))  -- boolean/index = 0   or 1
        local color = ll.List2Vector(status, integer(data) + 2)  -- boolean/index = 0+2 or 1+2

        ll.SetText(text, color, 1.0)
    end
end

function LLEvents.on_rez(Dae)
    ll.ResetScript()
end

main()
`} lang="slua" /></div>
<div class="lsl-block"><span class="tag lsl-tag">LSL</span><DocsCode code={`/*
    Server friendly online status example by Daemonika Nightfire.
    
    It is not a big load for the server to check every 2 minutes if there is an avatar in the region.
    But it is nonsense to trigger a dataserver event for online status when nobody is in the region.
    For this purpose, the script checks the number of avatars in the region on each pass.
*/


key owner;
float repeat = 120.0; // 60 - 120 sec. Recommended, faster than 60 seconds and LL will kick your XXX.

key status_request;
Status()
{
    integer agent_count = llGetRegionAgentCount();
    if(agent_count > 0) // skip the request if nobody is in the region
    {
        status_request = llRequestAgentData(owner, DATA_ONLINE);
    }
}

default
{
    state_entry()
    {
        owner = llGetOwner();
        llSetTimerEvent(repeat);
        Status();
    }

    timer()
    {
        Status();
    }
    
    dataserver(key queryid, string data)
    {
        if(queryid == status_request) 
        {
            // requested data contains the string "0" or "1" for DATA_ONLINE
            // i convert it to an integer and use the boolean as index
            
            //list index = [   0,       1,     2(0+2), 3(1+2)  ]
            list status = ["OFFLINE","ONLINE",<1,0,0>,<0,1,0>];
            
            string text = llList2String(status,(integer)data);    // boolean/index = 0   or 1
            vector color = llList2Vector(status,(integer)data+2); // boolean/index = 0+2 or 1+2
            
            llSetText(text, color, 1.0);
        }
    }
    
    on_rez(integer Dae)
    {
        llResetScript();
    }
}`} lang="lsl" /></div>
