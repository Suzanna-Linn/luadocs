<div class="lsl-block"><span class="tag lsl-tag">LSL</span><DocsCode code={`float range = llListStatistics( LIST_STAT_RANGE, numList );`} lang="lsl" /></div>
<div class="lua-block"><span class="tag lua-tag">Lua</span><DocsCode code={`local max = ll.ListStatistics(LIST_STAT_MAX, numList)
local min = ll.ListStatistics(LIST_STAT_MIN, numList)
local range = max - min`} lang="slua" /></div>
<div class="lsl-block"><span class="tag lsl-tag">LSL</span><DocsCode code={`float max = llListStatistics( LIST_STAT_MAX, numList );
float min = llListStatistics( LIST_STAT_MIN, numList );
float range = max - min;`} lang="lsl" /></div>
