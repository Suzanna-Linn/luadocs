  <div class="dashboard-body">
    <div class="dash-col">
      <p>  <p>Returns a string that is the value for <b>header</b> for <b>request_id</b>.</p>
</p>
      <table class="param-table" id="parameters">
        <tr>
          <td><span class="lua-section"><span class="tag lua-tag">Lua</span>uuid</span></td>
          <td><span class="lsl-section"><span class="tag lsl-tag">LSL</span>key</span></td>
          <td>HTTPRequestID / <a href="https://wiki.secondlife.com/wiki/Category:LSL_Key/handle" target="_blank">request_id</a></td>
          <td>A valid HTTP request key.</td>
        </tr>
        <tr>
          <td><span class="lua-section"><span class="tag lua-tag">Lua</span>string</span></td>
          <td><span class="lsl-section"><span class="tag lsl-tag">LSL</span>string</span></td>
          <td>Header / header</td>
          <td>Lower case header value name.</td>
        </tr>
      </table>
    </div>

