
---
import DocsLayout from '/src/layouts/DocsLayout.astro';
import DocsCode from '/src/components/DocsCode.astro';
---

<DocsLayout title="Lua & LSL Docs">
<div class="dashboard summary-function">
  <div class="dashboard-header">
    <span class="lua-section"><span class="tag lua-tag">Lua</span><DocsCode code={`ll.GetScale(): vector`} lang="slua" /></span>
    <span class="lsl-section"><span class="tag lsl-tag">LSL</span><DocsCode code={`vector llGetScale();`} lang="lsl" /></span>
  </div>

  <div class="dashboard-body">
    <div class="dash-col">
      <p>  <p>Returns a vector that is the scale of the prim.</p>
</p>
    </div>

    <div class="dash-col">
      <div class="dash-section-title">Categories</div>
      <ul class="meta-list">
        <li>prim</li>
      </ul>
    </div>

    <div class="dash-col">
      <div class="dash-section-title">Tech Specs</div>
      <div class="tech-item"><span class="tech-label">Energy</span><span class="tech-val">10</span></div>
      <div class="tech-item"><span class="tech-label">LSO ID</span><span class="tech-val">48</span></div>

      <div class="label-stack">
        <span class="attr-label bg-mandatory">Use Return</span>
      </div>
    </div>
  </div>
</div>
  <h2>Examples</h2>
<div class="lua-block"><span class="tag lua-tag">Lua</span><DocsCode code={`function LLEvents.touch_start(events)
    local total_number = #events
    ll.Say(0, "My dimensions are: " .. tostring(ll.GetScale()))
end
`} lang="slua" /></div>
<div class="lsl-block"><span class="tag lsl-tag">LSL</span><DocsCode code={`default
{
    touch_start(integer total_number)
    {
        llSay(0, "My dimensions are: " + (string)llGetScale());
    }
}`} lang="lsl" /></div>
  <h2>See Also</h2>
  <h3>Functions</h3>
  <table>
    <tbody>
      <tr>
        <td>•</td>
        <td><a href="https://wiki.secondlife.com/wiki/LlSetScale" target="_blank">llSetScale</a></td>
        <td>–</td>
        <td>Sets the prims size</td>
        <td></td>
      </tr>
      <tr>
        <td>•</td>
        <td><a href="https://wiki.secondlife.com/wiki/LlSetPrimitiveParams" target="_blank">llSetPrimitiveParams</a></td>
        <td>–</td>
        <td>Sets prims attributes</td>
        <td></td>
      </tr>
      <tr>
        <td>•</td>
        <td><a href="https://wiki.secondlife.com/wiki/LlGetPrimitiveParams" target="_blank">llGetPrimitiveParams</a></td>
        <td>–</td>
        <td>Gets prims attributes</td>
        <td></td>
      </tr>
    </tbody>
  </table>
  <h2>Deep Notes</h2>
  <table>
    <tbody>
      <tr>
        <th>Signature</th>
      </tr>
      <tr>
        <td><div class="lua-block"><span class="tag lua-tag">Lua</span><DocsCode code={`
function_t
ll.GetScale()
`} lang="slua" /></div>
<div class="lsl-block"><span class="tag lsl-tag">LSL</span><DocsCode code={`
