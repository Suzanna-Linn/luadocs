
---
import DocsLayout from '/src/layouts/DocsLayout.astro';
import DocsCode from '/src/components/DocsCode.astro';
---

<DocsLayout title="Lua & LSL Docs">
<div class="dashboard summary-function">
  <div class="dashboard-header">
    <span class="lua-section"><span class="tag lua-tag">Lua</span><DocsCode code={`ll.GetOmega(): vector`} lang="slua" /></span>
    <span class="lsl-section"><span class="tag lsl-tag">LSL</span><DocsCode code={`vector llGetOmega();`} lang="lsl" /></span>
  </div>

  <div class="dashboard-body">
    <div class="dash-col">
      <p>  <p>Returns a vector that is the rotation velocity of the object in radians per second.</p>
</p>
    </div>

    <div class="dash-col">
      <div class="dash-section-title">Categories</div>
      <ul class="meta-list">
        <li>movement</li>
        <li>physics</li>
      </ul>
    </div>

    <div class="dash-col">
      <div class="dash-section-title">Tech Specs</div>
      <div class="tech-item"><span class="tech-label">Energy</span><span class="tech-val">10</span></div>
      <div class="tech-item"><span class="tech-label">LSO ID</span><span class="tech-val">79</span></div>

      <div class="label-stack">
        <span class="attr-label bg-mandatory">Use Return</span>
      </div>
    </div>
  </div>
</div>
  <h2>Caveats</h2>
  <ul>
    <li>Returns the omega of the root if called in a child prim.</li>
  </ul>
  <h2>Examples</h2>
<div class="lua-block"><span class="tag lua-tag">Lua</span><DocsCode code={`local function main()
    ll.TargetOmega(vector(0, 0, 0.5), 1, 1)
end

function LLEvents.touch_start(events)
    local total_number = #events
    local omega = ll.GetOmega()
    ll.Say(0, tostring(omega))
end

main()
`} lang="slua" /></div>
<div class="lsl-block"><span class="tag lsl-tag">LSL</span><DocsCode code={`default
{
    state_entry()
    {
        llTargetOmega(<0,0,0.5>, 1, 1);
    }

    touch_start(integer total_number)
    {
        vector omega = llGetOmega();
        llSay(0, (string)omega);
    }
}`} lang="lsl" /></div>
