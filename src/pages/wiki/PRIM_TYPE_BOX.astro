        <td></td>
      </tr>
      <tr>
        <td>• float</td>
        <td>hollow</td>
        <td>–</td>
        <td>ranges from 0.0 (solid) to 0.95 (maximum hollowed)</td>
        <td></td>
      </tr>
      <tr>
        <td>• vector</td>
        <td>twist</td>
        <td>–</td>
        <td>ranges from -1.0 (-180 degree in the edit window) to 1.0 (+180 degree in the edit window) for both x and y (z is ignored)</td>
        <td></td>
