</div>
  <h2>Caveats</h2>
  <table>
    <tbody>
      <tr>
        <th>Permissions</th>
      </tr>
      <tr>
        <td>Do not depend upon the auto-grant status of permissions. <b>Always</b> use the <a href="https://wiki.secondlife.com/wiki/Run_time_permissions" target="_blank">run_time_permissions</a> event.
If the script lacks the permission <a href="https://wiki.secondlife.com/wiki/PERMISSION_CONTROL_CAMERA" target="_blank">PERMISSION_CONTROL_CAMERA</a>, the script will shout an error on <a href="https://wiki.secondlife.com/wiki/DEBUG_CHANNEL" target="_blank">DEBUG_CHANNEL</a> and the operation fails (but the script continues to run).
The <a href="https://wiki.secondlife.com/wiki/PERMISSION_CONTROL_CAMERA" target="_blank">PERMISSION_CONTROL_CAMERA</a> permission is automatically revoked when the avatar stands up from or detaches the object, and any scripted camera parameters are automatically cleared.</td>
      </tr>
    </tbody>
  </table>
  <h2>Examples</h2>
<div class="lua-block"><span class="tag lua-tag">Lua</span><DocsCode code={`ll = llcompat

local gEnabled = false

local function askForPermissions()
    ll.RequestPermissions(ll.GetOwner(), PERMISSION_CONTROL_CAMERA)
end

function LLEvents.on_rez(sp)
    ll.ResetScript()
end

local function main()
    askForPermissions()
end

function LLEvents.touch_start(events)
    local total_number = #events

    if ll.DetectedKey(0) ~= ll.GetOwner() then
        return
    elseif bit32.btest(if not (ll.GetPermissions() ~= 0) then 1 else 0, PERMISSION_CONTROL_CAMERA) then
        ll.OwnerSay("I need permissions to control your camera.")
        askForPermissions()
        return
    end

    gEnabled = not gEnabled
    if gEnabled then
        ll.OwnerSay("Enabled.")
        ll.SetCameraParams({CAMERA_ACTIVE, 1, CAMERA_DISTANCE, 50.0})
    else
        ll.OwnerSay("Disabled.")
        ll.ClearCameraParams()
    end

end

main()
`} lang="slua" /></div>
<div class="lsl-block"><span class="tag lsl-tag">LSL</span><DocsCode code={`integer gEnabled;

askForPermissions()
{
    llRequestPermissions(llGetOwner(), PERMISSION_CONTROL_CAMERA);
}

default
{

    on_rez(integer sp)
    {
        llResetScript();
    }

    state_entry()
    {
        askForPermissions();
    }

    touch_start(integer total_number)
    {

        if (llDetectedKey(0) != llGetOwner())
        {
            return;
        }
        else if (!llGetPermissions() & PERMISSION_CONTROL_CAMERA)
        {
            llOwnerSay("I need permissions to control your camera.");
            askForPermissions();
            return;
        }

        gEnabled = !gEnabled;
        if (gEnabled)
        {
            llOwnerSay("Enabled.");
            llSetCameraParams([
                CAMERA_ACTIVE, 1, 
                CAMERA_DISTANCE, 50.0
            ]);
        }
        else
        {
            llOwnerSay("Disabled.");
            llClearCameraParams();
        }

    }

}`} lang="lsl" /></div>
