        <style>
          /* Dynamic Theme Variables */
          :root {
            --bg-color: #fdfdfd;
            --btn-color: #8e44ad;
            --btn-hover: #732d91;
            --item-text: #8e44ad;
            --btn-min-width: 150px;
          }

          body { font-family: sans-serif; line-height: 1.6; padding: 20px; color: #333; background: var(--bg-color); }
          h1 { text-align: center; color: #2c3e50; }
          .info-text { text-align: center; color: #7f8c8d; margin-bottom: 20px; }

          a,
          a:visited,
          a:hover,
          a:active {
            color: inherit;
            text-decoration: none;
          }
          
          .category-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(var(--btn-min-width), 1fr));
            gap: 10px;
            margin-bottom: 50px;
          }
          .cat-button {
            display: block;
            background: var(--btn-color);
            color: white;
            text-decoration: none;
            padding: 15px 10px;
            text-align: center;
            border-radius: 5px;
            font-weight: bold;
            font-size: 0.9em;
            transition: background 0.2s;
          }
          .cat-button:hover { background: var(--btn-hover); }

          .category-section {
            background: white;
            border: 1px solid #ddd;
            border-radius: 8px;
            padding: 20px;
            margin-bottom: 30px;
            scroll-margin-top: 20px;
          }
          .category-section h2 {
            margin-top: 0;
            border-bottom: 2px solid var(--btn-color);
            padding-bottom: 5px;
            text-transform: uppercase;
            color: #2c3e50;
          }
          .item-list {
            display: flex;
            flex-wrap: wrap;
            list-style: none;
            padding: 0;
          }
          .item {
            flex: 0 0 33.33%; /* 3 columns */
            font-family: monospace;
            padding: 5px 0;
            color: var(--item-text);
          }
          .back-to-top {
            display: inline-block;
            margin-top: 10px;
            font-size: 0.8em;
            color: #999;
          }
          @media (max-width: 600px) { .item { flex: 0 0 100%; } }
        </style>
