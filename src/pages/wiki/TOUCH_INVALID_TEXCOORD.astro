
---
import DocsLayout from '/src/layouts/DocsLayout.astro';
import DocsCode from '/src/components/DocsCode.astro';
---

<DocsLayout title="Lua & LSL Docs">
<div class="dashboard summary-constant">
  <div class="dashboard-header">
    <span class="lua-section"><span class="tag lua-tag">Lua</span><DocsCode code={`TOUCH_INVALID_TEXCOORD: vector = <-1.0, -1.0, 0.0>`} lang="slua" /></span>
    <span class="lsl-section"><span class="tag lsl-tag">LSL</span><DocsCode code={`vector TOUCH_INVALID_TEXCOORD = <-1.0, -1.0, 0.0>;`} lang="lsl" /></span>
  </div>

  <div class="dashboard-body">
    <div class="dash-col">
    </div>

    <div class="dash-col">
    </div>

    <div class="dash-col">
      <div class="dash-section-title">Tech Specs</div>

      <div class="label-stack">
      </div>
    </div>
  </div>
</div>

</DocsLayout>
      