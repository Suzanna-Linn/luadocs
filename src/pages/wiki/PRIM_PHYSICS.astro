  <h2>Examples</h2>
<div class="lua-block"><span class="tag lua-tag">Lua</span><DocsCode code={`ll = llcompat

local function main()
    ll.SetPrimitiveParams({PRIM_PHYSICS, if true then 1 else 0})  -- makes the object physical...

    local isPhysical = ll.List2Integer(ll.GetPrimitiveParams({PRIM_PHYSICS}), 0)

    if isPhysical == 1 then
        ll.SetText("Object is Physical", vector(1, 1, 1), 1.0)

    else
        ll.SetText("Object is non-Physical", vector(1, 1, 1), 1.0)
    end
end

main()
`} lang="slua" /></div>
<div class="lsl-block"><span class="tag lsl-tag">LSL</span><DocsCode code={`default
{
    state_entry()
    {
        llSetPrimitiveParams([PRIM_PHYSICS, TRUE]); // makes the object physical...
        
        integer isPhysical = llList2Integer(llGetPrimitiveParams([PRIM_PHYSICS]), 0);
        
        if( isPhysical == 1 )
        {
            llSetText("Object is Physical", <1, 1, 1>, 1.0);
        }
        
        else
        {
            llSetText("Object is non-Physical", <1, 1, 1>, 1.0);
        }
    }
}`} lang="lsl" /></div>
