
---
import DocsLayout from '/src/layouts/DocsLayout.astro';
import DocsCode from '/src/components/DocsCode.astro';
---

<DocsLayout title="Lua & LSL Docs">
<div class="dashboard summary-function">
  <div class="dashboard-header">
    <span class="lua-section"><span class="tag lua-tag">Lua</span><DocsCode code={`ll.ParcelMediaQuery(QueryList: {number}): {any}`} lang="slua" /></span>
    <span class="lsl-section"><span class="tag lsl-tag">LSL</span><DocsCode code={`list llParcelMediaQuery(list QueryList);`} lang="lsl" /></span>
  </div>

  <div class="dashboard-body">
    <div class="dash-col">
      <p>  <p>Returns a list containing results of <b>query</b>. The results are in the same order as the request.</p>
</p>
      <table class="param-table" id="parameters">
        <tr>
          <td><span class="lua-section"><span class="tag lua-tag">Lua</span>{`{number}`}</span></td>
          <td><span class="lsl-section"><span class="tag lsl-tag">LSL</span>list</span></td>
          <td>QueryList / query</td>
          <td></td>
        </tr>
      </table>
    </div>

    <div class="dash-col">
      <div class="dash-section-title">Categories</div>
      <ul class="meta-list">
        <li>media</li>
        <li>parcel</li>
        <li>parcel_media</li>
      </ul>
    </div>

    <div class="dash-col">
      <div class="dash-section-title">Tech Specs</div>
      <div class="tech-item"><span class="tech-label">Sleep</span><span class="tech-val">2s</span></div>
      <div class="tech-item"><span class="tech-label">Energy</span><span class="tech-val">10</span></div>
      <div class="tech-item"><span class="tech-label">LSO ID</span><span class="tech-val">299</span></div>

      <div class="label-stack">
        <span class="attr-label bg-mandatory">Use Return</span>
      </div>
    </div>
  </div>
</div>
  <table>
    <tbody>
      <tr>
        <th></th>
        <th>Constant</th>
        <th>Return</th>
        <th>Description</th>
      </tr>
      <tr>
        <td>4</td>
        <td><a href="https://wiki.secondlife.com/wiki/PARCEL_MEDIA_COMMAND_TEXTURE" target="_blank">PARCEL_MEDIA_COMMAND_TEXTURE</a></td>
        <td><a href="https://wiki.secondlife.com/wiki/Key" target="_blank">key</a> uuid</td>
        <td>Used to get or set the parcel&#39;s media texture.</td>
