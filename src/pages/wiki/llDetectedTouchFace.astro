
---
import DocsLayout from '/src/layouts/DocsLayout.astro';
import DocsCode from '/src/components/DocsCode.astro';
---

<DocsLayout title="Lua & LSL Docs">
<div class="dashboard summary-function">
  <div class="dashboard-header">
    <span class="lua-section"><span class="tag lua-tag">Lua</span><DocsCode code={`ll.DetectedTouchFace(Index: number): number`} lang="slua" /></span>
    <span class="lsl-section"><span class="tag lsl-tag">LSL</span><DocsCode code={`integer llDetectedTouchFace(integer Index);`} lang="lsl" /></span>
  </div>

  <div class="dashboard-body">
    <div class="dash-col">
      <p>  <p>Returns an integer that is the index of the face the avatar clicked on.</p>
</p>
      <table class="param-table" id="parameters">
        <tr>
          <td><span class="lua-section"><span class="tag lua-tag">Lua</span>number</span></td>
          <td><span class="lsl-section"><span class="tag lsl-tag">LSL</span>integer</span></td>
          <td>Index / <a href="https://wiki.secondlife.com/wiki/Category:LSL_Parameters/index" target="_blank">index</a></td>
          <td><span class="lua-section"><span class="tag lua-tag">Lua</span>It's 1 based</span>Index of detection information</td>
        </tr>
      </table>
    </div>

    <div class="dash-col">
      <div class="dash-section-title">Categories</div>
      <ul class="meta-list">
        <li>detected</li>
        <li>touch</li>
      </ul>
    </div>

    <div class="dash-col">
      <div class="dash-section-title">Tech Specs</div>
      <div class="tech-item"><span class="tech-label">Energy</span><span class="tech-val">10</span></div>
      <div class="tech-item"><span class="tech-label">LSO ID</span><span class="tech-val">338</span></div>

      <div class="label-stack">
        <span class="attr-label bg-mandatory">Use Return</span>
        <span class="attr-label bg-detected">Detected Event</span>
      </div>
    </div>
  </div>
</div>
  <p><b>index</b> <i>does not</i> support <a href="https://wiki.secondlife.com/wiki/Category:LSL_Negative_Index" target="_blank">negative indexes</a>.</p>
  <p>For the <a href="https://wiki.secondlife.com/wiki/Category:LSL_Touch" target="_blank">touch</a> category of events only. The prim that was touched may not be the prim receiving the event, use <a href="https://wiki.secondlife.com/wiki/LlDetectedLinkNumber" target="_blank">llDetectedLinkNumber</a> to check for this; likewise you can use llDetectedTouchFace to determine which face was touched.</p>
  <h2>Caveats</h2>
  <ul>
    <li>If <b>index</b> is out of bounds the script continues to execute without an error message.</li>
    <li><a href="https://wiki.secondlife.com/wiki/TOUCH_INVALID_FACE" target="_blank">TOUCH_INVALID_FACE</a> is returned when...
    <ul>
      <li>The avatar's viewer does not support face touch detection.</li>
      <li>The touch has moved off the surface of the prim.</li>
      <li>The event triggered is not a <a href="https://wiki.secondlife.com/wiki/Category:LSL_Touch" target="_blank">touch</a> event.</li>
    </ul>
  
    </li>
  </ul>
  <h2>Examples</h2>
<div class="lua-block"><span class="tag lua-tag">Lua</span><DocsCode code={`ll = llcompat

-- This is the essential script to drop in a prim when you need to ascertain the number of a face (or faces)
-- Touch the prim surfaces to learn their face numbers, which you can then use in other scripts for texturing, colouring etc.

local function say(message)
    ll.Say(PUBLIC_CHANNEL, message)
end

function LLEvents.touch_start(events)
    local num_detected = #events
    local face = ll.DetectedTouchFace(0)

    if face == TOUCH_INVALID_FACE then
        --      {
        say("The touched face could not be determined")
    --      }
    else
        --      {
        say("You touched face number " .. tostring(face))
    end
--      }
end
`} lang="slua" /></div>
<div class="lsl-block"><span class="tag lsl-tag">LSL</span><DocsCode code={`// This is the essential script to drop in a prim when you need to ascertain the number of a face (or faces)
// Touch the prim surfaces to learn their face numbers, which you can then use in other scripts for texturing, colouring etc.

say(string message)
{
    llSay(PUBLIC_CHANNEL, message);
}

