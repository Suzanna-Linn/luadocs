
---
import DocsLayout from '/src/layouts/DocsLayout.astro';
import DocsCode from '/src/components/DocsCode.astro';
---

<DocsLayout title="Lua & LSL Docs">
<div class="dashboard summary-function">
  <div class="dashboard-header">
    <span class="lua-section"><span class="tag lua-tag">Lua</span><DocsCode code={`ll.SameGroup(ID: uuid): boolean`} lang="slua" /></span>
    <span class="lsl-section"><span class="tag lsl-tag">LSL</span><DocsCode code={`integer llSameGroup(key ID);`} lang="lsl" /></span>
  </div>

  <div class="dashboard-body">
    <div class="dash-col">
      <p>Returns TRUE if avatar ID is in the same region and has the same active group, otherwise FALSE.<br>Returns TRUE if the object or agent identified is in the same simulator and has the same active group as this object. Otherwise, returns FALSE.</p>
      <table class="param-table" id="parameters">
        <tr>
          <td><span class="lua-section"><span class="tag lua-tag">Lua</span>uuid</span></td>
          <td><span class="lsl-section"><span class="tag lsl-tag">LSL</span>key</span></td>
          <td>ID</td>
          <td></td>
        </tr>
      </table>
    </div>

    <div class="dash-col">
      <div class="dash-section-title">Categories</div>
      <ul class="meta-list">
        <li>object</li>
      </ul>
    </div>

    <div class="dash-col">
      <div class="dash-section-title">Tech Specs</div>
      <div class="tech-item"><span class="tech-label">Energy</span><span class="tech-val">10</span></div>
      <div class="tech-item"><span class="tech-label">LSO ID</span><span class="tech-val">219</span></div>

      <div class="label-stack">
        <span class="attr-label bg-mandatory">Use Return</span>
      </div>
    </div>
  </div>
</div>

</DocsLayout>
      