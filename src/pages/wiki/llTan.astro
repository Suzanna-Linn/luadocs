
---
import DocsLayout from '/src/layouts/DocsLayout.astro';
import DocsCode from '/src/components/DocsCode.astro';
---

<DocsLayout title="Lua & LSL Docs">
<div class="dashboard summary-function">
  <div class="dashboard-header">
    <span class="lua-section"><span class="tag lua-tag">Lua</span><DocsCode code={`ll.Tan(Theta: number): number`} lang="slua" /></span>
    <span class="lsl-section"><span class="tag lsl-tag">LSL</span><DocsCode code={`float llTan(float Theta);`} lang="lsl" /></span>
  </div>

  <div class="dashboard-body">
    <div class="dash-col">
      <p class="deprecated-text"><span class="lua-section"><span class="tag lua-tag">Lua</span>Deprecated:  use math.tan because Double precision; fastcall.</span></p>
      <p>  <p>Returns a float that is the tangent of <b>theta</b>.</p>
</p>
      <table class="param-table" id="parameters">
        <tr>
          <td><span class="lua-section"><span class="tag lua-tag">Lua</span>number</span></td>
          <td><span class="lsl-section"><span class="tag lsl-tag">LSL</span>float</span></td>
          <td>Theta / theta</td>
          <td>angle expressed in <a href="https://wiki.secondlife.com/wiki/Radians" target="_blank">radians</a></td>
        </tr>
      </table>
    </div>

    <div class="dash-col">
      <div class="dash-section-title">Categories</div>
      <ul class="meta-list">
        <li>math</li>
        <li>math_trig</li>
      </ul>
    </div>

    <div class="dash-col">
      <div class="dash-section-title">Tech Specs</div>
      <div class="tech-item"><span class="tech-label">Energy</span><span class="tech-val">10</span></div>
      <div class="tech-item"><span class="tech-label">LSO ID</span><span class="tech-val">2</span></div>

      <div class="label-stack">
        <span class="attr-label bg-pure">Side-Effect Free</span>
        <span class="attr-label bg-native">Native Coded</span>
        <span class="lua-section attr-label bg-deprecated">Lua Deprecated</span>
      </div>
    </div>
  </div>
</div>
  <h2>Caveats</h2>
  <p>Because of IEE754 on floats , llTan(PI_BY_TWO) returns -22877332 ( hex: 0xCBAE8A4A) and not infinity</p>
  <h2>Examples</h2>
<div class="lua-block"><span class="tag lua-tag">Lua</span><DocsCode code={`-- Touch the object with this script in it to see the tangent of random numbers!
function LLEvents.touch_start(events)
    local num = #events
    local r = ll.Frand(TWO_PI)
    ll.OwnerSay("The tangent of " .. tostring(r) .. " in radians or " .. tostring(r * RAD_TO_DEG) .. " in degrees is " .. tostring(ll.Tan(r)))
end
`} lang="slua" /></div>
<div class="lsl-block"><span class="tag lsl-tag">LSL</span><DocsCode code={`// Touch the object with this script in it to see the tangent of random numbers!
default
{
    touch_start(integer num)
    {
        float r = llFrand(TWO_PI);
        llOwnerSay("The tangent of " + (string)r + " in radians or " + (string)(r * RAD_TO_DEG) + " in degrees is " + (string)llTan(r));
    }
}`} lang="lsl" /></div>
