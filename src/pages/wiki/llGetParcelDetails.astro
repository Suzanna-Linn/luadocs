  <h2>Caveats</h2>
  <ul>
    <li>This cannot be used to get the parcel details of parcels in neighboring regions.</li>
  </ul>
  <h2>Examples</h2>
  <p>A very simple example to return the parcel name and description for the current parcel.</p>
<div class="lua-block"><span class="tag lua-tag">Lua</span><DocsCode code={`ll = llcompat

function LLEvents.touch_start(events)
    local total_number = #events
    local details = ll.GetParcelDetails(ll.GetPos(), {PARCEL_DETAILS_NAME, PARCEL_DETAILS_DESC})

    ll.Say(0, "Local Parcel Name:" .. ll.List2String(details, 0))
    ll.Say(0, "Local Parcel Desc:" .. ll.List2String(details, 1))
end
`} lang="slua" /></div>
<div class="lsl-block"><span class="tag lsl-tag">LSL</span><DocsCode code={`default
{
    touch_start(integer total_number)
    {
        list details = llGetParcelDetails(llGetPos(), [PARCEL_DETAILS_NAME, PARCEL_DETAILS_DESC]);
        
        llSay(0, "Local Parcel Name:" + llList2String(details ,0));
        llSay(0, "Local Parcel Desc:" + llList2String(details ,1));
    }
}`} lang="lsl" /></div>
