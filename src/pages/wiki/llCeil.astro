    <tbody>
      <tr>
        <td>•</td>
        <td><a href="https://wiki.secondlife.com/wiki/LlRound" target="_blank">llRound</a></td>
        <td>–</td>
        <td>Rounds the float to an integer towards the closest integer</td>
        <td></td>
      </tr>
      <tr>
        <td>•</td>
        <td><a href="https://wiki.secondlife.com/wiki/LlFloor" target="_blank">llFloor</a></td>
        <td>–</td>
        <td>Rounds the float to an integer towards negative infinity</td>
        <td></td>
      </tr>
    </tbody>
  </table>
  <h2>Deep Notes</h2>
  <table>
    <tbody>
      <tr>
        <th>Signature</th>
      </tr>
      <tr>
        <td><div class="lsl-block"><span class="tag lsl-tag">LSL</span><DocsCode code={`
