
---
import DocsLayout from '/src/layouts/DocsLayout.astro';
import DocsCode from '/src/components/DocsCode.astro';
---

<DocsLayout title="Lua & LSL Docs">
<div class="dashboard summary-function">
  <div class="dashboard-header">
    <span class="lua-section"><span class="tag lua-tag">Lua</span><DocsCode code={`ll.Ceil(Value: number): number`} lang="slua" /></span>
    <span class="lsl-section"><span class="tag lsl-tag">LSL</span><DocsCode code={`integer llCeil(float Value);`} lang="lsl" /></span>
  </div>

  <div class="dashboard-body">
    <div class="dash-col">
      <p class="deprecated-text"><span class="lua-section"><span class="tag lua-tag">Lua</span>Deprecated:  use math.ceil because Fastcall.</span></p>
      <p>  <p>Returns an integer that is the integer value of <b>val</b> rounded towards positive infinity `(return &gt;= **val**)`.</p>
</p>
      <table class="param-table" id="parameters">
        <tr>
          <td><span class="lua-section"><span class="tag lua-tag">Lua</span>number</span></td>
          <td><span class="lsl-section"><span class="tag lsl-tag">LSL</span>float</span></td>
          <td>Value / <a href="https://wiki.secondlife.com/wiki/Category:LSL_Parameters/val" target="_blank">val</a></td>
          <td>Any valid float value</td>
        </tr>
      </table>
    </div>

    <div class="dash-col">
      <div class="dash-section-title">Categories</div>
      <ul class="meta-list">
        <li>math</li>
      </ul>
    </div>

    <div class="dash-col">
      <div class="dash-section-title">Tech Specs</div>
      <div class="tech-item"><span class="tech-label">Energy</span><span class="tech-val">10</span></div>
      <div class="tech-item"><span class="tech-label">LSO ID</span><span class="tech-val">10</span></div>

      <div class="label-stack">
        <span class="attr-label bg-pure">Side-Effect Free</span>
        <span class="attr-label bg-native">Native Coded</span>
        <span class="lua-section attr-label bg-deprecated">Lua Deprecated</span>
      </div>
    </div>
  </div>
</div>
  <h2>Caveats</h2>
  <ul>
    <li>The returned value is -2147483648 (0x80000000) if the arithmetic result is outside of the range of valid integers (-2147483648 to 2147483647)</li>
  </ul>
  <h2>Examples</h2>
<div class="lua-block"><span class="tag lua-tag">Lua</span><DocsCode code={`local function main()
    ll.Say(0, "The ceil value of -4.5 is: " .. tostring(ll.Ceil(-4.5)))
    --              "The ceil value of -4.5 is: -4"

    ll.Say(0, "The ceil value of -4.9 is: " .. tostring(ll.Ceil(-4.9)))
    --              "The ceil value of -4.9 is: -4"

    ll.Say(0, "The ceil value of -4.1 is: " .. tostring(ll.Ceil(-4.1)))
    --              "The ceil value of -4.1 is: -4"

    ll.Say(0, "The ceil value of 4.5 is: " .. tostring(ll.Ceil(4.5)))
    --              "The ceil value of 4.5 is: 5"

    ll.Say(0, "The ceil value of 4.9 is: " .. tostring(ll.Ceil(4.9)))
    --              "The ceil value of 4.9 is: 5"

    ll.Say(0, "The ceil value of 4.1 is: " .. tostring(ll.Ceil(4.1)))
--              "The ceil value of 4.1 is: 5"
end

main()
`} lang="slua" /></div>
<div class="lsl-block"><span class="tag lsl-tag">LSL</span><DocsCode code={`default
{
   state_entry()
   {
       llSay(0, "The ceil value of -4.5 is: " + (string)llCeil(-4.5));
//              "The ceil value of -4.5 is: -4"

       llSay(0, "The ceil value of -4.9 is: " + (string)llCeil(-4.9));
//              "The ceil value of -4.9 is: -4"

       llSay(0, "The ceil value of -4.1 is: " + (string)llCeil(-4.1));
//              "The ceil value of -4.1 is: -4"

       llSay(0, "The ceil value of 4.5 is: " + (string)llCeil(4.5));
//              "The ceil value of 4.5 is: 5"

       llSay(0, "The ceil value of 4.9 is: " + (string)llCeil(4.9));
//              "The ceil value of 4.9 is: 5"

       llSay(0, "The ceil value of 4.1 is: " + (string)llCeil(4.1));
//              "The ceil value of 4.1 is: 5"
    }
}`} lang="lsl" /></div>
