  <h2>Caveats</h2>
  <ul>
    <li>This function causes the script to sleep for 1.0 seconds.</li>
    <li>The function silently fails if its <b>face</b> value indicates a face that does not exist.</li>
  </ul>
  <h2>Examples</h2>
<div class="lua-block"><span class="tag lua-tag">Lua</span><DocsCode code={`--  when dropping this script into a prim
--  it will remove all set media-on-a-prim
--  on all sides of the prim containing the script
--  and then the script will delete itself

local function publish_returned_status_flag(inputLink, inputFace, inputStatus)
    local outputStatus = "STATUS_OK"  --[[ if (inputInteger == 0) ]]
    if inputStatus == 1000 then
        outputStatus = "STATUS_MALFORMED_PARAMS"
    elseif inputStatus == 1001 then
        outputStatus = "STATUS_TYPE_MISMATCH"
    elseif inputStatus == 1002 then
        outputStatus = "STATUS_BOUNDS_ERROR"
    elseif inputStatus == 1003 then
        outputStatus = "STATUS_NOT_FOUND"
    elseif inputStatus == 1004 then
        outputStatus = "STATUS_NOT_SUPPORTED"
    elseif inputStatus == 1999 then
        outputStatus = "STATUS_INTERNAL_ERROR"
    elseif inputStatus == 2001 then
        outputStatus = "STATUS_WHITELIST_FAILED"
    end

    -- PUBLIC_CHANNEL has the integer value 0
    ll.Say(PUBLIC_CHANNEL, "llClearLinkMedia(link " .. tostring(inputLink) .. ", face " .. tostring(inputFace) .. ") = " .. outputStatus .. ";")
end

local function main()
    local link = ll.GetLinkNumber()
    local numOfSides = ll.GetLinkNumberOfSides(link)
    local face = 0

    repeat
        local clearMediaSucceeded = ll.ClearPrimMedia(face)
        publish_returned_status_flag(link, face, clearMediaSucceeded)

        face += 1
    until not (face < numOfSides)

    local thisScript = ll.GetScriptName()
    ll.RemoveInventory(thisScript)
end

main()
`} lang="slua" /></div>
<div class="lsl-block"><span class="tag lsl-tag">LSL</span><DocsCode code={`//  when dropping this script into a prim
//  it will remove all set media-on-a-prim
//  on all sides of the prim containing the script
//  and then the script will delete itself



publish_returned_status_flag(integer inputLink, integer inputFace, integer inputStatus)
{
    /* if (inputInteger == 0) */ string outputStatus = "STATUS_OK";
    if (inputStatus == 1000) outputStatus = "STATUS_MALFORMED_PARAMS";
    else if (inputStatus == 1001) outputStatus = "STATUS_TYPE_MISMATCH";
    else if (inputStatus == 1002) outputStatus = "STATUS_BOUNDS_ERROR";
    else if (inputStatus == 1003) outputStatus = "STATUS_NOT_FOUND";
    else if (inputStatus == 1004) outputStatus = "STATUS_NOT_SUPPORTED";
    else if (inputStatus == 1999) outputStatus = "STATUS_INTERNAL_ERROR";
    else if (inputStatus == 2001) outputStatus = "STATUS_WHITELIST_FAILED";

    // PUBLIC_CHANNEL has the integer value 0
    llSay(PUBLIC_CHANNEL, "llClearLinkMedia(link " + (string)inputLink
        + ", face " + (string)inputFace + ") = " + outputStatus + ";");
}

default
{
    state_entry()
    {
        integer link = llGetLinkNumber();
        integer numOfSides = llGetLinkNumberOfSides(link);
        integer face;

        do
        {
            integer clearMediaSucceeded = llClearPrimMedia(face);
            publish_returned_status_flag(link, face, clearMediaSucceeded);

            ++face;
        }
        while (face < numOfSides);

        string thisScript = llGetScriptName();
        llRemoveInventory(thisScript);
    }
}`} lang="lsl" /></div>
