
---
import DocsLayout from '/src/layouts/DocsLayout.astro';
import DocsCode from '/src/components/DocsCode.astro';
---

<DocsLayout title="Lua & LSL Docs">
<div class="dashboard summary-function">
  <div class="dashboard-header">
    <span class="lua-section"><span class="tag lua-tag">Lua</span><DocsCode code={`ll.TakeCamera(AvatarID: uuid)`} lang="slua" /></span>
    <span class="lsl-section"><span class="tag lsl-tag">LSL</span><DocsCode code={`llTakeCamera(key AvatarID);`} lang="lsl" /></span>
  </div>

  <div class="dashboard-body">
    <div class="dash-col">
      <p class="deprecated-text"">Deprecated:  use ll.SetCameraParams</p>
      <p>  <p>This function is recognized by the compiler, but was never implemented in Second Life.</p>
</p>
      <table class="param-table" id="parameters">
        <tr>
          <td><span class="lua-section"><span class="tag lua-tag">Lua</span>uuid</span></td>
          <td><span class="lsl-section"><span class="tag lsl-tag">LSL</span>key</span></td>
          <td>AvatarID / <a href="https://wiki.secondlife.com/wiki/Category:LSL_Parameters/avatar" target="_blank">avatar</a></td>
          <td>avatar <a href="https://wiki.secondlife.com/wiki/UUID" target="_blank">UUID</a> that is in the same <a href="https://wiki.secondlife.com/wiki/Region" target="_blank">region</a></td>
        </tr>
      </table>
    </div>

    <div class="dash-col">
      <div class="dash-section-title">Categories</div>
      <ul class="meta-list">
        <li>avatar</li>
        <li>camera</li>
        <li>permissions</li>
      </ul>
    </div>

    <div class="dash-col">
      <div class="dash-section-title">Tech Specs</div>
      <div class="tech-item"><span class="tech-label">Energy</span><span class="tech-val">10</span></div>
      <div class="tech-item"><span class="tech-label">LSO ID</span><span class="tech-val">115</span></div>

      <div class="label-stack">
        <span class="attr-label bg-deprecated">Deprecated</span>
      </div>
    </div>
  </div>
</div>
  <h2>Caveats</h2>
  <ul>
    <li>This function has been deprecated, please use <a href="https://wiki.secondlife.com/wiki/LlSetCameraParams" target="_blank">llSetCameraParams</a> instead.</li>
  </ul>
  <h2>Deep Notes</h2>
  <table>
    <tbody>
      <tr>
        <th>Signature</th>
      </tr>
      <tr>
        <td><div class="lsl-block"><span class="tag lsl-tag">LSL</span><DocsCode code={`
function void llTakeCamera( key avatar );
`} lang="lsl" /></div>

</td>
      </tr>
    </tbody>
  </table>

</DocsLayout>
      