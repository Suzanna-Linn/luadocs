  <h2>llSetPrimitiveParams</h2>
  <p><b> <a href="https://wiki.secondlife.com/wiki/Integer" target="_blank">&#32;PRIM_GLTF_BASE_COLOR,&#32;[integer</a> face, <a href="https://wiki.secondlife.com/wiki/String" target="_blank">string</a> texture, <a href="https://wiki.secondlife.com/wiki/Vector" target="_blank">vector</a> repeats, <a href="https://wiki.secondlife.com/wiki/Vector" target="_blank">vector</a> offsets, <a href="https://wiki.secondlife.com/wiki/Float" target="_blank">float</a> rot, <a href="https://wiki.secondlife.com/wiki/Vector" target="_blank">vector</a> tint_color, <a href="https://wiki.secondlife.com/wiki/Float" target="_blank">float</a> alpha, <a href="https://wiki.secondlife.com/wiki/Integer" target="_blank">integer</a> alpha_mode, <a href="https://wiki.secondlife.com/wiki/Float" target="_blank">float</a> alpha_mask_cutoff, <a href="https://wiki.secondlife.com/wiki/Integer" target="_blank">integer</a> double_sided ] </b></p>
