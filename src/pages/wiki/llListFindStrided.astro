import DocsCode from '/src/components/DocsCode.astro';
---

<DocsLayout title="Lua & LSL Docs">
<div class="dashboard summary-function">
  <div class="dashboard-header">
    <span class="lua-section"><span class="tag lua-tag">Lua</span><DocsCode code={`ll.ListFindStrided(ListVariable: {any}, Find: {any}, Start: number, End: number, Stride: number): number?`} lang="slua" /></span>
    <span class="lsl-section"><span class="tag lsl-tag">LSL</span><DocsCode code={`integer llListFindStrided(list ListVariable, list Find, integer Start, integer End, integer Stride);`} lang="lsl" /></span>
  </div>

  <div class="dashboard-body">
    <div class="dash-col">
      <p class="deprecated-text"><span class="lua-section"><span class="tag lua-tag">Lua</span>Deprecated:  Prefer dictionary lookups over strided list searches.</span></p>
      <p>  <p>Returns the integer index of the first instance of <b>test</b> in <b>src</b> matching conditions.</p>
</p>
      <p><span class="lua-section"><span class="tag lua-tag">Lua</span>Returns nil when not found</span></p>
      <table class="param-table" id="parameters">
        <tr>
          <td><span class="lua-section"><span class="tag lua-tag">Lua</span>{`{any}`}</span></td>
          <td><span class="lsl-section"><span class="tag lsl-tag">LSL</span>list</span></td>
          <td>ListVariable / src</td>
          <td>what to search in (haystack)</td>
        </tr>
        <tr>
          <td><span class="lua-section"><span class="tag lua-tag">Lua</span>{`{any}`}</span></td>
          <td><span class="lsl-section"><span class="tag lsl-tag">LSL</span>list</span></td>
          <td>Find / test</td>
          <td>what to search for (needle)</td>
        </tr>
        <tr>
          <td><span class="lua-section"><span class="tag lua-tag">Lua</span>number</span></td>
          <td><span class="lsl-section"><span class="tag lsl-tag">LSL</span>integer</span></td>
          <td>Start / start</td>
          <td><span class="lua-section"><span class="tag lua-tag">Lua</span>It's 1 based</span>Start of range to search</td>
        </tr>
        <tr>
          <td><span class="lua-section"><span class="tag lua-tag">Lua</span>number</span></td>
          <td><span class="lsl-section"><span class="tag lsl-tag">LSL</span>integer</span></td>
          <td>End / end</td>
          <td><span class="lua-section"><span class="tag lua-tag">Lua</span>It's 1 based</span>End of range to search</td>
        </tr>
        <tr>
          <td><span class="lua-section"><span class="tag lua-tag">Lua</span>number</span></td>
          <td><span class="lsl-section"><span class="tag lsl-tag">LSL</span>integer</span></td>
          <td>Stride / stride</td>
          <td>Number of entries per stride within src</td>
        </tr>
      </table>
    </div>

    <div class="dash-col">
      <div class="dash-section-title">Categories</div>
      <ul class="meta-list">
        <li>list</li>
      </ul>
    </div>

    <div class="dash-col">
      <div class="dash-section-title">Tech Specs</div>
      <div class="tech-item"><span class="tech-label">Energy</span><span class="tech-val">10</span></div>
      <div class="tech-item"><span class="tech-label">LSO ID</span><span class="tech-val">800</span></div>

      <div class="label-stack">
        <span class="attr-label bg-mandatory">Use Return</span>
        <span class="lua-section attr-label bg-deprecated">Lua Deprecated</span>
      </div>
    </div>
  </div>
</div>
  <p>If <b>test</b> matching range and stride conditions is not found in <b>src</b>, -1 (in LSL) or nil (in SLua) is returned.</p>
  <p>The length of <b>test</b> may be equal to or less than <b>stride</b> in order to generate a match.</p>
  <p>The index of the first entry in the list is 0</p>
  <p>If <b>test</b> is found at the last index in <b>src</b> the positive index is returned (5th entry of 5 returns 4).</p>
  <p>If <b>start</b> or <b>end</b> is negative, it is counted from the end list. The last element in the list is -1, the first is -list_length</p>
  <h2>Caveats</h2>
  <ul>
    <li>Strict type matching and case sensitivity is enforced.
    <ul>
      <li>"1" != 1</li>
      <li>"1.0" != 1.0</li>
      <li>1 != 1.0</li>
      <li>"a822ff2b-ff02-461d-b45d-dcd10a2de0c2" != (key)"a822ff2b-ff02-461d-b45d-dcd10a2de0c2"</li>
      <li>"Justice" != "justice"</li>
    </ul>
  
    </li>
    <li>If <b>test</b> is an empty list the value returned is 0 rather than -1.</li>
  </ul>
  <h2>Examples</h2>
<div class="lua-block"><span class="tag lua-tag">Lua</span><DocsCode code={`ll = llcompat

local mylist = {"a", 0, "b", 1, "c", 2, "b", 1}

local result_a = ll.ListFindStrided(mylist, {"b"}, 0, -1, 1)  --Stride 1 full range functionally equivalent to llListFindList(mylist,"b");
--result_a = 2

local result_b = ll.ListFindStrided(mylist, {"b", 1}, 2, -1, 1)  --Inclusive range for start and end will find 2nd list in list
--result_b = 2

local result_c = ll.ListFindStrided(mylist, {"b"}, 3, -1, 1)  --The first "b" is at index 2 and will be skipped by starting at 3
--result_c = 6

local result_d = ll.ListFindStrided(mylist, {"b", 1}, 2, -1, 1)  --Inclusive range for start and end will find 2nd item in list
--result_d = 2

local result_e = ll.ListFindStrided(mylist, {"b", 1}, 3, -1, 1)  --The first "b",1 series is at index 2 and will be skipped by starting at 3
--result_e = 6

local result_f = ll.ListFindStrided(mylist, {"b", 1}, 3, -2, 1)  --The first "b",1 series is at index 2 and will be skipped by starting at 3.  The second ["b",1] set exceeds the range criteria of the search.
--result_f = -1

local result_g = ll.ListFindStrided(mylist, {"b", 2}, 0, -1, 1)  --No consecutive elements match ["b",2]
--result_g = -1

local result_h = ll.ListFindStrided(mylist, {"c"}, 0, -1, 2)  --With a stride of 2, "c" will be found.
--result_h = 4

local result_i = ll.ListFindStrided(mylist, {"c"}, 0, -1, 3)  --With a stride of 3, "c" won't be found.
--result_i = -1

local result_j = ll.ListFindStrided(mylist, {"c"}, 0, -1, 4)  --With a stride of 4, "c" will be found.
--result_j = 4

local result_k = ll.ListFindStrided(mylist, {"c"}, 1, -1, 2)  --While the stride is even, starting at the 2nd element will miss this stride.
--result_k = -1`} lang="slua" /></div>
