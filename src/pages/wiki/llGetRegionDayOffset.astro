<DocsLayout title="Lua & LSL Docs">
<div class="dashboard summary-function">
  <div class="dashboard-header">
    <span class="lua-section"><span class="tag lua-tag">Lua</span><DocsCode code={`ll.GetRegionDayOffset(): number`} lang="slua" /></span>
    <span class="lsl-section"><span class="tag lsl-tag">LSL</span><DocsCode code={`integer llGetRegionDayOffset();`} lang="lsl" /></span>
  </div>

  <div class="dashboard-body">
    <div class="dash-col">
      <p>  <p>Return the number of seconds added to the current time before calculating the current environmental time for the region. <a href="https://wiki.secondlife.com/wiki/LlGetDayOffset" target="_blank">llGetDayOffset </a> returns the value for the current parcel, llGetRegionDayOffset produces the same value for the entire region.</p>
  <p>Returns an integer</p>
</p>
    </div>

    <div class="dash-col">
      <div class="dash-section-title">Categories</div>
      <ul class="meta-list">
        <li>region</li>
        <li>time</li>
      </ul>
    </div>

    <div class="dash-col">
      <div class="dash-section-title">Tech Specs</div>
      <div class="tech-item"><span class="tech-label">Energy</span><span class="tech-val">10</span></div>
      <div class="tech-item"><span class="tech-label">LSO ID</span><span class="tech-val">706</span></div>

      <div class="label-stack">
        <span class="attr-label bg-mandatory">Use Return</span>
      </div>
    </div>
  </div>
</div>
  <h2>Examples</h2>
<div class="lua-block"><span class="tag lua-tag">Lua</span><DocsCode code={`ll = llcompat

local function integer(s) return tonumber(string.match(s, "^%s*([-+]?%d+)")) or 0 end

-- print the apparent time of day as HH:MM (%), just like the environment window in the viewer.
-- Time of day is a fraction between 0 and 1, 0 is midnight, 0.5 is noon
local function printTimeOfDay(dayFraction)
    local hours = integer(dayFraction * 24)
    local minutes = integer(dayFraction * 24 * 60) % 60
    local percent = integer(dayFraction * 100)
    return tostring(hours) .. ":" .. ll.GetSubString(tostring(100 + minutes), 1, 2) .. " (" .. tostring(percent) .. "%)"
end

local function main()
    ll.SetTimerEvent(5)
end

function LLEvents.timer()
    local timeOfDay = (ll.GetUnixTime() + ll.GetRegionDayOffset()) % ll.GetRegionDayLength() * 1.0 / ll.GetRegionDayLength()
    ll.SetText(printTimeOfDay(timeOfDay), vector(1, 1, 0), 1)
end

main()
`} lang="slua" /></div>
<div class="lsl-block"><span class="tag lsl-tag">LSL</span><DocsCode code={`// print the apparent time of day as HH:MM (%), just like the environment window in the viewer.
// Time of day is a fraction between 0 and 1, 0 is midnight, 0.5 is noon
string printTimeOfDay(float dayFraction) {
    integer hours = (integer)(dayFraction * 24);
    integer minutes = (integer)(dayFraction * 24 * 60) % 60;
    integer percent = (integer)(dayFraction * 100);
    return (string)hours + ":" + llGetSubString((string)(100+minutes), 1, 2) + " (" + (string)percent + "%)";
}

default {
    state_entry() {
        llSetTimerEvent(5);
    }

    timer() {
        float timeOfDay = (llGetUnixTime() + llGetRegionDayOffset()) % llGetRegionDayLength() * 1.0 / llGetRegionDayLength();
        llSetText(printTimeOfDay(timeOfDay), <1,1,0>, 1);
    }
}`} lang="lsl" /></div>
