  <h2>Examples</h2>
<div class="lua-block"><span class="tag lua-tag">Lua</span><DocsCode code={`-- Show results for each operation for a sample list
local function main()
    local LX = {-1, 3.33, 17, "object", -4.5, 0.8675}

    ll.Say(0, "G.Mean= " .. tostring(ll.ListStatistics(LIST_STAT_GEOMETRIC_MEAN, LX)))  -- 0. 000000
    ll.Say(0, "Max= " .. tostring(ll.ListStatistics(LIST_STAT_MAX, LX)))  -- 17.000000
    ll.Say(0, "Min= " .. tostring(ll.ListStatistics(LIST_STAT_MIN, LX)))  -- -4.500000
    ll.Say(0, "Mean= " .. tostring(ll.ListStatistics(LIST_STAT_MEAN, LX)))  -- 3.139500
    ll.Say(0, "Median= " .. tostring(ll.ListStatistics(LIST_STAT_MEDIAN, LX)))  -- 0.867500
    ll.Say(0, "Count= " .. tostring(ll.ListStatistics(LIST_STAT_NUM_COUNT, LX)))  -- 5.000000
    ll.Say(0, "Range= " .. tostring(ll.ListStatistics(LIST_STAT_RANGE, LX)))  -- 21.500000
    ll.Say(0, "Std.Dev= " .. tostring(ll.ListStatistics(LIST_STAT_STD_DEV, LX)))  -- 8.258468
    ll.Say(0, "Sum= " .. tostring(ll.ListStatistics(LIST_STAT_SUM, LX)))  -- 15.697500
    ll.Say(0, "Sum of squares= " .. tostring(ll.ListStatistics(LIST_STAT_SUM_SQUARES, LX)))  -- 322.091500

end

main()
`} lang="slua" /></div>
<div class="lsl-block"><span class="tag lsl-tag">LSL</span><DocsCode code={`// Show results for each operation for a sample list
default
{
    state_entry()
    {
        list LX = [-1, 3.33, 17, "object", -4.5, 0.8675 ];

        llSay(0, "G.Mean= " + (string) llListStatistics(LIST_STAT_GEOMETRIC_MEAN, LX) );           // 0. 000000
        llSay(0, "Max= " + (string) llListStatistics(LIST_STAT_MAX, LX) );                         // 17.000000
        llSay(0, "Min= " + (string) llListStatistics(LIST_STAT_MIN, LX) );                         // -4.500000
        llSay(0, "Mean= " + (string) llListStatistics(LIST_STAT_MEAN, LX) );                       // 3.139500
        llSay(0, "Median= " + (string) llListStatistics(LIST_STAT_MEDIAN, LX) );                   // 0.867500
        llSay(0, "Count= " + (string) llListStatistics(LIST_STAT_NUM_COUNT, LX) );                 // 5.000000
        llSay(0, "Range= " + (string) llListStatistics(LIST_STAT_RANGE, LX) );                     // 21.500000
        llSay(0, "Std.Dev= " + (string) llListStatistics(LIST_STAT_STD_DEV, LX) );                 // 8.258468
        llSay(0, "Sum= " + (string) llListStatistics(LIST_STAT_SUM, LX) );                         // 15.697500
        llSay(0, "Sum of squares= " + (string) llListStatistics(LIST_STAT_SUM_SQUARES, LX) );      // 322.091500

    }
}
// Note that LSLEditor produces "NaN" (Not A Number) for the geometric mean above. Geometric mean applies only to numbers of the same sign.`} lang="lsl" /></div>
<div class="lua-block"><span class="tag lua-tag">Lua</span><DocsCode code={`ll = llcompat

-- shows just how bad SL is behaving and demonstrates the use of llListStatistics()
local dil_s = {}
local fps_s = {}
local ticks = 0

local function main()
    ll.SetTimerEvent(1.0)
end

function LLEvents.on_rez(parm)
    ll.ResetScript()
end

function LLEvents.timer()
    dil_s = ll.List2List(ll.ListInsertList(dil_s, {ll.GetRegionTimeDilation()}, #dil_s), -60, -1)
    fps_s = ll.List2List(ll.ListInsertList(fps_s, {ll.GetRegionFPS()}, #fps_s), -60, -1)
    if 3 <= (function() ticks += 1 return ticks end)() then
        --yellow
        ll.SetText("Dilation: min=" .. tostring(ll.ListStatistics(LIST_STAT_MIN, dil_s)) .. ", mean=" .. tostring(ll.ListStatistics(LIST_STAT_MEAN, dil_s)) .. ", max=" .. tostring(ll.ListStatistics(LIST_STAT_MAX, dil_s)) .. ", std.dev=" .. tostring(ll.ListStatistics(LIST_STAT_STD_DEV, dil_s)) .. "\n" .. "FPS: min=" .. tostring(ll.ListStatistics(LIST_STAT_MIN, fps_s)) .. ", mean=" .. tostring(ll.ListStatistics(LIST_STAT_MEAN, fps_s)) .. ", max=" .. tostring(ll.ListStatistics(LIST_STAT_MAX, fps_s)) .. ", std.dev=" .. tostring(ll.ListStatistics(LIST_STAT_STD_DEV, fps_s)), vector(1.0, 1.0, 0.0), 1.0)
    end
end

function LLEvents.changed(change)
    if bit32.btest(change, CHANGED_REGION) then
        ll.ResetScript()
    end
end

main()
`} lang="slua" /></div>
<div class="lsl-block"><span class="tag lsl-tag">LSL</span><DocsCode code={`// shows just how bad SL is behaving and demonstrates the use of llListStatistics()
list dil_s;
list fps_s;
integer ticks = 0;

default
{
    state_entry()
    {
        llSetTimerEvent(1.0);
    }
    
    on_rez (integer parm)
    {
        llResetScript();
    }
    
    timer()
    {
        dil_s = llList2List(dil_s + llGetRegionTimeDilation(), -60, -1);
        fps_s = llList2List(fps_s + llGetRegionFPS(), -60, -1);
        if(3 <= ++ticks)
        {
            llSetText(
                "Dilation: min="+(string) llListStatistics(LIST_STAT_MIN, dil_s) + ", mean=" +
                    (string) llListStatistics(LIST_STAT_MEAN, dil_s) + ", max=" +
                    (string) llListStatistics(LIST_STAT_MAX, dil_s) + ", std.dev=" +
                    (string) llListStatistics(LIST_STAT_STD_DEV, dil_s) + "\n" + 
                    "FPS: min="+(string) llListStatistics(LIST_STAT_MIN, fps_s) + ", mean=" +
                    (string) llListStatistics(LIST_STAT_MEAN, fps_s) + ", max=" +
                    (string) llListStatistics(LIST_STAT_MAX, fps_s) + ", std.dev=" +
                    (string) llListStatistics(LIST_STAT_STD_DEV, fps_s),
                <1.0, 1.0, 0.0>, //yellow
                1.0);
        }
    }
    
    changed(integer change)
    {
        if(change & CHANGED_REGION)
        {
            llResetScript();
        }
    }
}`} lang="lsl" /></div>
  <h2>Notes</h2>
  <p>Given that this operation ignores any non-numbers in a list, it can be used to tell you, in a mixed list, how many of the elements in a list are numbers (when used with the <a href="https://wiki.secondlife.com/wiki/LIST_STAT_NUM_COUNT" target="_blank">LIST_STAT_NUM_COUNT</a> parameter.)</p>
