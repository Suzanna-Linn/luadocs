  <h2>Examples</h2>
<div class="lua-block"><span class="tag lua-tag">Lua</span><DocsCode code={`-- Showing usage of JSON_NULL
-- within a Json text string
local jText = ""

local function main()
    jText = ll.List2Json(JSON_OBJECT, {"A", 4, "B", 5})
    ll.OwnerSay(jText)  -- jText is '{"A":4,"B":5}'
    ll.OwnerSay(ll.JsonGetValue(jText, {"B"}))  -- The string "5"
    jText = ll.JsonSetValue(jText, {"B"}, JSON_NULL)
    ll.OwnerSay(jText)  -- jText is now '{"A":4,"B":null}'
    ll.OwnerSay(ll.JsonGetValue(jText, {"B"}))  -- The Unicode value of JSON_NULL

end

main()
`} lang="slua" /></div>
<div class="lsl-block"><span class="tag lsl-tag">LSL</span><DocsCode code={`// Showing usage of JSON_NULL
// within a Json text string
string jText;

default
{
    state_entry(){
        jText = llList2Json(JSON_OBJECT, ["A", 4, "B", 5]);
        llOwnerSay(jText); // jText is '{"A":4,"B":5}'
        llOwnerSay(llJsonGetValue(jText, ["B"])); // The string "5"
        jText = llJsonSetValue(jText, ["B"], JSON_NULL);
        llOwnerSay(jText); // jText is now '{"A":4,"B":null}'
        llOwnerSay(llJsonGetValue(jText, ["B"])); // The Unicode value of JSON_NULL

        }
}`} lang="lsl" /></div>
