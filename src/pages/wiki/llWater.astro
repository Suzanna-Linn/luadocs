
---
import DocsLayout from '/src/layouts/DocsLayout.astro';
import DocsCode from '/src/components/DocsCode.astro';
---

<DocsLayout title="Lua & LSL Docs">
<div class="dashboard summary-function">
  <div class="dashboard-header">
    <span class="lua-section"><span class="tag lua-tag">Lua</span><DocsCode code={`ll.Water(Offset: vector): number`} lang="slua" /></span>
    <span class="lsl-section"><span class="tag lsl-tag">LSL</span><DocsCode code={`float llWater(vector Offset);`} lang="lsl" /></span>
  </div>

  <div class="dashboard-body">
    <div class="dash-col">
      <p>  <p>Returns a float that is the water height below the prim&#39;s <a href="https://wiki.secondlife.com/wiki/LlGetPos" target="_blank">position</a> + <b>offset</b></p>
</p>
      <table class="param-table" id="parameters">
        <tr>
          <td><span class="lua-section"><span class="tag lua-tag">Lua</span>vector</span></td>
          <td><span class="lsl-section"><span class="tag lsl-tag">LSL</span>vector</span></td>
          <td>Offset / <a href="https://wiki.secondlife.com/wiki/Category:LSL_Parameters/offset" target="_blank">offset</a></td>
          <td>offset relative to the prim&#39;s position and expressed in <a href="https://wiki.secondlife.com/wiki/Viewer_coordinate_frames#Local" target="_blank">local coordinates</a></td>
        </tr>
      </table>
    </div>

    <div class="dash-col">
      <div class="dash-section-title">Categories</div>
      <ul class="meta-list">
        <li>region</li>
      </ul>
    </div>

    <div class="dash-col">
      <div class="dash-section-title">Tech Specs</div>
      <div class="tech-item"><span class="tech-label">Energy</span><span class="tech-val">10</span></div>
      <div class="tech-item"><span class="tech-label">LSO ID</span><span class="tech-val">153</span></div>

      <div class="label-stack">
        <span class="attr-label bg-mandatory">Use Return</span>
      </div>
    </div>
  </div>
</div>
  <p>The requested position needs to be in the same region.</p>
  <p>Only the <b>x</b> and <b>y</b> coordinates in <b>offset</b> are important, the <b>z</b> component is ignored.</p>
  <p>Water height is constant across each entire sim and is typically 20 meters but not always.</p>
  <h2>Examples</h2>
<div class="lua-block"><span class="tag lua-tag">Lua</span><DocsCode code={`ll = llcompat

-- Makes the object land on ground or on water

local function FindGroundOrWater()
    local vTarget = ll.GetPos()
    vTarget = vector(vTarget.x, vTarget.y, ll.Ground(ZERO_VECTOR))
    local fWaterLevel = ll.Water(ZERO_VECTOR)
    if vTarget.z < fWaterLevel then
        vTarget = vector(vTarget.x, vTarget.y, fWaterLevel)
    end
    ll.SetRegionPos(vTarget)
end

function LLEvents.touch_start(events)
    local total_number = #events
    FindGroundOrWater()
end
`} lang="slua" /></div>
<div class="lsl-block"><span class="tag lsl-tag">LSL</span><DocsCode code={`// Makes the object land on ground or on water

FindGroundOrWater()
{
    vector vTarget = llGetPos();
    vTarget.z = llGround( ZERO_VECTOR );
    float fWaterLevel = llWater( ZERO_VECTOR );
    if( vTarget.z < fWaterLevel )
        vTarget.z = fWaterLevel;
    llSetRegionPos(vTarget);
}

default
{
    touch_start(integer total_number)
    {
        FindGroundOrWater();
    }
}`} lang="lsl" /></div>
