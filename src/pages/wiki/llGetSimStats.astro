  <h2>Examples</h2>
<div class="lua-block"><span class="tag lua-tag">Lua</span><DocsCode code={`function LLEvents.touch_start(events)
    local num_detected = #events
    local pct_chars_stepped = ll.GetSimStats(SIM_STAT_PCT_CHARS_STEPPED)
    ll.Say(0, "The percentage of pathfinding characters updated each frame was " .. tostring(pct_chars_stepped) .. "averaged over the last minute. The " .. "value corresponds to the 'Characters Updated' stat in the " .. "viewer's Statistics Bar. ")
end
`} lang="slua" /></div>
<div class="lsl-block"><span class="tag lsl-tag">LSL</span><DocsCode code={`default
{
    touch_start(integer num_detected)
    {
        float pct_chars_stepped = llGetSimStats(SIM_STAT_PCT_CHARS_STEPPED);
        llSay(0,
            "The percentage of pathfinding characters updated each frame was "
            + (string)pct_chars_stepped + "averaged over the last minute. The "
            + "value corresponds to the 'Characters Updated' stat in the "
            + "viewer's Statistics Bar. ");
    }
}`} lang="lsl" /></div>
