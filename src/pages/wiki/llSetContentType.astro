  <h2>Caveats</h2>
  <ul>
    <li>When using <a href="https://wiki.secondlife.com/wiki/CONTENT_TYPE_HTML" target="_blank">CONTENT_TYPE_HTML</a>, this setting will be ignored unless all of these conditions are met: Obviously this is not compatible with group owned objects. One way around this limitation would be to <a href="https://wiki.secondlife.com/wiki/LlAttachToAvatarTemp" target="_blank">temporarily attach</a> a repeater.
    <ul>
      <li>the web browser is the Second Life client</li>
      <li>the user (logged into the SL client viewing the page) is the owner of the object.</li>
      <li>the user (logged into the SL client viewing the page) is connected to the region the object is located in</li>
    </ul>
  
    </li>
  </ul>
  <h2>Examples</h2>
<div class="lua-block"><span class="tag lua-tag">Lua</span><DocsCode code={`local url_request = NULL_KEY

local HTML_BODY = [[<!DOCTYPE html>
<html>
<body>

<h1>My First Heading</h1>

<p>My first paragraph.</p>

</body>
</html>]]

local function main()
    url_request = ll.RequestURL()
end

function LLEvents.http_request(id, method, body)
    local owner = ll.GetOwner()
    local ownerSize = ll.GetAgentSize(owner)

    if url_request == id then
        --  if you're usually not resetting the query ID
        --  now is a good time to start!
        url_request = uuid("")

        if method == URL_REQUEST_GRANTED then
            ll.OwnerSay("URL: " .. body)

            --  if owner in sim
            if ownerSize ~= ZERO_VECTOR then  --  != ZERO_VECTOR
                ll.LoadURL(owner, "I got a new URL!", body)
            end

        elseif method == URL_REQUEST_DENIED then
            ll.OwnerSay("Something went wrong, no url:\n" .. body)
        end

    else
        ll.OwnerSay("request body:\n" .. body)

        --  if owner in sim
        if ownerSize ~= ZERO_VECTOR then  --  != ZERO_VECTOR
            ll.SetContentType(id, CONTENT_TYPE_HTML)
            ll.HTTPResponse(id, 200, HTML_BODY)
        else
            ll.SetContentType(id, CONTENT_TYPE_TEXT)
            ll.HTTPResponse(id, 200, "OK")
        end
    end
end

main()
`} lang="slua" /></div>
<div class="lsl-block"><span class="tag lsl-tag">LSL</span><DocsCode code={`key url_request;

string HTML_BODY =
"<!DOCTYPE html>
<html>
<body>

<h1>My First Heading</h1>

<p>My first paragraph.</p>

</body>
</html>";

default
{
    state_entry()
    {
        url_request = llRequestURL();
    }

    http_request(key id, string method, string body)
    {
        key owner = llGetOwner();
        vector ownerSize = llGetAgentSize(owner);

        if (url_request == id)
        {
        //  if you're usually not resetting the query ID
        //  now is a good time to start!
            url_request = "";

            if (method == URL_REQUEST_GRANTED)
            {
                llOwnerSay("URL: " + body);

            //  if owner in sim
                if (ownerSize)//  != ZERO_VECTOR
                    llLoadURL(owner, "I got a new URL!", body);
            }

            else if (method == URL_REQUEST_DENIED)
                llOwnerSay("Something went wrong, no url:\n" + body);
        }

        else
        {
            llOwnerSay("request body:\n" + body);

        //  if owner in sim
            if (ownerSize)//  != ZERO_VECTOR
            {
                llSetContentType(id, CONTENT_TYPE_HTML);
                llHTTPResponse(id, 200, HTML_BODY);
            }
            else
            {
                llSetContentType(id, CONTENT_TYPE_TEXT);
                llHTTPResponse(id, 200, "OK");
            }
        }
    }
}`} lang="lsl" /></div>
