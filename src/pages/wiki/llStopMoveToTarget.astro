  <h2>Examples</h2>
<div class="lua-block"><span class="tag lua-tag">Lua</span><DocsCode code={`ll = llcompat

local gLockPrimInPlace = false

function LLEvents.on_rez(sp)
    ll.ResetScript()
end

local function main()
    ll.StopMoveToTarget()
    ll.SetStatus(STATUS_PHYSICS, true)
end

function LLEvents.touch_start(events)
    local total_number = #events

    if ll.DetectedKey(0) ~= ll.GetOwner() then
        return
    end

    if not (ll.GetStatus(STATUS_PHYSICS) ~= 0) then
        ll.OwnerSay("Locking or unlocking position works only for physical objects.")
        return
    end

    gLockPrimInPlace = not gLockPrimInPlace
    if gLockPrimInPlace then
        ll.MoveToTarget(ll.GetPos(), 0.05)
        ll.OwnerSay("Locked in place.")
    else
        ll.StopMoveToTarget()
        ll.OwnerSay("Unlocked.")
    end

end

main()
`} lang="slua" /></div>
<div class="lsl-block"><span class="tag lsl-tag">LSL</span><DocsCode code={`integer gLockPrimInPlace;

default
{

    on_rez(integer sp)
    {
        llResetScript();
    }

    state_entry()
    {
        llStopMoveToTarget();
        llSetStatus(STATUS_PHYSICS, TRUE);
    }

    touch_start(integer total_number)
    {

        if (llDetectedKey(0) != llGetOwner())
        {
            return;
        }

        if (!llGetStatus(STATUS_PHYSICS))
        {
            llOwnerSay("Locking or unlocking position works only for physical objects.");
            return;
        }

        gLockPrimInPlace = !gLockPrimInPlace;
        if (gLockPrimInPlace)
        {
            llMoveToTarget(llGetPos(), 0.05);
            llOwnerSay("Locked in place.");
        }
        else
        {
            llStopMoveToTarget();
            llOwnerSay("Unlocked.");
        }

    }

}`} lang="lsl" /></div>
