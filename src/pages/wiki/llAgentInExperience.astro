        <td><div class="lsl-block"><span class="tag lsl-tag">LSL</span><DocsCode code={`
function integer llAgentInExperience( key agent );
`} lang="lsl" /></div>

</td>
      </tr>
    </tbody>
  </table>

</DocsLayout>
      