  <div class="dashboard-body">
    <div class="dash-col">
      <p>  <p>Returns an integer bitfield with the script permissions granted</p>
</p>
    </div>

    <div class="dash-col">
      <div class="dash-section-title">Categories</div>
      <ul class="meta-list">
        <li>permissions</li>
      </ul>
    </div>

