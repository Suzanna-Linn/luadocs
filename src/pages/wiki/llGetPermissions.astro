        <span class="attr-label bg-mandatory">Use Return</span>
      </div>
    </div>
  </div>
</div>
  <h2>Examples</h2>
<div class="lua-block"><span class="tag lua-tag">Lua</span><DocsCode code={`local function main()
    --Comment out any of the following lines for fun
    ll.RequestPermissions(ll.GetOwner(), bit32.bor(PERMISSION_DEBIT, PERMISSION_TAKE_CONTROLS, PERMISSION_TRIGGER_ANIMATION, PERMISSION_ATTACH, PERMISSION_CHANGE_LINKS, PERMISSION_TRACK_CAMERA, PERMISSION_CONTROL_CAMERA, 0))
end
function LLEvents.touch_start(events)
    local a = #events
    local perm = ll.GetPermissions()
    if bit32.btest(perm, PERMISSION_DEBIT) then
        ll.OwnerSay("Can use llGiveMoney")
    end
    if bit32.btest(perm, PERMISSION_TAKE_CONTROLS) then
        ll.OwnerSay("Can use llTakeControls")
    end
    if bit32.btest(perm, PERMISSION_TRIGGER_ANIMATION) then
        ll.OwnerSay("Can use llStartAnimation")
    end
    if bit32.btest(perm, PERMISSION_ATTACH) then
        ll.OwnerSay("Can use llAttachToAvatar")
    end
    if bit32.btest(perm, PERMISSION_CHANGE_LINKS) then
        ll.OwnerSay("Can use llCreateLink")
    end
    if bit32.btest(perm, PERMISSION_TRACK_CAMERA) then
        ll.OwnerSay("Can use llGetCameraPos")
    end
    if bit32.btest(perm, PERMISSION_CONTROL_CAMERA) then
        ll.OwnerSay("Can use llSetCameraParams")
    end
end
function LLEvents.run_time_permissions(perm)
    if bit32.btest(perm, PERMISSION_DEBIT) then
        ll.OwnerSay("Can use llGiveMoney")
    end
    if bit32.btest(perm, PERMISSION_TAKE_CONTROLS) then
        ll.OwnerSay("Can use llTakeControlls")
    end
    if bit32.btest(perm, PERMISSION_TRIGGER_ANIMATION) then
        ll.OwnerSay("Can use llStartAnimation")
    end
    if bit32.btest(perm, PERMISSION_ATTACH) then
        ll.OwnerSay("Can use llAttachToAvatar")
    end
    if bit32.btest(perm, PERMISSION_CHANGE_LINKS) then
        ll.OwnerSay("Can use llCreateLink")
    end
    if bit32.btest(perm, PERMISSION_TRACK_CAMERA) then
        ll.OwnerSay("Can use llGetCameraPos")
    end
    if bit32.btest(perm, PERMISSION_CONTROL_CAMERA) then
        ll.OwnerSay("Can use llSetCameraParams")
    end
end

main()
`} lang="slua" /></div>
<div class="lsl-block"><span class="tag lsl-tag">LSL</span><DocsCode code={`default
{
    state_entry()
    {
        llRequestPermissions(llGetOwner(),
        //Comment out any of the following lines for fun
            PERMISSION_DEBIT |
            PERMISSION_TAKE_CONTROLS |
            PERMISSION_TRIGGER_ANIMATION |
            PERMISSION_ATTACH |
            PERMISSION_CHANGE_LINKS |
            PERMISSION_TRACK_CAMERA |
            PERMISSION_CONTROL_CAMERA |
            0);
    }
    touch_start(integer a)
    {
        integer perm = llGetPermissions();
        if(perm & PERMISSION_DEBIT)
            llOwnerSay("Can use llGiveMoney");
        if(perm & PERMISSION_TAKE_CONTROLS)
            llOwnerSay("Can use llTakeControls");
        if(perm & PERMISSION_TRIGGER_ANIMATION)
            llOwnerSay("Can use llStartAnimation");
        if(perm & PERMISSION_ATTACH)
            llOwnerSay("Can use llAttachToAvatar");
        if(perm & PERMISSION_CHANGE_LINKS)
            llOwnerSay("Can use llCreateLink");
        if(perm & PERMISSION_TRACK_CAMERA)
            llOwnerSay("Can use llGetCameraPos");
        if(perm & PERMISSION_CONTROL_CAMERA)
            llOwnerSay("Can use llSetCameraParams");
    }
    run_time_permissions(integer perm)
    {
        if(perm & PERMISSION_DEBIT)
            llOwnerSay("Can use llGiveMoney");
        if(perm & PERMISSION_TAKE_CONTROLS)
            llOwnerSay("Can use llTakeControlls");
        if(perm & PERMISSION_TRIGGER_ANIMATION)
            llOwnerSay("Can use llStartAnimation");
        if(perm & PERMISSION_ATTACH)
            llOwnerSay("Can use llAttachToAvatar");
        if(perm & PERMISSION_CHANGE_LINKS)
            llOwnerSay("Can use llCreateLink");
        if(perm & PERMISSION_TRACK_CAMERA)
            llOwnerSay("Can use llGetCameraPos");
        if(perm & PERMISSION_CONTROL_CAMERA)
            llOwnerSay("Can use llSetCameraParams");
    }
}`} lang="lsl" /></div>
