  <p>The object owner must also be the land owner. If the land is deeded to a group the object will need to be deeded to the same group for this function to work.</p>
  <h2>Caveats</h2>
  <ul>
    <li>This function causes the script to sleep for 2.0 seconds.</li>
  </ul>
  <h2>Examples</h2>
<div class="lua-block"><span class="tag lua-tag">Lua</span><DocsCode code={`ll = llcompat

-- This script changes the music URL based on time of day.

local night = false
local nighturl = "http://205.188.215.228:8006"
local dayurl = "http://208.122.59.30:7156"

local function main()
    ll.SetTimerEvent(10)
end

function LLEvents.timer()
    local pos = ll.GetSunDirection()

    if (pos.z < -.75) ~= night then
        night = not night
        if night then
            ll.SetParcelMusicURL(nighturl)
        else
            ll.SetParcelMusicURL(dayurl)
        end
    end
end

main()
`} lang="slua" /></div>
<div class="lsl-block"><span class="tag lsl-tag">LSL</span><DocsCode code={`// This script changes the music URL based on time of day.

integer night = FALSE;
string nighturl = "http://205.188.215.228:8006";
string dayurl = "http://208.122.59.30:7156";

default
{
    state_entry()
    {
        llSetTimerEvent(10);
    }
    
    timer()
    {
        vector pos = llGetSunDirection();
        
        if ((pos.z < -.75) != night)
        {
            night = !night;
            if (night)
            {
                llSetParcelMusicURL(nighturl);
            }
            else
            {
                llSetParcelMusicURL(dayurl);   
            }
        } 
    }
}`} lang="lsl" /></div>
