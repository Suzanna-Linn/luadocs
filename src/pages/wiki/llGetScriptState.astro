  <h2>Caveats</h2>
  <ul>
    <li>If <b>script</b> is missing from the prim&#39;s inventory or it is not a script then an error is shouted on <a href="https://wiki.secondlife.com/wiki/DEBUG_CHANNEL" target="_blank">DEBUG_CHANNEL</a>.</li>
  </ul>
  <h2>Examples</h2>
<div class="lua-block"><span class="tag lua-tag">Lua</span><DocsCode code={`ll = llcompat

function LLEvents.touch_start(events)
    local num_detected = #events
    local numberOfScripts = ll.GetInventoryNumber(INVENTORY_SCRIPT)

    local index = 0
    repeat
        local scriptName = ll.GetInventoryName(INVENTORY_SCRIPT, index)
        local scriptState = ll.GetScriptState(scriptName)

        --  default value
        local output = "FALSE"
        --  else
        if scriptState ~= 0 then
            output = "TRUE"
        end

        -- PUBLIC_CHANNEL has the integer value 0
        ll.Say(PUBLIC_CHANNEL, "Script named '" .. scriptName .. "' has current script state '" .. output .. "'.")
    until not ((function() index += 1 return index end)() < numberOfScripts)
end
`} lang="slua" /></div>
<div class="lsl-block"><span class="tag lsl-tag">LSL</span><DocsCode code={`default
{
    touch_start(integer num_detected)
    {
        integer numberOfScripts = llGetInventoryNumber(INVENTORY_SCRIPT);

        integer index;
        do
        {
            string scriptName = llGetInventoryName(INVENTORY_SCRIPT, index);
            integer scriptState = llGetScriptState(scriptName);

        //  default value
            string output = "FALSE";
        //  else
            if (scriptState) output = "TRUE";

            // PUBLIC_CHANNEL has the integer value 0
            llSay(PUBLIC_CHANNEL,
                "Script named '" + scriptName + "' has current script state '" + output + "'.");
        }
        while (++index < numberOfScripts);
    }
}`} lang="lsl" /></div>
<div class="lua-block"><span class="tag lua-tag">Lua</span><DocsCode code={`ll = llcompat

-- Monitor other scripts in the object, then report, restart or both if some have crashed
-- NB: cannot distinguish a manually stopped script or restart one
local TRY_RESTART = false
local REPORT = true

local function main()
    -- monitoring rate = once per minute
    ll.SetTimerEvent(60)
end

function LLEvents.timer()
    local i = ll.GetInventoryNumber(INVENTORY_SCRIPT)
    local script_name = ""
    local stopped = {}

    while (function() i -= 1 return i end)() >= 0 do
        -- the script will also monitor itself, but there is little reason to specifically skip
        script_name = ll.GetInventoryName(INVENTORY_SCRIPT, i)
        if not (ll.GetScriptState(script_name) ~= 0) then
            if TRY_RESTART then
                ll.ResetOtherScript(script_name)
            end
            if REPORT then
                stopped = ll.ListInsertList(stopped, {script_name}, #stopped)
            end
        end
    end
    if #stopped ~= 0 then
        local message = "The following scripts were crashed/stopped: " .. ll.List2CSV(stopped) .. "."
        if TRY_RESTART then
            message ..= " A restart was attempted."
        end
        ll.InstantMessage(ll.GetOwner(), message)
    end
end

main()
`} lang="slua" /></div>
<div class="lsl-block"><span class="tag lsl-tag">LSL</span><DocsCode code={`// Monitor other scripts in the object, then report, restart or both if some have crashed
// NB: cannot distinguish a manually stopped script or restart one
integer TRY_RESTART = FALSE;
integer REPORT = TRUE;

default
{
    state_entry() {
        // monitoring rate = once per minute
        llSetTimerEvent(60);
    }
    
    timer() {
        integer i = llGetInventoryNumber(INVENTORY_SCRIPT);
        string script_name;
        list stopped;
        
        while(--i >= 0) {
            // the script will also monitor itself, but there is little reason to specifically skip
            script_name = llGetInventoryName(INVENTORY_SCRIPT, i);
            if(!llGetScriptState(script_name)) {
                if(TRY_RESTART)
                    llResetOtherScript(script_name);
                if(REPORT)
                    stopped += script_name;
            }
        }
        if(stopped) {
            string message = "The following scripts were crashed/stopped: " + llList2CSV(stopped) + ".";
            if(TRY_RESTART)
                message += " A restart was attempted.";
            llInstantMessage(llGetOwner(), message);
        }
    }
}`} lang="lsl" /></div>
