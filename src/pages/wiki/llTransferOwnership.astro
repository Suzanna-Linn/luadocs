  </div>

  <div class="dashboard-body">
    <div class="dash-col">
      <p>  <p>Transfer ownership of the object containing this script to <b>agent_id</b>.</p>
  <p>Returns an integer indicating the result of the transfer.</p>
</p>
      <table class="param-table" id="parameters">
        <tr>
          <td><span class="lua-section"><span class="tag lua-tag">Lua</span>uuid</span></td>
          <td><span class="lsl-section"><span class="tag lsl-tag">LSL</span>key</span></td>
          <td>AgentID / agent_id</td>
          <td>Agent ID for the avatar to receive ownership of the object</td>
        </tr>
        <tr>
          <td><span class="lua-section"><span class="tag lua-tag">Lua</span>number</span></td>
          <td><span class="lsl-section"><span class="tag lsl-tag">LSL</span>integer</span></td>
          <td>Flags / flags</td>
          <td>Flags controlling transfer behavior.</td>
        </tr>
        <tr>
          <td><span class="lua-section"><span class="tag lua-tag">Lua</span>{`{any}`}</span></td>
          <td><span class="lsl-section"><span class="tag lsl-tag">LSL</span>list</span></td>
          <td>Params / <a href="https://wiki.secondlife.com/wiki/Category:LSL_Parameters/options" target="_blank">options</a></td>
          <td>Options applied to the ownership transfer. No options are defined at this time.</td>
        </tr>
      </table>
    </div>

