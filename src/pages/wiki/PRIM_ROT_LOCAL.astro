  <h2>Examples</h2>
<div class="lua-block"><span class="tag lua-tag">Lua</span><DocsCode code={`local isRotated = false
local rotated = vector(25, 25, 0)
local notRotated = ZERO_ROTATION
local rot = ZERO_ROTATION

local function main()
    rotated *= DEG_TO_RAD
    rot = ll.Euler2Rot(rotated)
end

function LLEvents.touch_start(events)
    local total_number = #events
    if isRotated then
        ll.SetLinkPrimitiveParams(2, {PRIM_ROT_LOCAL, notRotated})
        isRotated = false

    elseif not isRotated then
        isRotated = true
        ll.SetLinkPrimitiveParams(2, {PRIM_ROT_LOCAL, rot})
    end
end

main()
`} lang="slua" /></div>
<div class="lsl-block"><span class="tag lsl-tag">LSL</span><DocsCode code={`integer isRotated = FALSE;
vector rotated = <25, 25, 0>;
rotation notRotated = ZERO_ROTATION;
rotation rot;

default
{
    state_entry()
    {
        rotated *= DEG_TO_RAD;
        rot = llEuler2Rot( rotated );
    }
    
    touch_start(integer total_number)
    {
        if( isRotated ) 
        {
            llSetLinkPrimitiveParams( 2, [PRIM_ROT_LOCAL, notRotated] );
            isRotated = FALSE;
        }
        
        else if( !isRotated ) 
        {
            isRotated = TRUE;
            llSetLinkPrimitiveParams( 2, [PRIM_ROT_LOCAL, rot] );
        }
    }
}`} lang="lsl" /></div>
