  <h2>Deep Notes</h2>
<div class="lua-block"><span class="tag lua-tag">Lua</span><DocsCode code={`ll = llcompat

local function GetGeometricCenter()
    local center = ZERO_VECTOR
    local p = ll.GetNumberOfPrims()
    --since we skip the root prim, we can ignore the single prim case.
    --If we weren't skipping the root, this would be more complicated.
    local i = 1
    while i < p do
        center += ll.List2Vector(ll.GetLinkPrimitiveParams((function() i += 1 return i end)(), {PRIM_POS_LOCAL}), 0)
    end
    return center / p
end
`} lang="slua" /></div>
<div class="lsl-block"><span class="tag lsl-tag">LSL</span><DocsCode code={`vector GetGeometricCenter(){
    vector center = ZERO_VECTOR;
    integer p = llGetNumberOfPrims();
    //since we skip the root prim, we can ignore the single prim case.
    //If we weren't skipping the root, this would be more complicated.
    integer i = 1;
    while(i < p)
        center += llList2Vector(llGetLinkPrimitiveParams(++i, [PRIM_POS_LOCAL]), 0);
    return center / p;
}`} lang="lsl" /></div>
