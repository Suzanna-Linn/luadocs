    -- Use a HARD password ! with caps nocaps numbers and symbols !
    local pass = "P4s5Wo_rD"

    local data = "I am some ver important data."

    -- Enccrypting the data:
    local crypt = ll.XorBase64(ll.StringToBase64(data), ll.StringToBase64(pass))

    -- Say the mess you made to Owner
    ll.OwnerSay(crypt)

    -- DeCrypting the data and say back to owner:
    ll.OwnerSay(ll.Base64ToString(ll.XorBase64(crypt, ll.StringToBase64(pass))))

end

main()
`} lang="slua" /></div>
