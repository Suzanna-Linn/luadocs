<div class="lua-block"><span class="tag lua-tag">Lua</span><DocsCode code={`ll = llcompat

local numList = {1, 1, 1, 2, 1000, 1000, 1000}
local count = #numList
local sum = 0
local mean = ll.ListStatistics(LIST_STAT_MEAN, numList)
local i = 0
while i < count do
    local val = ll.List2Float(numList, i)
    local diff = val - mean
    sum += (diff * diff)
    i += 1
end
local sample_stdev = ll.Sqrt(sum / (count - 1))
local true_stdev = ll.Sqrt(sum / count)
ll.OwnerSay(tostring(true_stdev))
ll.OwnerSay(tostring(sample_stdev))
ll.OwnerSay(tostring(ll.ListStatistics(LIST_STAT_STD_DEV, numList)))`} lang="slua" /></div>
<div class="lsl-block"><span class="tag lsl-tag">LSL</span><DocsCode code={`list numList = [1,1,1,2,1000,1000,1000];
    integer count = llGetListLength( numList );
    float sum = 0;
    float mean = llListStatistics( LIST_STAT_MEAN, numList );
    integer i = 0;
    for (; i<count; ++i) {
        float val = llList2Float( numList, i );
        float diff = val - mean;
        sum += ( diff * diff );
    }
    float sample_stdev = llSqrt( sum / (count - 1) ); 
    float true_stdev = llSqrt( sum / count ); 
    llOwnerSay((string)true_stdev);
    llOwnerSay((string)sample_stdev);
    llOwnerSay((string)llListStatistics( LIST_STAT_STD_DEV, numList ));
}`} lang="lsl" /></div>
