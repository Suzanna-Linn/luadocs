<DocsLayout title="Lua & LSL Docs">
<div class="dashboard summary-function">
  <div class="dashboard-header">
    <span class="lua-section"><span class="tag lua-tag">Lua</span><DocsCode code={`ll.AttachToAvatar(AttachmentPoint: number)`} lang="slua" /></span>
    <span class="lsl-section"><span class="tag lsl-tag">LSL</span><DocsCode code={`llAttachToAvatar(integer AttachmentPoint);`} lang="lsl" /></span>
  </div>

  <div class="dashboard-body">
    <div class="dash-col">
      <p>  <p>Attaches the object to the avatar who has granted permission to the script. The object is taken into the users inventory and attached to <b>attach_point</b>.</p>
</p>
      <table class="param-table" id="parameters">
        <tr>
          <td><span class="lua-section"><span class="tag lua-tag">Lua</span>number</span></td>
          <td><span class="lsl-section"><span class="tag lsl-tag">LSL</span>integer</span></td>
          <td>AttachmentPoint / <a href="https://wiki.secondlife.com/wiki/Category:LSL_Integer/attach_point" target="_blank">attach_point</a></td>
          <td>ATTACH_* constant or valid value (see the tables below)</td>
        </tr>
      </table>
    </div>

    <div class="dash-col">
      <div class="dash-section-title">Categories</div>
      <ul class="meta-list">
        <li>attachments</li>
        <li>avatar</li>
      </ul>
      <div class="dash-section-title">Permissions</div>
      <ul class="meta-list">
