
---
import DocsLayout from '/src/layouts/DocsLayout.astro';
import DocsCode from '/src/components/DocsCode.astro';
---

<DocsLayout title="Lua & LSL Docs">
<div class="dashboard summary-constant">
  <div class="dashboard-header">
    <span class="lua-section"><span class="tag lua-tag">Lua</span><DocsCode code={`REZ_DAMAGE: number = 8`} lang="slua" /></span>
    <span class="lsl-section"><span class="tag lsl-tag">LSL</span><DocsCode code={`integer REZ_DAMAGE = 8;`} lang="lsl" /></span>
  </div>

  <div class="dashboard-body">
    <div class="dash-col">
      <p>  <p>The integer constant REZ_DAMAGE has the value 8</p>
  <p>Sets the damage amount delivered by a prim on collision when the object is rezzed.</p>
</p>
    </div>

    <div class="dash-col">
      <div class="dash-section-title">Member Of</div>
      <ul class="meta-list">
        <li>RezParam</li>
      </ul>
    </div>

    <div class="dash-col">
      <div class="dash-section-title">Tech Specs</div>

      <div class="label-stack">
      </div>
    </div>
  </div>
</div>
