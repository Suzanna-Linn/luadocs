  <h2>Examples</h2>
<div class="lua-block"><span class="tag lua-tag">Lua</span><DocsCode code={`ll = llcompat

local function main()
    ll.SetPrimitiveParams({PRIM_PHANTOM, if true then 1 else 0})  -- makes the object phantom...

    local isPhantom = ll.List2Integer(ll.GetPrimitiveParams({PRIM_PHANTOM}), 0)

    if isPhantom == 1 then
        ll.SetText("Object is Phantom", vector(1, 1, 1), 1.0)

    else
        ll.SetText("Object is Solid", vector(1, 1, 1), 1.0)
    end
end

main()
`} lang="slua" /></div>
<div class="lsl-block"><span class="tag lsl-tag">LSL</span><DocsCode code={`default
{
    state_entry()
    {
        llSetPrimitiveParams([PRIM_PHANTOM, TRUE]); // makes the object phantom...
        
        integer isPhantom = llList2Integer(llGetPrimitiveParams([PRIM_PHANTOM]), 0);
        
        if( isPhantom == 1 )
        {
            llSetText("Object is Phantom", <1, 1, 1>, 1.0);
        }
        
        else
        {
            llSetText("Object is Solid", <1, 1, 1>, 1.0);
        }
    }
}`} lang="lsl" /></div>
