
---
import DocsLayout from '/src/layouts/DocsLayout.astro';
import DocsCode from '/src/components/DocsCode.astro';
---

<DocsLayout title="Lua & LSL Docs">
<div class="dashboard summary-function">
  <div class="dashboard-header">
    <span class="lua-section"><span class="tag lua-tag">Lua</span><DocsCode code={`ll.FindNotecardTextCount(NotecardName: string|uuid, Pattern: string, Options: {any}): uuid`} lang="slua" /></span>
    <span class="lsl-section"><span class="tag lsl-tag">LSL</span><DocsCode code={`key llFindNotecardTextCount(string NotecardName, string Pattern, list Options);`} lang="lsl" /></span>
  </div>

  <div class="dashboard-body">
    <div class="dash-col">
      <p>Searches the text of a cached notecard for lines containing the given pattern and returns the <br> number of matches found through a dataserver event.<br></p>
      <table class="param-table" id="parameters">
        <tr>
          <td><span class="lua-section"><span class="tag lua-tag">Lua</span>string|uuid</span></td>
          <td><span class="lsl-section"><span class="tag lsl-tag">LSL</span>string</span></td>
          <td>NotecardName</td>
          <td></td>
        </tr>
        <tr>
          <td><span class="lua-section"><span class="tag lua-tag">Lua</span>string</span></td>
          <td><span class="lsl-section"><span class="tag lsl-tag">LSL</span>string</span></td>
          <td>Pattern</td>
          <td>Regex pattern to find in the notecard text.</td>
        </tr>
        <tr>
          <td><span class="lua-section"><span class="tag lua-tag">Lua</span>{`{any}`}</span></td>
          <td><span class="lsl-section"><span class="tag lsl-tag">LSL</span>list</span></td>
          <td>Options</td>
          <td>A list of options to control the search. Included for future expansion, should be []</td>
        </tr>
      </table>
    </div>

    <div class="dash-col">
      <div class="dash-section-title">Categories</div>
      <ul class="meta-list">
        <li>data_storage</li>
        <li>dataserver</li>
        <li>notecard</li>
      </ul>
    </div>

    <div class="dash-col">
      <div class="dash-section-title">Tech Specs</div>
      <div class="tech-item"><span class="tech-label">Energy</span><span class="tech-val">10</span></div>
      <div class="tech-item"><span class="tech-label">LSO ID</span><span class="tech-val">507</span></div>

      <div class="label-stack">
        <span class="attr-label bg-mandatory">Use Return</span>
      </div>
    </div>
  </div>
</div>

</DocsLayout>
      