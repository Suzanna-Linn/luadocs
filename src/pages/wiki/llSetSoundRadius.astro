
---
import DocsLayout from '/src/layouts/DocsLayout.astro';
import DocsCode from '/src/components/DocsCode.astro';
---

<DocsLayout title="Lua & LSL Docs">
<div class="dashboard summary-function">
  <div class="dashboard-header">
    <span class="lua-section"><span class="tag lua-tag">Lua</span><DocsCode code={`ll.SetSoundRadius(Radius: number)`} lang="slua" /></span>
    <span class="lsl-section"><span class="tag lsl-tag">LSL</span><DocsCode code={`llSetSoundRadius(float Radius);`} lang="lsl" /></span>
  </div>

  <div class="dashboard-body">
    <div class="dash-col">
      <p>Limits radius for audibility of scripted sounds (both attached and triggered) to distance Radius.</p>
      <table class="param-table" id="parameters">
        <tr>
          <td><span class="lua-section"><span class="tag lua-tag">Lua</span>number</span></td>
          <td><span class="lsl-section"><span class="tag lsl-tag">LSL</span>float</span></td>
          <td>Radius</td>
          <td>Maximum distance that sounds can be heard.</td>
        </tr>
      </table>
    </div>

    <div class="dash-col">
      <div class="dash-section-title">Categories</div>
      <ul class="meta-list">
        <li>sound</li>
      </ul>
    </div>

    <div class="dash-col">
      <div class="dash-section-title">Tech Specs</div>
      <div class="tech-item"><span class="tech-label">Energy</span><span class="tech-val">10</span></div>
      <div class="tech-item"><span class="tech-label">LSO ID</span><span class="tech-val">209</span></div>

      <div class="label-stack">
      </div>
    </div>
  </div>
</div>

</DocsLayout>
      