      <div class="label-stack">
      </div>
    </div>
  </div>
</div>
  <ul>
    <li>Full Object Update is sent to viewers.</li>
    <li>The current event/function is exited without further execution or return.</li>
    <li>Any granted URLs are released.</li>
    <li>All global variables are set to their defaults.</li>
    <li>Timers (including repeating sensors) are cleared.</li>
    <li>Listeners are removed.</li>
    <li>The event queue is cleared.</li>
    <li>The <a href="https://wiki.secondlife.com/wiki/Default" target="_blank">default</a> state is set as the active state.
    <ul>
      <li>If it has a <a href="https://wiki.secondlife.com/wiki/State_entry" target="_blank">state_entry</a> event, then it is queued.</li>
    </ul>
  
    </li>
  </ul>
  <h2>Examples</h2>
<div class="lua-block"><span class="tag lua-tag">Lua</span><DocsCode code={`-- reset script when the object is rezzed
function LLEvents.on_rez(start_param)
    ll.ResetScript()
end

function LLEvents.changed(change)
    -- reset script when the owner or the inventory changed
    if bit32.btest(change, bit32.bor(CHANGED_OWNER, CHANGED_INVENTORY)) then
        ll.ResetScript()
    end
end

-- script initialization here
local function main()
end

main()
`} lang="slua" /></div>
<div class="lsl-block"><span class="tag lsl-tag">LSL</span><DocsCode code={`default
{
    // reset script when the object is rezzed
    on_rez(integer start_param)
    {
        llResetScript();
    }

    changed(integer change)
    {
        // reset script when the owner or the inventory changed
        if (change & (CHANGED_OWNER | CHANGED_INVENTORY))
            llResetScript();
    }

    // script initialization here
    state_entry()
    {
        ;
    }
}`} lang="lsl" /></div>
