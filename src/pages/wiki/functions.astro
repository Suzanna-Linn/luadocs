          .cat-button:hover { background: var(--btn-hover); }

          .category-section {
            background: white;
            border: 1px solid #ddd;
            border-radius: 8px;
            padding: 20px;
            margin-bottom: 30px;
            scroll-margin-top: 20px;
          }
          .category-section h2 {
            margin-top: 0;
            border-bottom: 2px solid var(--btn-color);
            padding-bottom: 5px;
            text-transform: uppercase;
            color: #2c3e50;
          }
          .item-list {
            display: flex;
            flex-wrap: wrap;
            list-style: none;
            padding: 0;
          }
          .item {
            flex: 0 0 33.33%; /* 3 columns */
            font-family: monospace;
            padding: 5px 0;
            color: var(--item-text);
          }
          .back-to-top {
            display: inline-block;
            margin-top: 10px;
            font-size: 0.8em;
            color: #999;
          }
          @media (max-width: 600px) { .item { flex: 0 0 100%; } }
        </style>
