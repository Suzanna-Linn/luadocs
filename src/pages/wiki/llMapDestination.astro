
---
import DocsLayout from '/src/layouts/DocsLayout.astro';
import DocsCode from '/src/components/DocsCode.astro';
---

<DocsLayout title="Lua & LSL Docs">
<div class="dashboard summary-function">
  <div class="dashboard-header">
    <span class="lua-section"><span class="tag lua-tag">Lua</span><DocsCode code={`ll.MapDestination(RegionName: string, Position: vector, Direction: vector)`} lang="slua" /></span>
    <span class="lsl-section"><span class="tag lsl-tag">LSL</span><DocsCode code={`llMapDestination(string RegionName, vector Position, vector Direction);`} lang="lsl" /></span>
  </div>

  <div class="dashboard-body">
    <div class="dash-col">
      <p>  <p>Opens world map centered on <b>simname</b> with <b>pos</b> highlighted.</p>
  <p>Only works for scripts <a href="https://wiki.secondlife.com/wiki/Attach" target="_blank">attached</a> to avatar, or during <a href="https://wiki.secondlife.com/wiki/Category:LSL_Touch" target="_blank">touch</a> events.</p>
</p>
      <table class="param-table" id="parameters">
        <tr>
          <td><span class="lua-section"><span class="tag lua-tag">Lua</span>string</span></td>
          <td><span class="lsl-section"><span class="tag lsl-tag">LSL</span>string</span></td>
          <td>RegionName / simname</td>
          <td>Region name</td>
        </tr>
        <tr>
          <td><span class="lua-section"><span class="tag lua-tag">Lua</span>vector</span></td>
          <td><span class="lsl-section"><span class="tag lsl-tag">LSL</span>vector</span></td>
          <td>Position / <a href="https://wiki.secondlife.com/wiki/Category:LSL_Parameters/pos" target="_blank">pos</a></td>
          <td>position in <a href="https://wiki.secondlife.com/wiki/Viewer_coordinate_frames#Region" target="_blank">region coordinates</a></td>
        </tr>
        <tr>
          <td><span class="lua-section"><span class="tag lua-tag">Lua</span>vector</span></td>
          <td><span class="lsl-section"><span class="tag lsl-tag">LSL</span>vector</span></td>
          <td>Direction / <a href="https://wiki.secondlife.com/wiki/Category:LSL_Parameters/look_at" target="_blank">look_at</a></td>
          <td>position in <a href="https://wiki.secondlife.com/wiki/Viewer_coordinate_frames#Local" target="_blank">local coordinates</a>&amp;#32;(not used)</td>
        </tr>
      </table>
    </div>

    <div class="dash-col">
      <div class="dash-section-title">Categories</div>
      <ul class="meta-list">
        <li>avatar_communication</li>
        <li>user_interface</li>
      </ul>
    </div>

    <div class="dash-col">
      <div class="dash-section-title">Tech Specs</div>
      <div class="tech-item"><span class="tech-label">Sleep</span><span class="tech-val">1s</span></div>
      <div class="tech-item"><span class="tech-label">Energy</span><span class="tech-val">10</span></div>
      <div class="tech-item"><span class="tech-label">LSO ID</span><span class="tech-val">309</span></div>

      <div class="label-stack">
      </div>
    </div>
  </div>
</div>
  <p>(NOTE: <b>look_at</b> currently does nothing)</p>
  <h2>Caveats</h2>
  <ul>
    <li>This function causes the script to sleep for 1.0 seconds.</li>
    <li>if <b>simname</b> is omitted or invalid, the map will open centered on object, but <b>pos</b> will not be highlighted. Since this function requests the client to perform a task, there is no way for script to know if it has failed.</li>
  </ul>
  <h2>Examples</h2>
<div class="lua-block"><span class="tag lua-tag">Lua</span><DocsCode code={`ll = llcompat

local simName = "Help Island Public"
local tpDest = vector(128.0, 128.0, 24.0)
local lookAt = ZERO_VECTOR

local function main()
    -- set white, opaque floattext with teleport destination
    ll.SetText("click to teleport\nto '" .. simName .. "'", vector(1.0, 1.0, 1.0), tonumber(if true then 1 else 0))
end

function LLEvents.touch_start(events)
    local num_detected = #events
    local id = ll.DetectedKey(0)

    local oldSlurlPrefix = "http://slurl.com/secondlife/"
    local newSlurlPrefix = "http://maps.secondlife.com/secondlife/"
    local slurlSuffix = ll.EscapeURL(simName) .. "/" .. tostring(ll.Round(tpDest.x)) .. "/" .. tostring(ll.Round(tpDest.y)) .. "/" .. tostring(ll.Round(tpDest.z))

    ll.InstantMessage(id, oldSlurlPrefix .. slurlSuffix)
    ll.InstantMessage(id, newSlurlPrefix .. slurlSuffix)

    ll.MapDestination(simName, tpDest, lookAt)
end

main()
`} lang="slua" /></div>
<div class="lsl-block"><span class="tag lsl-tag">LSL</span><DocsCode code={`string simName = "Help Island Public";
vector tpDest = <128.0, 128.0, 24.0>;
vector lookAt = ZERO_VECTOR;

default
{
    state_entry()
    {
        // set white, opaque floattext with teleport destination
        llSetText("click to teleport\nto '" + simName + "'", <1.0, 1.0, 1.0>, (float)TRUE);
    }

    touch_start(integer num_detected)
    {
        key id = llDetectedKey(0);

        string oldSlurlPrefix = "http://slurl.com/secondlife/";
        string newSlurlPrefix = "http://maps.secondlife.com/secondlife/";
        string slurlSuffix = llEscapeURL(simName)
            + "/" + (string)llRound(tpDest.x)
            + "/" + (string)llRound(tpDest.y)
            + "/" + (string)llRound(tpDest.z);

        llInstantMessage(id, oldSlurlPrefix + slurlSuffix);
        llInstantMessage(id, newSlurlPrefix + slurlSuffix);

        llMapDestination(simName, tpDest, lookAt);
    }
}`} lang="lsl" /></div>
  <h2>Notes</h2>
  <ul>
    <li><b>pos</b> will work with <a href="https://wiki.secondlife.com/wiki/Viewer_coordinate_frames#Region" target="_blank">Region</a> coordinates not inside <b>simname</b>. (like those returned by <a href="https://wiki.secondlife.com/wiki/LlRequestInventoryData" target="_blank">llRequestInventoryData</a>)</li>
    <li>if called from non <a href="https://wiki.secondlife.com/wiki/Category:LSL_Touch" target="_blank">touch</a> events, it only works for the <a href="https://wiki.secondlife.com/wiki/Category:LSL_Owner" target="_blank">owner</a>.</li>
    <li>if called from touch, it may only work for the first or last touch in the event queue (example: num_touched &gt; 1)</li>
    <li>if called inside an <a href="https://wiki.secondlife.com/wiki/Attachment" target="_blank">attachment</a>, it only works for the owner.</li>
  </ul>
