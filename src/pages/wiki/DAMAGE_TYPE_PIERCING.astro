
---
import DocsLayout from '/src/layouts/DocsLayout.astro';
import DocsCode from '/src/components/DocsCode.astro';
---

<DocsLayout title="Lua & LSL Docs">
<div class="dashboard summary-constant">
  <div class="dashboard-header">
    <span class="lua-section"><span class="tag lua-tag">Lua</span><DocsCode code={`DAMAGE_TYPE_PIERCING: number = 8`} lang="slua" /></span>
    <span class="lsl-section"><span class="tag lsl-tag">LSL</span><DocsCode code={`integer DAMAGE_TYPE_PIERCING = 8;`} lang="lsl" /></span>
  </div>

  <div class="dashboard-body">
    <div class="dash-col">
      <p>Damage caused by a piercing object such as a bullet, spear, or arrow.</p>
    </div>

    <div class="dash-col">
      <div class="dash-section-title">Member Of</div>
      <ul class="meta-list">
        <li>DamageType</li>
      </ul>
    </div>

    <div class="dash-col">
      <div class="dash-section-title">Tech Specs</div>

      <div class="label-stack">
      </div>
    </div>
  </div>
</div>

</DocsLayout>
      