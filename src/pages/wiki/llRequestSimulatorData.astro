  <h2>Caveats</h2>
  <ul>
    <li>This function causes the script to sleep for 1.0 seconds.</li>
    <li>There is no DATA_SIM_MAXPRIMS flag (but `[llGetEnv](https://wiki.secondlife.com/wiki/LlGetEnv)(&quot;region_product_name&quot;)` returns the region type). <a href="#SVC-4921" target="_blank">SVC-4921</a></li>
  </ul>
  <h2>Examples</h2>
  <p>Hide objects in PG or unknown regions</p>
<div class="lua-block"><span class="tag lua-tag">Lua</span><DocsCode code={`local gRateingQuery = NULL_KEY

local function show()
    ll.SetLinkAlpha(LINK_SET, 1.0, ALL_SIDES)
end  --show

local function hide()
    ll.SetLinkAlpha(LINK_SET, 0.0, ALL_SIDES)
end  --hide

function LLEvents.on_rez(Setting)
    ll.ResetScript()
end  --on_rez

local function main()
    gRateingQuery = ll.RequestSimulatorData(ll.GetRegionName(), DATA_SIM_RATING)
end  --state_entry

function LLEvents.changed(ItChanged)
    if bit32.btest(ItChanged, CHANGED_OWNER) then
        ll.ResetScript()
    end
    if bit32.btest(ItChanged, CHANGED_REGION) then
        ll.ResetScript()
    end
end  --changed

function LLEvents.dataserver(query_id, data)
    if query_id == gRateingQuery then
        if data == "MATURE" or data == "ADULT" then
            show()
        elseif data == "UNKNOWN" or data == "PG" then
            hide()
        end
    end  --gRateingQuery
end  --dataserver

  --default
main()
`} lang="slua" /></div>
<div class="lsl-block"><span class="tag lsl-tag">LSL</span><DocsCode code={`key         gRateingQuery       =   NULL_KEY        ;

show()
{
    llSetLinkAlpha( LINK_SET, 1.0, ALL_SIDES );
}//show

hide()
{
     llSetLinkAlpha( LINK_SET, 0.0, ALL_SIDES );
}//hide

default
{
    on_rez(integer Setting)
    {
        llResetScript();
    }//on_rez
    
    state_entry()
    {
        gRateingQuery = llRequestSimulatorData( llGetRegionName(), DATA_SIM_RATING );
    }//state_entry
   
    changed(integer ItChanged)
    {
        if (ItChanged & CHANGED_OWNER)      llResetScript();
        if (ItChanged & CHANGED_REGION)     llResetScript();
    }//changed
    
    dataserver(key query_id, string data)
    {
        if (query_id == gRateingQuery)
        {
            if (data == "MATURE" || data == "ADULT")        show();
            else if (data == "UNKNOWN" || data == "PG")     hide();
        }//gRateingQuery
    }//dataserver
    
}//default`} lang="lsl" /></div>
