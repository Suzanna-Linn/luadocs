  <h2>Examples</h2>
<div class="lua-block"><span class="tag lua-tag">Lua</span><DocsCode code={`ll = llcompat

-- Simple experience watcher
local denied_region = ""
local experience_name = ""

local function main()
    ll.RequestExperiencePermissions(ll.GetOwner(), "")
    experience_name = ll.List2String(ll.GetExperienceDetails(NULL_KEY), 0)
end

function LLEvents.experience_permissions(agent)
    denied_region = ""
    ll.OwnerSay("in " .. experience_name)
end

function LLEvents.experience_permissions_denied(agent, reason)
    denied_region = ll.GetRegionName()
    ll.OwnerSay("out " .. experience_name)

end

function LLEvents.changed(what)
    if denied_region ~= "" and denied_region ~= ll.GetRegionName() then
        ll.RequestExperiencePermissions(ll.GetOwner(), "")
    end
end

main()
`} lang="slua" /></div>
<div class="lsl-block"><span class="tag lsl-tag">LSL</span><DocsCode code={`// Simple experience watcher
string denied_region = "";
string experience_name = "";

default{
    state_entry(){
        llRequestExperiencePermissions(llGetOwner(), "");
        experience_name = llList2String(llGetExperienceDetails(NULL_KEY), 0);
    }

    experience_permissions(key agent){
        denied_region="";
        llOwnerSay("in "+ experience_name);
    }
    
    experience_permissions_denied(key agent, integer reason){
        denied_region = llGetRegionName( );
        llOwnerSay("out "+ experience_name);
        
    }
    
    changed(integer what){
        if(denied_region != "" && denied_region != llGetRegionName()){
           llRequestExperiencePermissions(llGetOwner(), "");
        }
    } 
}`} lang="lsl" /></div>
