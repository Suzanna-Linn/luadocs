        <td></td>
      </tr>
    </tbody>
  </table>
  <h2>Deep Notes</h2>
  <table>
    <tbody>
      <tr>
        <th>Signature</th>
      </tr>
      <tr>
        <td><div class="lsl-block"><span class="tag lsl-tag">LSL</span><DocsCode code={`
function void llSetInventoryPermMask( string item, integer category, integer value );
`} lang="lsl" /></div>

</td>
