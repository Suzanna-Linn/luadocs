  <div class="dashboard-body">
    <div class="dash-col">
      <p>  <p>Set the sit location for the prim. The sit location is relative to the prim's position and rotation.</p>
</p>
      <table class="param-table" id="parameters">
        <tr>
          <td><span class="lua-section"><span class="tag lua-tag">Lua</span>vector</span></td>
          <td><span class="lsl-section"><span class="tag lsl-tag">LSL</span>vector</span></td>
          <td>Offset / <a href="https://wiki.secondlife.com/wiki/Category:LSL_Parameters/offset" target="_blank">offset</a></td>
          <td>Additional position for the sit target in local prim coordinates.</td>
        </tr>
        <tr>
          <td><span class="lua-section"><span class="tag lua-tag">Lua</span>rotation</span></td>
          <td><span class="lsl-section"><span class="tag lsl-tag">LSL</span>rotation</span></td>
          <td>Rotation / <a href="https://wiki.secondlife.com/wiki/Category:LSL_Parameters/rot" target="_blank">rot</a></td>
          <td>Additional rotation for the sit target relative to the prim rotation.</td>
        </tr>
      </table>
