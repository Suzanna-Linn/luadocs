</div>
  <h2>Examples</h2>
<div class="lua-block"><span class="tag lua-tag">Lua</span><DocsCode code={`local function main()
    local input_1 = vector(1.0, 2.0, 3.0)
    local input_2 = vector(3.0, 2.0, 1.0)
    ll.OwnerSay("The distance between " .. tostring(input_1) .. " and " .. tostring(input_2) .. " is: " .. tostring(ll.VecDist(input_1, input_2)))
end

main()
`} lang="slua" /></div>
<div class="lsl-block"><span class="tag lsl-tag">LSL</span><DocsCode code={`default {
    state_entry()
    {
        vector input_1 = <1.0,2.0,3.0>;
        vector input_2 = <3.0,2.0,1.0>;
        llOwnerSay("The distance between " + (string) input_1 +
            " and " + (string) input_2 + " is: "+(string)llVecDist(input_1, input_2) );
    }
}`} lang="lsl" /></div>
<div class="lua-block"><span class="tag lua-tag">Lua</span><DocsCode code={`--To reset script on touch if the object has been rotated since the last script reset
local gTolerance = 0.05  --This corresponds to about a 3 degree rotation
local function main()
    ll.SetObjectDesc(tostring(ll.Rot2Euler(ll.GetRot())))
end

function LLEvents.touch_start(events)
    local total_number = #events
    if ll.VecDist(ll.Rot2Euler(ll.GetRot()), tovector(ll.GetObjectDesc())) > gTolerance then
        ll.Say(0, "This object has rotated. Automatic reset engaged.")
        ll.ResetScript()
    end
end

main()
`} lang="slua" /></div>
<div class="lsl-block"><span class="tag lsl-tag">LSL</span><DocsCode code={`//To reset script on touch if the object has been rotated since the last script reset
float gTolerance = 0.05;  //This corresponds to about a 3 degree rotation
default
{
	state_entry()
	{
		llSetObjectDesc((string)llRot2Euler(llGetRot()));
	}
	
	touch_start(integer total_number)
	{
		if (llVecDist(llRot2Euler(llGetRot()), (vector)llGetObjectDesc()) > gTolerance)
		{
			llSay(0,"This object has rotated. Automatic reset engaged.");
			llResetScript();
		}
	}
}`} lang="lsl" /></div>
  <h3>Video Tutorial</h3>
  <p><a href="https://www.youtube.com/watch?v=D0WvH58IWEo" target="_blank">https://www.youtube.com/watch?v=D0WvH58IWEo</a></p>
  <h2>Notes</h2>
  <ul>
    <li>Mathematically equivalent to:
    <ul>
      <li><a href="https://wiki.secondlife.com/wiki/LlVecMag" target="_blank">llVecMag</a>( vec_a - vec_b )</li>
      <li><a href="https://wiki.secondlife.com/wiki/LlSqrt" target="_blank">llSqrt</a>( (vec_b.x - vec_a.x) <i> (vec_b.x - vec_a.x) + (vec_b.y - vec_a.y) </i> (vec_b.y - vec_a.y) + (vec_b.z - vec_a.z) * (vec_b.z - vec_a.z) )</li>
    </ul>
  
    </li>
    <li>Knowing this, there are ways to circumvent llVecDist for more efficient code.
    <ul>
      <li>For example, vector v3 = (v1-v2); v3<i>v3 < (f</i>f); is over twice as fast as llVecDist(v1,v2) < f;</li>
    </ul>
  
    </li>
  </ul>
