}`} lang="lsl" /></div>
  <p><b>Using <a href="https://wiki.secondlife.com/wiki/LlDetectedType" target="_blank">llDetectedType</a> in <a href="https://wiki.secondlife.com/wiki/Sensor" target="_blank">sensor</a> event:</b></p>
<div class="lua-block"><span class="tag lua-tag">Lua</span><DocsCode code={`ll = llcompat

function LLEvents.touch_start(events)
    local numberDetected = #events
    ll.Sensor("", "", bit32.bor(ACTIVE, PASSIVE, AGENT), 20.0, PI)  -- activates the sensor.
end

function LLEvents.sensor(events)
    local numberDetected = #events
    local i = 0
    while i < numberDetected do
        local type = ll.DetectedType(i)
        local message = ""
        message ..= tostring(i) .. ", " .. ll.DetectedName(i) .. ", "
        local typeList = {}
        if bit32.btest(type, AGENT) then
            typeList = ll.ListInsertList(typeList, {"AGENT"}, #typeList)
        end
        if bit32.btest(type, ACTIVE) then
            typeList = ll.ListInsertList(typeList, {"ACTIVE"}, #typeList)
        end
        if bit32.btest(type, PASSIVE) then
            typeList = ll.ListInsertList(typeList, {"PASSIVE"}, #typeList)
        end
        if bit32.btest(type, SCRIPTED) then
            typeList = ll.ListInsertList(typeList, {"SCRIPTED"}, #typeList)
        end
        message ..= ll.DumpList2String(typeList, "|")
        ll.Whisper(0, message)
        i += 1
    end
end

function LLEvents.no_sensor()
    -- This is impossible if range = 20.0 and you are standing within 10m!
    ll.Whisper(0, "Nothing is near me at present.")
end
`} lang="slua" /></div>
<div class="lsl-block"><span class="tag lsl-tag">LSL</span><DocsCode code={`default
{
    touch_start(integer numberDetected)
    {
         llSensor("", "", ACTIVE | PASSIVE | AGENT, 20.0, PI); // activates the sensor.
    }

    sensor (integer numberDetected)
    {
        integer i;
        while(i < numberDetected)
        {
            integer type = llDetectedType(i);
            string message;
            message += (string)i + ", " + llDetectedName(i) + ", ";
            list typeList;
            if (type & AGENT)
            {
                typeList += "AGENT";
            }
            if (type & ACTIVE)
            {
                typeList += "ACTIVE";
            }
            if (type & PASSIVE)
            {
                typeList += "PASSIVE";
            }
            if (type & SCRIPTED)
            {
                typeList += "SCRIPTED";
            }
            message += llDumpList2String(typeList, "|");
            llWhisper(0, message);
            ++i;
        }
    }
 
    no_sensor()
    {
        // This is impossible if range = 20.0 and you are standing within 10m!
        llWhisper(0, "Nothing is near me at present."); 
    }
}`} lang="lsl" /></div>
  <p>**Using filter in <a href="https://wiki.secondlife.com/wiki/Category:LSL_Sensor" target="_blank">llSensor*</a> functions:**</p>
<div class="lua-block"><span class="tag lua-tag">Lua</span><DocsCode code={`ll = llcompat

-- Report nearby sensed objects and avatars under sundry categories

local SenseTypes = {}
local gIndex = 0

local function SenseNextType()
    local text = ll.List2String(SenseTypes, gIndex)
    local tipe = ll.List2Integer(SenseTypes, gIndex + 1)
    if tipe ~= 0 then
        ll.Whisper(0, text)
        ll.Sensor("", NULL_KEY, tipe, 20.0, PI)
        gIndex += 2  -- increment by stride
    else
        ll.Whisper(0, "--- Finished ---")
    end
end

function LLEvents.touch_start(events)
    local detected = #events
    -- Make a Strided list of text and sensor type combinations
    -- (Can't use '|' in Global, unfortunately)
    SenseTypes = {"AGENT_BY_LEGACY_NAME", AGENT_BY_LEGACY_NAME, "ACTIVE", ACTIVE, "AGENT_BY_LEGACY_NAME|ACTIVE", bit32.bor(AGENT_BY_LEGACY_NAME, ACTIVE), "PASSIVE", PASSIVE, "AGENT_BY_LEGACY_NAME|PASSIVE", bit32.bor(AGENT_BY_LEGACY_NAME, PASSIVE), "ACTIVE|PASSIVE", bit32.bor(ACTIVE, PASSIVE), "AGENT_BY_LEGACY_NAME|ACTIVE|PASSIVE", bit32.bor(AGENT_BY_LEGACY_NAME, ACTIVE, PASSIVE), "SCRIPTED", SCRIPTED, "AGENT|SCRIPTED", bit32.bor(AGENT, SCRIPTED), "ACTIVE|SCRIPTED", bit32.bor(ACTIVE, SCRIPTED), "AGENT_BY_LEGACY_NAME|ACTIVE|SCRIPTED", bit32.bor(AGENT_BY_LEGACY_NAME, ACTIVE, SCRIPTED), "PASSIVE|SCRIPTED", bit32.bor(PASSIVE, SCRIPTED), "", 0}
    gIndex = 0
    SenseNextType()  -- Kick off the sensing sequence
end
function LLEvents.sensor(events)
    local detected = #events
    local x = 0
    while x < detected do
        ll.Whisper(0, tostring(x + 1) .. ": " .. ll.DetectedName(x))
        x += 1
    end
    SenseNextType()
end
function LLEvents.no_sensor()
    ll.Whisper(0, "none")
    SenseNextType()
end
`} lang="slua" /></div>
<div class="lsl-block"><span class="tag lsl-tag">LSL</span><DocsCode code={`// Report nearby sensed objects and avatars under sundry categories

list     SenseTypes;
integer  gIndex;

SenseNextType()
{
    string  text = llList2String( SenseTypes, gIndex);
    integer tipe = llList2Integer(SenseTypes, gIndex + 1);
    if (tipe)
    {
        llWhisper(0, text);
        llSensor("", NULL_KEY, tipe, 20.0, PI);
        gIndex += 2;   // increment by stride
    }
    else
        llWhisper(0, "--- Finished ---");
}

default
{
    touch_start(integer detected)
    {
        // Make a Strided list of text and sensor type combinations
        // (Can't use '|' in Global, unfortunately)
        SenseTypes = [
            "AGENT_BY_LEGACY_NAME", AGENT_BY_LEGACY_NAME,
            "ACTIVE", ACTIVE,
            "AGENT_BY_LEGACY_NAME|ACTIVE", AGENT_BY_LEGACY_NAME|ACTIVE,
            "PASSIVE", PASSIVE,
            "AGENT_BY_LEGACY_NAME|PASSIVE", AGENT_BY_LEGACY_NAME|PASSIVE,
            "ACTIVE|PASSIVE", ACTIVE|PASSIVE,
            "AGENT_BY_LEGACY_NAME|ACTIVE|PASSIVE", AGENT_BY_LEGACY_NAME|ACTIVE|PASSIVE,
            "SCRIPTED", SCRIPTED,
            "AGENT|SCRIPTED", AGENT|SCRIPTED,
            "ACTIVE|SCRIPTED", ACTIVE|SCRIPTED,
            "AGENT_BY_LEGACY_NAME|ACTIVE|SCRIPTED", AGENT_BY_LEGACY_NAME|ACTIVE|SCRIPTED,
            "PASSIVE|SCRIPTED", PASSIVE|SCRIPTED,
            "", 0 ];
        gIndex = 0;
        SenseNextType();        // Kick off the sensing sequence
    }
    sensor(integer detected)
    {
        integer x;
        while (x < detected)
        {
            llWhisper(0, (string) (x+1) + ": " + llDetectedName(x) );
            ++x;
        }
        SenseNextType();
    }
    no_sensor()
    {
        llWhisper(0, "none");
        SenseNextType();
    }
}`} lang="lsl" /></div>
  <p><b>Detecting <a href="https://wiki.secondlife.com/wiki/DAMAGEABLE" target="_blank">damageable</a> things with sensors:</b></p>
<div class="lua-block"><span class="tag lua-tag">Lua</span><DocsCode code={`ll = llcompat

local function main()
    ll.Sensor("", "", bit32.bor(SCRIPTED, AGENT, DAMAGEABLE), 20, PI)
end

function LLEvents.no_sensor()
    ll.OwnerSay("Nothing detected")
end

function LLEvents.sensor(events)
    local num_detected = #events
    ll.OwnerSay("Detected " .. tostring(num_detected) .. " damageable thing(s)")
    local i = 0
    i = 0
    while i < num_detected do
        local name = ll.DetectedName(i)
        local isAgent = bit32.band(ll.DetectedType(i), AGENT)
        local types = {"Object", "Agent"}

        ll.OwnerSay(ll.List2String(types, isAgent) .. ": " .. name)
        i += 1
    end
end

main()
`} lang="slua" /></div>
<div class="lsl-block"><span class="tag lsl-tag">LSL</span><DocsCode code={`default
{
    state_entry()
    {
        llSensor("", "", SCRIPTED|AGENT|DAMAGEABLE, 20, PI);
    }

    no_sensor()
    {
        llOwnerSay("Nothing detected");
    }

    sensor(integer num_detected)
    {
        llOwnerSay("Detected " + (string)num_detected + " damageable thing(s)");
        integer i;
        for (i = 0; i < num_detected; ++i)
        {
            string name = llDetectedName(i);
            integer isAgent = llDetectedType(i) & AGENT;
            list types = ["Object", "Agent"];

            llOwnerSay(llList2String(types, isAgent) + ": " + name);
        }
    }
}`} lang="lsl" /></div>
