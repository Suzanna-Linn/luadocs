  <h2>Examples</h2>
  <p><b>Using <a href="https://wiki.secondlife.com/wiki/LlDetectedType" target="_blank">llDetectedType</a> in <a href="https://wiki.secondlife.com/wiki/Collision" target="_blank">collision</a> event:</b></p>
<div class="lua-block"><span class="tag lua-tag">Lua</span><DocsCode code={`ll = llcompat

local type = 0

local function main()
    ll.VolumeDetect(true)
end
function LLEvents.collision_start(events)
    local detected = #events
    type = ll.DetectedType(0)
    if type == AGENT then  -- = 1
        ll.Say(0, "This is impossible. Since there is no avatar who doesn't require the physical calculation.")
    elseif type == ACTIVE then  -- = 2
        ll.Say(0, "I have been struck by a physical object not containing any script.")
    elseif type == PASSIVE then  -- = 4
        ll.Say(0, "This is impossible. Non-physical objects cannot trigger this event.")
    elseif type == SCRIPTED then  -- = 8
        ll.Say(0, "This is impossible. Since there is no object which isn't physical nor non-physical.")
    elseif type == bit32.bor(AGENT, ACTIVE) then  -- 1 + 2
        ll.Say(0, "I have been struck by an avatar.")
    elseif type == bit32.bor(SCRIPTED, ACTIVE) then  -- = 8 + 2
        ll.Say(0, "I have been struck by a physical object containing any script.")
    elseif type == bit32.bor(SCRIPTED, PASSIVE) then  -- = 8 + 4
        ll.Say(0, "This is impossible. Non-physical objects cannot trigger this event.")
    end
end

main()
`} lang="slua" /></div>
<div class="lsl-block"><span class="tag lsl-tag">LSL</span><DocsCode code={`integer type;

