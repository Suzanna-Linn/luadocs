  <h2>Caveats</h2>
  <ul>
    <li>Due to floating point precision issues (often, sqrt(x*x) != x), avoid rescaling by the values returned by <a href="https://wiki.secondlife.com/wiki/LlGetMinScaleFactor" target="_blank">llGetMinScaleFactor</a> and <a href="https://wiki.secondlife.com/wiki/LlGetMaxScaleFactor" target="_blank">llGetMaxScaleFactor</a>. To guarantee successful rescaling, use values slightly within the limits returned by those functions.</li>
  </ul>
  <h2>Examples</h2>
<div class="lua-block"><span class="tag lua-tag">Lua</span><DocsCode code={`ll = llcompat

--  Touching this script causes the object to double or halve in size.

local growing = false

local function main()
    ll.Say(PUBLIC_CHANNEL, "Touch to toggle scale.")
end

function LLEvents.touch_start(events)
    local num_detected = #events
    growing = not growing

    local min_factor = ll.GetMinScaleFactor()
    local max_factor = ll.GetMaxScaleFactor()

    ll.Say(PUBLIC_CHANNEL, "min_scale_factor = " .. tostring(min_factor) .. "\nmax_scale_factor = " .. tostring(max_factor))

    local success = 0

    if growing then
        success = ll.ScaleByFactor(2.0)
    else
        success = ll.ScaleByFactor(0.5)
    end

    if not (success ~= 0) then
        ll.Say(PUBLIC_CHANNEL, "Scaling failed!")
    end
end

main()
`} lang="slua" /></div>
<div class="lsl-block"><span class="tag lsl-tag">LSL</span><DocsCode code={`//  Touching this script causes the object to double or halve in size.

integer growing;

default
{
    state_entry()
    {
        llSay(PUBLIC_CHANNEL, "Touch to toggle scale.");
    }

    touch_start(integer num_detected)
    {
        growing = !growing;

        float min_factor = llGetMinScaleFactor();
        float max_factor = llGetMaxScaleFactor();

        llSay(PUBLIC_CHANNEL, "min_scale_factor = " + (string)min_factor
                            + "\nmax_scale_factor = " + (string)max_factor);

        integer success;

        if (growing) success = llScaleByFactor(2.0);
        else         success = llScaleByFactor(0.5);

        if (!success) llSay(PUBLIC_CHANNEL, "Scaling failed!");
    }
}`} lang="lsl" /></div>
