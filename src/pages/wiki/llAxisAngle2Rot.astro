  <h2>Deep Notes</h2>
<div class="lsl-block"><span class="tag lsl-tag">LSL</span><DocsCode code={`rotation llAxisAngle2Rot( vector axis, float angle )
{
    axis = llVecNorm( axis ) * llSin( angle/2 );
    return <axis.x, axis.y, axis.z, llCos( angle/2 )>;
}`} lang="lsl" /></div>
  <table>
    <tbody>
      <tr>
        <th>Signature</th>
      </tr>
      <tr>
        <td><div class="lsl-block"><span class="tag lsl-tag">LSL</span><DocsCode code={`
function rotation llAxisAngle2Rot( vector axis, float angle );
`} lang="lsl" /></div>

</td>
      </tr>
    </tbody>
  </table>

</DocsLayout>
      