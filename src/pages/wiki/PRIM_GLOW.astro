  <h2>Examples</h2>
  <p>basic syntax to set glow</p>
<div class="lua-block"><span class="tag lua-tag">Lua</span><DocsCode code={`-- adjust as desired .3 to a float number from 0 to 1.0 inclusive
-- adjust as desired ALL_SIDES to specific prim faces if desired

ll.SetPrimitiveParams({PRIM_GLOW, ALL_SIDES, .3})`} lang="slua" /></div>
<div class="lsl-block"><span class="tag lsl-tag">LSL</span><DocsCode code={`// adjust as desired .3 to a float number from 0 to 1.0 inclusive
// adjust as desired ALL_SIDES to specific prim faces if desired

llSetPrimitiveParams( [ PRIM_GLOW, ALL_SIDES, .3 ] ) ;`} lang="lsl" /></div>
  <p>basic syntax to get glow status</p>
<div class="lua-block"><span class="tag lua-tag">Lua</span><DocsCode code={`local mylist = ll.GetPrimitiveParams({PRIM_GLOW, ALL_SIDES})
ll.Say(0, ll.List2CSV(mylist))

--Assuming for this example that all sides are set to the same float of .3 
--In a box, which has 6 sides, the above example returns 0.300000, 0.300000, 0.300000, 0.300000, 0.300000, 0.300000
--In a prism, which has 5 sides, returns 0.300000, 0.300000, 0.300000, 0.300000, 0.300000
--In a sphere, which has only 1 side (as it were), returns 0.300000
--change ALL_SIDES to a specific prim face if desired.`} lang="slua" /></div>
<div class="lsl-block"><span class="tag lsl-tag">LSL</span><DocsCode code={`list mylist = llGetPrimitiveParams([ PRIM_GLOW,ALL_SIDES] );
llSay(0, llList2CSV(mylist));

//Assuming for this example that all sides are set to the same float of .3 
//In a box, which has 6 sides, the above example returns 0.300000, 0.300000, 0.300000, 0.300000, 0.300000, 0.300000
//In a prism, which has 5 sides, returns 0.300000, 0.300000, 0.300000, 0.300000, 0.300000
//In a sphere, which has only 1 side (as it were), returns 0.300000
//change ALL_SIDES to a specific prim face if desired.`} lang="lsl" /></div>
<div class="lua-block"><span class="tag lua-tag">Lua</span><DocsCode code={`--Each time the prim is touched, the intensity of the glow is increased (until it maxes out and cycles back to zero).
local steps = 10
local counter = 0

function LLEvents.touch_start(events)
    local total_number = #events
    ll.SetPrimitiveParams({PRIM_GLOW, ALL_SIDES, counter / (steps - 1.0)})
    counter = (counter + 1) % steps
end
`} lang="slua" /></div>
<div class="lsl-block"><span class="tag lsl-tag">LSL</span><DocsCode code={`//Each time the prim is touched, the intensity of the glow is increased (until it maxes out and cycles back to zero).
integer steps = 10;
integer counter = 0;

default 
{
    touch_start(integer total_number) 
    { 
        llSetPrimitiveParams( [ PRIM_GLOW, ALL_SIDES,  counter / (steps - 1.0) ]);
        counter = (counter + 1) % steps;
    } 
}`} lang="lsl" /></div>
<div class="lua-block"><span class="tag lua-tag">Lua</span><DocsCode code={`--Each time the prim is touched, the intensity of the glow is decreased (until it hits zero and cycles back to one).
local steps = 10
local counter = 0

function LLEvents.touch_start(events)
    local total_number = #events
    ll.SetPrimitiveParams({PRIM_GLOW, ALL_SIDES, counter / (steps - 1.0)})
    counter = (counter + steps - 1) % steps
end
`} lang="slua" /></div>
<div class="lsl-block"><span class="tag lsl-tag">LSL</span><DocsCode code={`//Each time the prim is touched, the intensity of the glow is decreased (until it hits zero and cycles back to one).
integer steps = 10;
integer counter = 0;

default 
{
    touch_start(integer total_number) 
    { 
        llSetPrimitiveParams( [ PRIM_GLOW, ALL_SIDES,  counter / (steps - 1.0) ]);
        counter = (counter + steps - 1) % steps;
    } 
}`} lang="lsl" /></div>
