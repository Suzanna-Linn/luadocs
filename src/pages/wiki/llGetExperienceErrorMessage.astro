
---
import DocsLayout from '/src/layouts/DocsLayout.astro';
import DocsCode from '/src/components/DocsCode.astro';
---

<DocsLayout title="Lua & LSL Docs">
<div class="dashboard summary-function">
  <div class="dashboard-header">
    <span class="lua-section"><span class="tag lua-tag">Lua</span><DocsCode code={`ll.GetExperienceErrorMessage(Error: number): string`} lang="slua" /></span>
    <span class="lsl-section"><span class="tag lsl-tag">LSL</span><DocsCode code={`string llGetExperienceErrorMessage(integer Error);`} lang="lsl" /></span>
  </div>

  <div class="dashboard-body">
    <div class="dash-col">
      <p>  <p>Returns a text description of a particular Experience LSL error constant.</p>
  <p>Returns a string describing the error code passed or the string corresponding to <b>error</b>. Returns <a href="https://wiki.secondlife.com/w/index.php?title=XP_ERROR_UNKNOWN_ERROR&amp;action=edit&amp;redlink=1" target="_blank">XP_ERROR_UNKNOWN_ERROR</a> if the <b>error</b> is not a valid error code.</p>
</p>
      <table class="param-table" id="parameters">
        <tr>
          <td><span class="lua-section"><span class="tag lua-tag">Lua</span>number</span></td>
          <td><span class="lsl-section"><span class="tag lsl-tag">LSL</span>integer</span></td>
          <td>Error / <a href="https://wiki.secondlife.com/wiki/Category:LSL_Integer/experience_error" target="_blank">error</a></td>
          <td>The error code constant to translate.</td>
        </tr>
      </table>
    </div>

    <div class="dash-col">
      <div class="dash-section-title">Categories</div>
      <ul class="meta-list">
        <li>experience</li>
      </ul>
    </div>

    <div class="dash-col">
      <div class="dash-section-title">Tech Specs</div>
      <div class="tech-item"><span class="tech-label">Energy</span><span class="tech-val">10</span></div>
      <div class="tech-item"><span class="tech-label">LSO ID</span><span class="tech-val">603</span></div>

      <div class="label-stack">
        <span class="attr-label bg-mandatory">Use Return</span>
        <span class="attr-label bg-experience">Experience</span>
      </div>
    </div>
  </div>
</div>
