    <tbody>
      <tr>
        <td>•</td>
        <td><a href="https://wiki.secondlife.com/wiki/Changed" target="_blank">changed</a></td>
        <td></td>
        <td></td>
        <td></td>
      </tr>
    </tbody>
  </table>
  <h2>Examples</h2>
<div class="lua-block"><span class="tag lua-tag">Lua</span><DocsCode code={`function LLEvents.changed(change)
    if bit32.btest(change, CHANGED_OWNER) then  --note that it's & and not &&... it's bitwise!
        ll.OwnerSay("The owner of the object has changed.")
    end
end
`} lang="slua" /></div>
<div class="lsl-block"><span class="tag lsl-tag">LSL</span><DocsCode code={`default
{
    changed(integer change)
    {
        if (change & CHANGED_OWNER) //note that it's & and not &&... it's bitwise!
        {
            llOwnerSay("The owner of the object has changed.");
        }
    }
}`} lang="lsl" /></div>
