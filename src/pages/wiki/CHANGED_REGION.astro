  <h2>Examples</h2>
<div class="lua-block"><span class="tag lua-tag">Lua</span><DocsCode code={`function LLEvents.changed(change)
    if bit32.btest(change, CHANGED_REGION) then  --note that it's & and not &&... it's bitwise!
        ll.OwnerSay("The region the object is in has changed.")
    end
end
`} lang="slua" /></div>
<div class="lsl-block"><span class="tag lsl-tag">LSL</span><DocsCode code={`default
{
    changed(integer change)
    {
        if (change & CHANGED_REGION) //note that it's & and not &&... it's bitwise!
        {
            llOwnerSay("The region the object is in has changed.");
        }
    }
}`} lang="lsl" /></div>
