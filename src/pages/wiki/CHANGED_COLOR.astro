  <h2>Examples</h2>
<div class="lua-block"><span class="tag lua-tag">Lua</span><DocsCode code={`function LLEvents.changed(change)

    if bit32.btest(change, CHANGED_COLOR) then  --note that it's & and not &&... it's bitwise!
        ll.OwnerSay("The color or alpha changed.")
    end
end
`} lang="slua" /></div>
<div class="lsl-block"><span class="tag lsl-tag">LSL</span><DocsCode code={`default
{
    changed(integer change)
    {

        if (change & CHANGED_COLOR) //note that it's & and not &&... it's bitwise!
        {
            llOwnerSay("The color or alpha changed.");
        }
    }
}`} lang="lsl" /></div>
