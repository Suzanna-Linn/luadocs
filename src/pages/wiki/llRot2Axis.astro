
---
import DocsLayout from '/src/layouts/DocsLayout.astro';
import DocsCode from '/src/components/DocsCode.astro';
---

<DocsLayout title="Lua & LSL Docs">
<div class="dashboard summary-function">
  <div class="dashboard-header">
    <span class="lua-section"><span class="tag lua-tag">Lua</span><DocsCode code={`ll.Rot2Axis(Rotation: rotation): vector`} lang="slua" /></span>
    <span class="lsl-section"><span class="tag lsl-tag">LSL</span><DocsCode code={`vector llRot2Axis(rotation Rotation);`} lang="lsl" /></span>
  </div>

  <div class="dashboard-body">
    <div class="dash-col">
      <p>Returns the rotation axis represented by Rotation.
Returns the axis represented by the Rotation.</p>
      <table class="param-table" id="parameters">
        <tr>
          <td><span class="lua-section"><span class="tag lua-tag">Lua</span>rotation</span></td>
          <td><span class="lsl-section"><span class="tag lsl-tag">LSL</span>rotation</span></td>
          <td>Rotation</td>
          <td></td>
        </tr>
      </table>
    </div>

    <div class="dash-col">
      <div class="dash-section-title">Categories</div>
      <ul class="meta-list">
        <li>math</li>
        <li>math_3d</li>
        <li>math_trig</li>
        <li>quaternion</li>
        <li>vector</li>
      </ul>
    </div>

    <div class="dash-col">
      <div class="dash-section-title">Tech Specs</div>
      <div class="tech-item"><span class="tech-label">Energy</span><span class="tech-val">10</span></div>
      <div class="tech-item"><span class="tech-label">LSO ID</span><span class="tech-val">170</span></div>

      <div class="label-stack">
        <span class="attr-label bg-pure">Side-Effect Free</span>
      </div>
    </div>
  </div>
</div>

</DocsLayout>
      