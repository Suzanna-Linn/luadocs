  <h2>Deep Notes</h2>
<div class="lsl-block"><span class="tag lsl-tag">LSL</span><DocsCode code={`vector llRot2Axis(rotation a) {
    if(a.s < 0)
        return -llVecNorm(<a.x, a.y, a.z>);
    return llVecNorm(<a.x, a.y, a.z>)
}`} lang="lsl" /></div>
<div class="lsl-block"><span class="tag lsl-tag">LSL</span><DocsCode code={`vector llRot2Axis(rotation a) {
    return llVecNorm(<a.x, a.y, a.z>) * (1 | -(a.s < 0));
}`} lang="lsl" /></div>
