  <h2>Caveats</h2>
  <ul>
    <li>This events will be triggered in every script in the prim, not just in the <a href="https://wiki.secondlife.com/wiki/LlHTTPRequest" target="_blank">requesting</a> script.</li>
    <li>It is <i>not</i> guaranteed that there will be an http_response for every <a href="https://wiki.secondlife.com/wiki/LlHTTPRequest" target="_blank">llHTTPRequest</a>().
    <ul>
      <li>If the script moves to a different region before the remote HTTP server can respond, the response will be lost. [[1]](https://lists.secondlife.com/pipermail/secondlifescripters/2011-August/006309.html)</li>
    </ul>
  
    </li>
  </ul>
  <h2>Examples</h2>
<div class="lua-block"><span class="tag lua-tag">Lua</span><DocsCode code={`local http_request_id = NULL_KEY

local function main()
    http_request_id = ll.HTTPRequest("url", {}, "")
end

function LLEvents.http_response(request_id, status, metadata, body)
    if request_id == http_request_id then
        ll.SetText(body, vector(0, 0, 1), 1)
    end
end

main()
`} lang="slua" /></div>
<div class="lsl-block"><span class="tag lsl-tag">LSL</span><DocsCode code={`key http_request_id;

default
{
    state_entry()
    {
        http_request_id = llHTTPRequest("url", [], "");
    }

    http_response(key request_id, integer status, list metadata, string body)
    {
        if (request_id == http_request_id)
        {
            llSetText(body, <0,0,1>, 1);
        }
    }
}`} lang="lsl" /></div>
  <p>To parse POST content:</p>
<div class="lua-block"><span class="tag lua-tag">Lua</span><DocsCode code={`ll = llcompat

local function get_post_value(content, returns)
    --  this parses application/x-www-form-urlencoded POST data

    --  for instance if the webserver posts 'data1=hi&data2=blah' then
    --  calling get_post_value("data1=hi&data2=blah","data1"); would return "hi"
    --  written by MichaelRyan Allen, Unrevoked Clarity

    local params = ll.ParseString2List(content, {"&"}, {})
    local index = bit32.bnot(#params)

    local keys = {}  -- = [];
    local values = {}  -- = [];

    -- start with -length and end with -1
    while (function() index += 1 return index end)() ~= 0 do
        local parsedParams = ll.ParseString2List(ll.List2String(params, index), {"="}, {})
        keys = ll.ListInsertList(keys, {ll.UnescapeURL(ll.List2String(parsedParams, 0))}, #keys)
        values = ll.ListInsertList(values, {ll.UnescapeURL(ll.List2String(parsedParams, 1))}, #values)
    end

    local found = ll.ListFindList(keys, {returns})
    if bit32.bnot(found) ~= 0 then
        return ll.List2String(values, found)
    end
    --  else
    return ""
end
`} lang="slua" /></div>
<div class="lsl-block"><span class="tag lsl-tag">LSL</span><DocsCode code={`string get_post_value(string content, string returns)
{
//  this parses application/x-www-form-urlencoded POST data

//  for instance if the webserver posts 'data1=hi&data2=blah' then
//  calling get_post_value("data1=hi&data2=blah","data1"); would return "hi"
//  written by MichaelRyan Allen, Unrevoked Clarity

    list params =  llParseString2List(content,["&"],[]);
    integer index = ~llGetListLength(params);

    list keys;// = [];
    list values;// = [];

    // start with -length and end with -1
    while (++index)
    {
        list parsedParams =  llParseString2List(llList2String(params, index), ["="], []);
        keys += llUnescapeURL(llList2String(parsedParams, 0));
        values += llUnescapeURL(llList2String(parsedParams, 1));
    }

    integer found = llListFindList(keys, [returns]);
    if(~found)
        return llList2String(values, found);
//  else
        return "";
}`} lang="lsl" /></div>
  <p>Another Example:</p>
  <table>
    <tbody>
      <tr>
        <td></td>
        <td><b>Important:</b> Remember to release URLs that you have requested! They are region resources just like prims, and it is possible to use them all and break other scripts.</td>
      </tr>
