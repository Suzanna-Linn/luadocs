  <ul>
    <li>Note that this precision caveat does not apply to scripts written in SLua, only to LSL scripts. In SLua:
    <ul>
      <li>the timer precision is 64-bit, and will maintain 1/64sec precision for ~4.4million years.</li>
      <li><a href="https://wiki.secondlife.com/wiki/LlResetTime" target="_blank">llResetTime</a> and <a href="https://wiki.secondlife.com/wiki/LlGetAndResetTime" target="_blank">llGetAndResetTime</a> have been removed</li>
    </ul>
  
    </li>
  </ul>
  <h2>Examples</h2>
<div class="lua-block"><span class="tag lua-tag">Lua</span><DocsCode code={`ll = llcompat

local function main()
    ll.ResetTime()
end
function LLEvents.touch_start(events)
    local num_touch = #events
    local time = ll.GetTime()  --Instead getting, and then resetting the time, we could use llGetAndResetTime() to accomplish the same thing.
    ll.ResetTime()
    ll.Say(0, tostring(time) .. " seconds have elapsed since the last touch.")
end

main()
`} lang="slua" /></div>
<div class="lsl-block"><span class="tag lsl-tag">LSL</span><DocsCode code={`default {
    state_entry()
    {
        llResetTime();
    }
    touch_start(integer num_touch)
    {
        float time = llGetTime(); //Instead getting, and then resetting the time, we could use llGetAndResetTime() to accomplish the same thing.
        llResetTime();
        llSay(0,(string)time + " seconds have elapsed since the last touch." );
    }
}`} lang="lsl" /></div>
<div class="lua-block"><span class="tag lua-tag">Lua</span><DocsCode code={`ll = llcompat

-- Distinguish between a single click and a double click

local gHoldTime = 0

function LLEvents.touch_start(events)
    local total_number = #events
    local now = ll.GetTime()
    if now - gHoldTime < 0.3 then
        ll.Say(PUBLIC_CHANNEL, "Double clicked")
    -- Trigger one sequence of actions
    else
        ll.SetTimerEvent(0.32)
    end
    gHoldTime = now
end

function LLEvents.timer()
    ll.SetTimerEvent(0.0)
    if ll.GetTime() - gHoldTime > 0.3 then
        ll.Say(PUBLIC_CHANNEL, "Single clicked.")
    -- Trigger a different sequence of actions
    end
end
`} lang="slua" /></div>
<div class="lsl-block"><span class="tag lsl-tag">LSL</span><DocsCode code={`// Distinguish between a single click and a double click

float gHoldTime;

default
{
    touch_start(integer total_number)
    {
        float now = llGetTime();
        if (now - gHoldTime < 0.3)
        {
            llSay(PUBLIC_CHANNEL,"Double clicked");
            // Trigger one sequence of actions
        }
        else
        {
            llSetTimerEvent(0.32);
        }
        gHoldTime = now;
    }
    
    timer()
    {
        llSetTimerEvent(0.0);
        if (llGetTime()-gHoldTime > 0.3)
        {
            llSay(PUBLIC_CHANNEL,"Single clicked.");
            // Trigger a different sequence of actions
        }
    }
}`} lang="lsl" /></div>
<div class="lua-block"><span class="tag lua-tag">Lua</span><DocsCode code={`--  To do time-dependant loops of whatever:
--  for example move 2 meters within 5.0 seconds

local time = 5.0
local i = 0
`} lang="slua" /></div>
<div class="lsl-block"><span class="tag lsl-tag">LSL</span><DocsCode code={`//  To do time-dependant loops of whatever:
//  for example move 2 meters within 5.0 seconds

float time = 5.0;
float i;
llResetTime();
do
{
    i = llGetTime()/time;
    // move2meters*i
}
while (llGetTime() < time);`} lang="lsl" /></div>
