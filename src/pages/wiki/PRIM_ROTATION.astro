  <h2>Examples</h2>
<div class="lua-block"><span class="tag lua-tag">Lua</span><DocsCode code={`local function main()
    --[[ This is rotates only once and just gradually that once ]]
    local rotationAngle = vector(2.3, 5.5, 9.7)
    local rot = ll.Euler2Rot(rotationAngle)
    ll.SetLinkPrimitiveParams(2, {PRIM_ROTATION, rot})
end

main()
`} lang="slua" /></div>
<div class="lsl-block"><span class="tag lsl-tag">LSL</span><DocsCode code={`default
{
    state_entry()
    {
        /* This is rotates only once and just gradually that once */
        vector rotationAngle = <2.3, 5.5, 9.7>; 
        rotation rot = llEuler2Rot( rotationAngle );
        llSetLinkPrimitiveParams(2, [ PRIM_ROTATION, rot ]);
    }
}`} lang="lsl" /></div>
