
---
import DocsLayout from '/src/layouts/DocsLayout.astro';
import DocsCode from '/src/components/DocsCode.astro';
---

<DocsLayout title="Lua & LSL Docs">
<div class="dashboard summary-event">
  <div class="dashboard-header">
    <span class="lua-section"><span class="tag lua-tag">Lua</span><DocsCode code={`email(Time: string, Address: string, Subject: string, Body: string, NumberRemaining: number)`} lang="slua" /></span>
    <span class="lsl-section"><span class="tag lsl-tag">LSL</span><DocsCode code={`email(string Time, string Address, string Subject, string Body, integer NumberRemaining)`} lang="lsl" /></span>
  </div>

  <div class="dashboard-body">
    <div class="dash-col">
      <p>This event is triggered when an email sent to this script arrives. \t\t\tThe number remaining tells how many more emails are known to be still pending.</p>
      <table class="param-table" id="parameters">
        <tr>
          <td><span class="lua-section"><span class="tag lua-tag">Lua</span>string</span></td>
          <td><span class="lsl-section"><span class="tag lsl-tag">LSL</span>string</span></td>
          <td>Time</td>
          <td></td>
        </tr>
        <tr>
          <td><span class="lua-section"><span class="tag lua-tag">Lua</span>string</span></td>
          <td><span class="lsl-section"><span class="tag lsl-tag">LSL</span>string</span></td>
          <td>Address</td>
          <td></td>
        </tr>
        <tr>
          <td><span class="lua-section"><span class="tag lua-tag">Lua</span>string</span></td>
          <td><span class="lsl-section"><span class="tag lsl-tag">LSL</span>string</span></td>
          <td>Subject</td>
          <td></td>
        </tr>
        <tr>
          <td><span class="lua-section"><span class="tag lua-tag">Lua</span>string</span></td>
          <td><span class="lsl-section"><span class="tag lsl-tag">LSL</span>string</span></td>
          <td>Body</td>
          <td></td>
        </tr>
        <tr>
          <td><span class="lua-section"><span class="tag lua-tag">Lua</span>number</span></td>
          <td><span class="lsl-section"><span class="tag lsl-tag">LSL</span>integer</span></td>
          <td>NumberRemaining</td>
          <td></td>
        </tr>
      </table>
    </div>

    <div class="dash-col">
    </div>

    <div class="dash-col">
      <div class="dash-section-title">Tech Specs</div>

      <div class="label-stack">
      </div>
    </div>
  </div>
</div>

</DocsLayout>
      