          <td><span class="lsl-section"><span class="tag lsl-tag">LSL</span>integer</span></td>
          <td>Start / start</td>
          <td><span class="lua-section"><span class="tag lua-tag">Lua</span>It's 1 based</span>start index</td>
        </tr>
        <tr>
          <td><span class="lua-section"><span class="tag lua-tag">Lua</span>number</span></td>
          <td><span class="lsl-section"><span class="tag lsl-tag">LSL</span>integer</span></td>
          <td>End / end</td>
          <td><span class="lua-section"><span class="tag lua-tag">Lua</span>It's 1 based</span>end index</td>
