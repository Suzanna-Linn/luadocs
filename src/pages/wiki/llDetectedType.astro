  <h2>Caveats</h2>
  <ul>
    <li>If <b>number</b> is out of bounds this function returns zero and the script continues to execute without an error message.</li>
    <li>Events that enable the <a href="https://wiki.secondlife.com/wiki/Category:LSL_Detected" target="_blank">llDetected*</a> functions always return at least one detected item.
    <ul>
      <li>Detection events are not raised if there is nothing detected.[[1]](#footnote_1)</li>
      <li>The detection event's items detected parameter is initially never less than 1.[[2]](#footnote_2)</li>
    </ul>
  
    </li>
  </ul>
  <h2>Examples</h2>
<div class="lua-block"><span class="tag lua-tag">Lua</span><DocsCode code={`ll = llcompat

----// Type & name of collision source //--//

function LLEvents.collision_start(events)
    local vIntCollided = #events
    local vBitType = 0
    local vStrType = ""
    repeat
        vBitType = ll.DetectedType((function() vIntCollided -= 1 return vIntCollided end)())
        if bit32.btest(vBitType, AGENT_BY_LEGACY_NAME) then
            vStrType = "avatar"
        else
            vStrType = "object"
        end
        ll.OwnerSay("An " .. vStrType .. " named '" .. ll.DetectedName(vIntCollided) .. "' collided with me")
    until not (vIntCollided ~= 0)
end
`} lang="slua" /></div>
<div class="lsl-block"><span class="tag lsl-tag">LSL</span><DocsCode code={`//--// Type & name of collision source //--//

default{
    collision_start( integer vIntCollided ){
        integer vBitType;
        string vStrType;
        do
        {
            vBitType = llDetectedType( --vIntCollided );
            if (vBitType & AGENT_BY_LEGACY_NAME)
                vStrType = "avatar";
            else
                vStrType = "object";
            llOwnerSay( "An " + vStrType + " named '" + llDetectedName( vIntCollided ) + "' collided with me" );
        }
        while (vIntCollided);
    }
}`} lang="lsl" /></div>
