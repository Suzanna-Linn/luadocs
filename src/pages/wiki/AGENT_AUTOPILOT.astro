<div class="lua-block"><span class="tag lua-tag">Lua</span><DocsCode code={`if bit32.btest(ll.GetAgentInfo(ll.GetOwner()), AGENT_AUTOPILOT) then
    ll.Say(0, "Oops, sorry, don't blame me, it was my auto-pilot!")
end`} lang="slua" /></div>
