        <th>Description</th>
      </tr>
      <tr>
        <td><a href="https://wiki.secondlife.com/wiki/LINK_ROOT" target="_blank">LINK_ROOT</a></td>
        <td>1</td>
        <td>refers to the <a href="https://wiki.secondlife.com/wiki/Link#Root_Prim" target="_blank">root</a> prim in a multi-prim linked set[[1]](#footnote_1)</td>
      </tr>
      <tr>
        <td><a href="https://wiki.secondlife.com/wiki/LINK_SET" target="_blank">LINK_SET</a></td>
        <td>-1</td>
        <td>refers to all prims</td>
      </tr>
      <tr>
        <td><a href="https://wiki.secondlife.com/wiki/LINK_ALL_OTHERS" target="_blank">LINK_ALL_OTHERS</a></td>
        <td>-2</td>
        <td>refers to all other prims</td>
      </tr>
    </tbody>
  </table>
