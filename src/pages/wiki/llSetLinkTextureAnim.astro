    <span class="lua-section"><span class="tag lua-tag">Lua</span><DocsCode code={`ll.SetLinkTextureAnim(LinkNumber: number, Mode: number, Face: number, SizeX: number, SizeY: number, Start: number, Length: number, Rate: number)`} lang="slua" /></span>
    <span class="lsl-section"><span class="tag lsl-tag">LSL</span><DocsCode code={`llSetLinkTextureAnim(integer LinkNumber, integer Mode, integer Face, integer SizeX, integer SizeY, float Start, float Length, float Rate);`} lang="lsl" /></span>
