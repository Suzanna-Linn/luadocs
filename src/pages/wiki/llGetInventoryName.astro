          <td><span class="lsl-section"><span class="tag lsl-tag">LSL</span>integer</span></td>
          <td>InventoryType / type</td>
          <td>INVENTORY_* flag</td>
        </tr>
        <tr>
          <td><span class="lua-section"><span class="tag lua-tag">Lua</span>number</span></td>
          <td><span class="lsl-section"><span class="tag lsl-tag">LSL</span>integer</span></td>
          <td>Index / <a href="https://wiki.secondlife.com/wiki/Category:LSL_Parameters/number" target="_blank">number</a></td>
          <td><span class="lua-section"><span class="tag lua-tag">Lua</span>It's 1 based</span>Beginning from 0</td>
