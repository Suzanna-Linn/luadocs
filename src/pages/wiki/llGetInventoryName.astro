  <h2>Caveats</h2>
  <ul>
    <li>If <b>number</b> is out of bounds the script continues to execute without an error message.</li>
  </ul>
  <h2>Examples</h2>
  <p>Box Unpacker</p>
<div class="lua-block"><span class="tag lua-tag">Lua</span><DocsCode code={`ll = llcompat

-- Give all prim contents to anyone touching this object,
-- But don't give this script itself.

function LLEvents.touch_start(events)
    local num_detected = #events
    local InventoryList = {}
    local count = ll.GetInventoryNumber(INVENTORY_ALL)  -- Count of all items in prim's contents
    local ItemName = ""
    while (function() local tmp = count count -= 1 return tmp end)() ~= 0 do
        ItemName = ll.GetInventoryName(INVENTORY_ALL, count)
        if ItemName ~= ll.GetScriptName() then
            InventoryList = ll.ListInsertList(InventoryList, {ItemName}, #InventoryList)  -- add all contents except this script, to a list
        end
    end
    -- Give all the items to the toucher, in a folder named as per this prim's name
    ll.GiveInventoryList(ll.DetectedKey(0), ll.GetObjectName(), InventoryList)
end
`} lang="slua" /></div>
<div class="lsl-block"><span class="tag lsl-tag">LSL</span><DocsCode code={`// Give all prim contents to anyone touching this object,
// But don't give this script itself.

default
{
    touch_start(integer num_detected)
    {
        list    InventoryList;
        integer count = llGetInventoryNumber(INVENTORY_ALL);  // Count of all items in prim's contents
        string  ItemName;
        while (count--)
        {
            ItemName = llGetInventoryName(INVENTORY_ALL, count);
            if (ItemName != llGetScriptName() )  
                InventoryList += ItemName;   // add all contents except this script, to a list
        }
        // Give all the items to the toucher, in a folder named as per this prim's name
        llGiveInventoryList(llDetectedKey(0), llGetObjectName(), InventoryList);
    }
}`} lang="lsl" /></div>
  <h2>Notes</h2>
  <p>The maximum number of characters for an object inventory item is currently 63 characters.</p>
