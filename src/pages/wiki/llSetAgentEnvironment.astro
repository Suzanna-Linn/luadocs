  <h2>Caveats</h2>
  <ul>
    <li>The list of valid parameters differs from those available for <a href="https://wiki.secondlife.com/wiki/LlGetEnvironment" target="_blank">llGetEnvironment</a>.</li>
    <li>The agent's viewer may choose to ignore this command.</li>
    <li>An environment set locally on the viewer will override any environment set from this function.</li>
  </ul>
  <h2>Examples</h2>
<div class="lua-block"><span class="tag lua-tag">Lua</span><DocsCode code={`ll = llcompat

local gTransitionTime = 3.0
local gListEnvironmentParams = {SKY_CLOUD_TEXTURE, TEXTURE_PLYWOOD, SKY_GAMMA, 10.0, WATER_NORMAL_SCALE, vector(5.0, 5.0, 5.0)}

function LLEvents.touch_start(events)
    local total_number = #events
    local person = ll.DetectedKey(0)
    if ll.GetAgentSize(person) ~= ZERO_VECTOR then
        ll.RequestExperiencePermissions(person, "")
    else
        ll.InstantMessage(person, "You need to be in the same region to change environment")
    end
end

function LLEvents.experience_permissions(agent_id)
    local envTest = ll.SetAgentEnvironment(agent_id, gTransitionTime, gListEnvironmentParams)
    if envTest == 1 then
        ll.RegionSayTo(agent_id, 0, "Applying environment for " .. tostring(agent_id))
    else
        ll.RegionSayTo(agent_id, 0, "Cannot apply environment for " .. tostring(agent_id) .. " due to reason id: " .. tostring(envTest))
    end
end

function LLEvents.experience_permissions_denied(agent_id, reason)
    ll.RegionSayTo(agent_id, 0, "Denied experience permissions for " .. tostring(agent_id) .. " due to reason id: " .. tostring(reason))
end
`} lang="slua" /></div>
<div class="lsl-block"><span class="tag lsl-tag">LSL</span><DocsCode code={`float gTransitionTime = 3.0;
list gListEnvironmentParams = [
    SKY_CLOUD_TEXTURE, TEXTURE_PLYWOOD,
    SKY_GAMMA, 10.0,
    WATER_NORMAL_SCALE, <5.0, 5.0, 5.0>
];

default
{
    touch_start(integer total_number)
    {
        key person = llDetectedKey(0);
        if (llGetAgentSize(person) != ZERO_VECTOR)
        {
            llRequestExperiencePermissions(person, "");
        }
        else
        {
            llInstantMessage(person, "You need to be in the same region to change environment");
        }
    }

    experience_permissions(key agent_id)
    {
        integer envTest = llSetAgentEnvironment(agent_id, gTransitionTime, gListEnvironmentParams);
        if (envTest == 1)
        {
            llRegionSayTo(agent_id, 0, "Applying environment for " + (string)agent_id);
        }
        else
        {
            llRegionSayTo(agent_id, 0, "Cannot apply environment for " + (string)agent_id + " due to reason id: " + (string)envTest);
        }
    }

    experience_permissions_denied(key agent_id, integer reason)
    {
        llRegionSayTo(agent_id, 0, "Denied experience permissions for " + (string)agent_id + " due to reason id: " + (string)reason);
    }
}`} lang="lsl" /></div>
