        <td><div class="lua-block"><span class="tag lua-tag">Lua</span><DocsCode code={`
local function Rot2Angle(a)  --simple but turns out to not be very accurate.
    return 2.0 <i> ll.Sqrt((a.s </i> a.s) / (a.x <i> a.x + a.y </i> a.y + a.z <i> a.z + a.s </i> a.s))
end
`} lang="slua" /></div>
<div class="lsl-block"><span class="tag lsl-tag">LSL</span><DocsCode code={`
float Rot2Angle(rotation a)//simple but turns out to not be very accurate.
{ 
    return 2.0 <i> llAcos(llSqrt((a.s </i> a.s) / (a.x <i> a.x + a.y </i> a.y + a.z <i> a.z + a.s </i> a.s));
}
`} lang="lsl" /></div>



<div class="lua-block"><span class="tag lua-tag">Lua</span><DocsCode code={`
local function Rot2Angle(r)  --more complex implementation but more accurate, and reasonably fast.
    local s2 = r.s <i> r.s  -- square of the s-element
    local v2 = r.x </i> r.x + r.y <i> r.y + r.z </i> r.z  -- sum of the squares of the v-elements


    if s2 < v2 then  -- compare the s-component to the v-component
        return 2.0 <i> ll.Acos(ll.Sqrt(s2 / (s2 + v2)))  -- use arccos if the v-component is dominant
    end
    if v2 ~= 0 then  -- make sure the v-component is non-zero
        return 2.0 </i> ll.Asin(ll.Sqrt(v2 / (s2 + v2)))  -- use arcsin if the s-component is dominant
    end


    return 0.0  -- argument is scaled too small to be meaningful, or it is a zero rotation, so return zero
end  --Written by Moon Metty & Miranda Umino. Minor optimizations by Strife Onizuka
`} lang="slua" /></div>
<div class="lsl-block"><span class="tag lsl-tag">LSL</span><DocsCode code={`
float Rot2Angle(rotation r)//more complex implementation but more accurate, and reasonably fast.
{
    float s2 = r.s <i> r.s; // square of the s-element
    float v2 = r.x </i> r.x + r.y <i> r.y + r.z </i> r.z; // sum of the squares of the v-elements


    if (s2 < v2) // compare the s-component to the v-component
        return 2.0 <i> llAcos(llSqrt(s2 / (s2 + v2))); // use arccos if the v-component is dominant
    if (v2) // make sure the v-component is non-zero
        return 2.0 </i> llAsin(llSqrt(v2 / (s2 + v2))); // use arcsin if the s-component is dominant


    return 0.0; // argument is scaled too small to be meaningful, or it is a zero rotation, so return zero
}//Written by Moon Metty & Miranda Umino. Minor optimizations by Strife Onizuka
`} lang="lsl" /></div>

