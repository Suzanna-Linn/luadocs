
---
import DocsLayout from '/src/layouts/DocsLayout.astro';
import DocsCode from '/src/components/DocsCode.astro';
---

<DocsLayout title="Lua & LSL Docs">
<div class="dashboard summary-constant">
  <div class="dashboard-header">
    <span class="lua-section"><span class="tag lua-tag">Lua</span><DocsCode code={`SIT_INVALID_LINK: number = -5`} lang="slua" /></span>
    <span class="lsl-section"><span class="tag lsl-tag">LSL</span><DocsCode code={`integer SIT_INVALID_LINK = -5;`} lang="lsl" /></span>
  </div>

  <div class="dashboard-body">
    <div class="dash-col">
      <p>Link ID did not specify a valid prim in the linkset or resolved to multiple prims.</p>
    </div>

    <div class="dash-col">
      <div class="dash-section-title">Member Of</div>
      <ul class="meta-list">
        <li>SitError</li>
      </ul>
    </div>

    <div class="dash-col">
      <div class="dash-section-title">Tech Specs</div>

      <div class="label-stack">
      </div>
    </div>
  </div>
</div>

</DocsLayout>
      