  <div class="dashboard-body">
    <div class="dash-col">
      <p>  <p>Sets or removes individual overrides applied to a <a href="https://wiki.secondlife.com/wiki/PBR" target="_blank">PBR</a> texture on a face</p>
</p>
      <table class="param-table" id="parameters">
        <tr>
          <td><span class="lua-section"><span class="tag lua-tag">Lua</span>number</span></td>
          <td><span class="lsl-section"><span class="tag lsl-tag">LSL</span>integer</span></td>
          <td><a href="https://wiki.secondlife.com/wiki/Category:LSL_Parameters/link" target="_blank">link</a></td>
          <td><a href="https://wiki.secondlife.com/wiki/Link" target="_blank">Link</a> number (0: unlinked,&#32;1: <a href="https://wiki.secondlife.com/wiki/Link#Root_Prim" target="_blank">root</a> prim, >1: child prims&#32;and seated avatars) or a `LINK_*` <a href="https://wiki.secondlife.com/wiki/Flag" target="_blank">flag</a>&#32;</td>
        </tr>
        <tr>
          <td><span class="lua-section"><span class="tag lua-tag">Lua</span>number</span></td>
          <td><span class="lsl-section"><span class="tag lsl-tag">LSL</span>integer</span></td>
          <td><a href="https://wiki.secondlife.com/wiki/Category:LSL_Parameters/face" target="_blank">face</a></td>
          <td><a href="https://wiki.secondlife.com/wiki/Category:LSL_Face" target="_blank">face</a> number or <a href="https://wiki.secondlife.com/wiki/ALL_SIDES" target="_blank">ALL_SIDES</a></td>
        </tr>
        <tr>
          <td><span class="lua-section"><span class="tag lua-tag">Lua</span>{`{any}`}</span></td>
          <td><span class="lsl-section"><span class="tag lsl-tag">LSL</span>list</span></td>
          <td>options / <a href="https://wiki.secondlife.com/wiki/Category:LSL_Parameters/params" target="_blank">params</a></td>
          <td>List of overrides and override values.</td>
        </tr>
      </table>
