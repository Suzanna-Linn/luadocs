  <h2>Examples</h2>
<div class="lua-block"><span class="tag lua-tag">Lua</span><DocsCode code={`ll = llcompat

-- Set this prim rotating
ll.TargetOmega(vector(1.0, 3.0, 0.5), TWO_PI, 1.0)

-- Read back this prim's current target omega
local current_omega = ll.GetPrimitiveParams({PRIM_OMEGA})  -- returns [axis, spinrate, gain]
local axis = ll.List2Vector(current_omega, 0)  -- Should be llVecNorm(<1.0,3.0,0.5>)
local spinrate = ll.List2Float(current_omega, 1)  -- Should be TWO_PI*llVecMag(<1.0,3.0,0.5>)
local gain = ll.List2Float(current_omega, 2)  -- Should be 1.0

-- Set all child prims rotating
ll.SetLinkPrimitiveParamsFast(LINK_ALL_CHILDREN, {PRIM_OMEGA, vector(1.0, 3.0, 0.5), TWO_PI, 1.0})`} lang="slua" /></div>
<div class="lsl-block"><span class="tag lsl-tag">LSL</span><DocsCode code={`// Set this prim rotating
llTargetOmega(<1.0,3.0,0.5>, TWO_PI, 1.0);

// Read back this prim's current target omega
list current_omega = llGetPrimitiveParams([PRIM_OMEGA]); // returns [axis, spinrate, gain]
vector axis = llList2Vector(current_omega, 0); // Should be llVecNorm(<1.0,3.0,0.5>)
float spinrate = llList2Float(current_omega, 1); // Should be TWO_PI*llVecMag(<1.0,3.0,0.5>)
float gain = llList2Float(current_omega, 2); // Should be 1.0

// Set all child prims rotating
llSetLinkPrimitiveParamsFast(LINK_ALL_CHILDREN, [PRIM_OMEGA, <1.0,3.0,0.5>, TWO_PI, 1.0]);`} lang="lsl" /></div>
  <p>Also, can use llSetPrimitiveParams for the root prim.</p>
<div class="lua-block"><span class="tag lua-tag">Lua</span><DocsCode code={`-- will need two prims linked together for this script.
local function main()
    -- make some sort of rotation angle for the omega...
    local rotationAngle = vector(2.3, 5.5, 9.7) * ll.Tan(85)

    -- rotate the main prim slowly using the same rotataion angle, rate, and gain...
    ll.SetPrimitiveParams({PRIM_OMEGA, rotationAngle * 0.3, 1.0, 1.0})

    -- rotate the link satellite prim separately around its own axis 
    -- it will rotate also around the main prim because the main prim is rotating.
    ll.SetLinkPrimitiveParams(2, {PRIM_OMEGA, rotationAngle, 1.0, 1.0})
end

main()
`} lang="slua" /></div>
<div class="lsl-block"><span class="tag lsl-tag">LSL</span><DocsCode code={`// will need two prims linked together for this script.
default
{
    state_entry()
    {
        // make some sort of rotation angle for the omega...
        vector rotationAngle = <2.3, 5.5, 9.7> * llTan(85); 
        
        // rotate the main prim slowly using the same rotataion angle, rate, and gain...
        llSetPrimitiveParams([ PRIM_OMEGA, rotationAngle * 0.3, 1.0, 1.0 ]);
        
        // rotate the link satellite prim separately around its own axis 
        // it will rotate also around the main prim because the main prim is rotating.
        llSetLinkPrimitiveParams(2, [ PRIM_OMEGA, rotationAngle, 1.0, 1.0 ]);
    }
}`} lang="lsl" /></div>
