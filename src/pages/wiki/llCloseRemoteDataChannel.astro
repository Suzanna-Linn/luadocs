
---
import DocsLayout from '/src/layouts/DocsLayout.astro';
import DocsCode from '/src/components/DocsCode.astro';
---

<DocsLayout title="Lua & LSL Docs">
<div class="dashboard summary-function">
  <div class="dashboard-header">
    <span class="lua-section"><span class="tag lua-tag">Lua</span><DocsCode code={`ll.CloseRemoteDataChannel(ChannelID: uuid)`} lang="slua" /></span>
    <span class="lsl-section"><span class="tag lsl-tag">LSL</span><DocsCode code={`llCloseRemoteDataChannel(key ChannelID);`} lang="lsl" /></span>
  </div>

  <div class="dashboard-body">
    <div class="dash-col">
      <p class="deprecated-text"">Deprecated: </p>
      <p>  <p>Closes XML-RPC channel.</p>
</p>
      <table class="param-table" id="parameters">
        <tr>
          <td><span class="lua-section"><span class="tag lua-tag">Lua</span>uuid</span></td>
          <td><span class="lsl-section"><span class="tag lsl-tag">LSL</span>key</span></td>
          <td>ChannelID / <a href="https://wiki.secondlife.com/wiki/Category:LSL_Parameters/channel" target="_blank">channel</a></td>
          <td></td>
        </tr>
      </table>
    </div>

    <div class="dash-col">
      <div class="dash-section-title">Categories</div>
      <ul class="meta-list">
        <li>script_communication</li>
      </ul>
    </div>

    <div class="dash-col">
      <div class="dash-section-title">Tech Specs</div>
      <div class="tech-item"><span class="tech-label">Sleep</span><span class="tech-val">1s</span></div>
      <div class="tech-item"><span class="tech-label">Energy</span><span class="tech-val">10</span></div>
      <div class="tech-item"><span class="tech-label">LSO ID</span><span class="tech-val">257</span></div>

      <div class="label-stack">
        <span class="attr-label bg-deprecated">Deprecated</span>
      </div>
    </div>
  </div>
</div>
  <h2>Caveats</h2>
  <ul>
    <li>This function causes the script to sleep for 1.0 seconds.</li>
    <li>This function has been deprecated, please use <a href="https://wiki.secondlife.com/wiki/LSL_http_server" target="_blank">LSL_http_server</a> instead.</li>
  </ul>
  <h2>Deep Notes</h2>
  <table>
    <tbody>
      <tr>
        <th>Signature</th>
      </tr>
      <tr>
        <td><div class="lsl-block"><span class="tag lsl-tag">LSL</span><DocsCode code={`
function void llCloseRemoteDataChannel( key channel );
`} lang="lsl" /></div>

</td>
      </tr>
    </tbody>
  </table>

</DocsLayout>
      