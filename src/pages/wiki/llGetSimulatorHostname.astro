  <h2>Caveats</h2>
  <ul>
    <li>This function causes the script to sleep for 10.0 seconds.</li>
  </ul>
  <h2>Examples</h2>
<div class="lua-block"><span class="tag lua-tag">Lua</span><DocsCode code={`ll = llcompat

-- The beginnings of a region-info script.
local region = ""
local sim = ""

local function main()
    ll.SetTimerEvent(1.0)
end
function LLEvents.timer()
    local here = ll.GetRegionName()
    if region ~= here then
        sim = ll.GetSimulatorHostname()
        region = here
    end
    ll.SetText("   REGION NAME : " .. region .. "\n  SIM HOSTNAME : " .. sim .. "\nTIME DIALATION : " .. tostring(ll.GetRegionTimeDilation()) .. "\n    REGION FPS : " .. tostring(ll.GetRegionFPS()), vector(0, 1, 0), 1.0)
end

main()
`} lang="slua" /></div>
<div class="lsl-block"><span class="tag lsl-tag">LSL</span><DocsCode code={`// The beginnings of a region-info script.
string region;
string sim;

default
{
    state_entry()
    {
        llSetTimerEvent(1.0);
    }
    timer()
    {
        string here = llGetRegionName();
        if(region != here)
        {
            sim = llGetSimulatorHostname();
            region = here;
        }
        llSetText(
                "   REGION NAME : " + region + 
              "\n  SIM HOSTNAME : " + sim + 
              "\nTIME DIALATION : " + (string)llGetRegionTimeDilation() +
              "\n    REGION FPS : " + (string)llGetRegionFPS(),
            <0,1,0>, 1.0);
    }
}`} lang="lsl" /></div>
<div class="lua-block"><span class="tag lua-tag">Lua</span><DocsCode code={`-- llGetEnv now offers an equivalent function without the 10 second delay.
local function SaySimulatorHostname()
    ll.OwnerSay("Simulator Hostname: " .. ll.GetEnv("simulator_hostname"))
end

function LLEvents.on_rez(start_param)
    SaySimulatorHostname()
end

function LLEvents.changed(iChange)
    if bit32.btest(iChange, bit32.bor(CHANGED_REGION_START, CHANGED_REGION)) then
        SaySimulatorHostname()
    end
end

local function main()
    SaySimulatorHostname()
end

main()
`} lang="slua" /></div>
<div class="lsl-block"><span class="tag lsl-tag">LSL</span><DocsCode code={`// llGetEnv now offers an equivalent function without the 10 second delay.
SaySimulatorHostname()
{ 
    llOwnerSay("Simulator Hostname: " + llGetEnv("simulator_hostname") );
}
 
default
{
    on_rez(integer start_param)
    {
        SaySimulatorHostname();
    }
 
    changed(integer iChange)
    {
        if (iChange & (CHANGED_REGION_START|CHANGED_REGION))
            SaySimulatorHostname();
    }
 
    state_entry()
    {
        SaySimulatorHostname();
    }
}`} lang="lsl" /></div>
