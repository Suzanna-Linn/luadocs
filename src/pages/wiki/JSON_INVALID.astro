  <h2>Examples</h2>
<div class="lua-block"><span class="tag lua-tag">Lua</span><DocsCode code={`-- Using JSON_INVALID to iterate over a json array
-- of unknown length
local jsonText = "[1,2,3,5,6]"

function LLEvents.touch_start(events)
    local total_number = #events
    local item = ""
    local iter = 0
    while ((function() item = ll.JsonGetValue(jsonText, {(function() local tmp = iter iter += 1 return tmp end)()}) return item end)()) ~= JSON_INVALID do
        ll.OwnerSay(item)  -- "1","2","3","5","6"
    end
end
`} lang="slua" /></div>
<div class="lsl-block"><span class="tag lsl-tag">LSL</span><DocsCode code={`// Using JSON_INVALID to iterate over a json array
// of unknown length
string jsonText = "[1,2,3,5,6]";

default
{
    touch_start(integer total_number)
    {
        string item;
        integer iter;
        while ((item = llJsonGetValue(jsonText,[iter++])) != JSON_INVALID)
        {
            llOwnerSay(item); // "1","2","3","5","6"
        }
    }
}`} lang="lsl" /></div>
