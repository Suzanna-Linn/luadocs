  <h2>Examples</h2>
<div class="lua-block"><span class="tag lua-tag">Lua</span><DocsCode code={`-- UnSit on Sit, Using a sit target
local function main()
    ll.SitTarget(vector(0.0, 0.0, 0.1), ZERO_ROTATION)  -- Needed for llAvatarOnSitTarget to work. The vectors components must not all be set to 0.0
end
function LLEvents.changed(change)  -- Triggered when various changes are sensed.
    if bit32.btest(change, CHANGED_LINK) then  -- When an agent sits on an object they become a new link.
        local user = ll.AvatarOnSitTarget()  -- Store the UUID of any agent sitting on the sit target.
        if user.istruthy then  -- An avatar is on the sit target.
            ll.UnSit(user)  -- Un-Sit the avatar.
        end
    end
end

main()
`} lang="slua" /></div>
<div class="lsl-block"><span class="tag lsl-tag">LSL</span><DocsCode code={`// UnSit on Sit, Using a sit target
default
{
    state_entry()
    {
        llSitTarget(<0.0, 0.0, 0.1>, ZERO_ROTATION); // Needed for llAvatarOnSitTarget to work. The vectors components must not all be set to 0.0
    }
    changed(integer change) // Triggered when various changes are sensed.
    {
        if(change & CHANGED_LINK) // When an agent sits on an object they become a new link.
        {
            key user = llAvatarOnSitTarget(); // Store the UUID of any agent sitting on the sit target.
            if(user) // An avatar is on the sit target.
                llUnSit(user); // Un-Sit the avatar.
        }
    }
}`} lang="lsl" /></div>
<div class="lua-block"><span class="tag lua-tag">Lua</span><DocsCode code={`-- UnSit on Sit, NOT using a sit target

function LLEvents.changed(change)  -- Triggered when various changes are sensed.
    if bit32.btest(change, CHANGED_LINK) then  -- When an agent sits on an object they become a new link.
        local links = 0  -- Create an integer type variable.
        if ll.GetObjectPrimCount(ll.GetKey()) < ((function() links = ll.GetNumberOfPrims() return links end)()) then  -- During the check store the number of links.
            -- If the number of prims is fewer than the number of links, the last must be an avatar.
            ll.UnSit(ll.GetLinkKey(links))  -- Use the key of the last link to be added (the avatar) to call llUnSit().
        else
            ll.OwnerSay("Some kind of linking or unlinking has changed me but, I am not being sat on.")
        end
    -- llUnSit() triggers the changed event too (the number of links is reduced by 1).
    end
end
`} lang="slua" /></div>
<div class="lsl-block"><span class="tag lsl-tag">LSL</span><DocsCode code={`// UnSit on Sit, NOT using a sit target

default
{
    changed(integer change) // Triggered when various changes are sensed.
    {
        if(change & CHANGED_LINK) // When an agent sits on an object they become a new link.
        {
            integer links = 0; // Create an integer type variable.
            if(llGetObjectPrimCount(llGetKey()) < (links = llGetNumberOfPrims())) // During the check store the number of links.
            // If the number of prims is fewer than the number of links, the last must be an avatar.
                llUnSit(llGetLinkKey(links)); // Use the key of the last link to be added (the avatar) to call llUnSit().
            else
                llOwnerSay("Some kind of linking or unlinking has changed me but, I am not being sat on.");
            // llUnSit() triggers the changed event too (the number of links is reduced by 1).
        }
    }
}`} lang="lsl" /></div>
<div class="lua-block"><span class="tag lua-tag">Lua</span><DocsCode code={`local function unsit_all_avatars()
    local objectPrimCount = ll.GetObjectPrimCount(ll.GetKey())
    local currentLinkNumber = ll.GetNumberOfPrims()

    while objectPrimCount < currentLinkNumber do
        ll.UnSit(ll.GetLinkKey(currentLinkNumber))
        currentLinkNumber -= 1
    end
end

function LLEvents.touch_start(events)
    local num_detected = #events
    unsit_all_avatars()
end
`} lang="slua" /></div>
<div class="lsl-block"><span class="tag lsl-tag">LSL</span><DocsCode code={`unsit_all_avatars()
{
    integer objectPrimCount = llGetObjectPrimCount(llGetKey());
    integer currentLinkNumber = llGetNumberOfPrims();

    for (; objectPrimCount < currentLinkNumber; --currentLinkNumber)
        llUnSit(llGetLinkKey(currentLinkNumber));
}

default
{
    touch_start(integer num_detected)
    {
        unsit_all_avatars();
    }
}`} lang="lsl" /></div>
