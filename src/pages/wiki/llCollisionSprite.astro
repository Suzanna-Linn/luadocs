<div class="dashboard summary-function">
  <div class="dashboard-header">
    <span class="lua-section"><span class="tag lua-tag">Lua</span><DocsCode code={`ll.CollisionSprite(ImpactSprite: string|uuid)`} lang="slua" /></span>
    <span class="lsl-section"><span class="tag lsl-tag">LSL</span><DocsCode code={`llCollisionSprite(string ImpactSprite);`} lang="lsl" /></span>
