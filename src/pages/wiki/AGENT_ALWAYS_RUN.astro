  <h2>Examples</h2>
<div class="lua-block"><span class="tag lua-tag">Lua</span><DocsCode code={`-- This is a code fragment only
if bit32.btest(ll.GetAgentInfo(ll.GetOwner()), AGENT_ALWAYS_RUN) then
    ll.Say(0, "Give me a rest!")
end`} lang="slua" /></div>
<div class="lsl-block"><span class="tag lsl-tag">LSL</span><DocsCode code={`// This is a code fragment only
    if (llGetAgentInfo( llGetOwner() ) & AGENT_ALWAYS_RUN)    
        llSay(0, "Give me a rest!");`} lang="lsl" /></div>
