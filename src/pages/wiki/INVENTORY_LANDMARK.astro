  <h2>Examples</h2>
<div class="lua-block"><span class="tag lua-tag">Lua</span><DocsCode code={`ll = llcompat

--Give a landmark to anyone touching this object
function LLEvents.touch_start(events)
    local total_number = #events
    -- get the UUID of the person touching this object
    local user = ll.DetectedKey(0)
    -- Give them the first landmark found in the object's contents
    ll.GiveInventory(user, ll.GetInventoryName(INVENTORY_LANDMARK, 0))
end
`} lang="slua" /></div>
<div class="lsl-block"><span class="tag lsl-tag">LSL</span><DocsCode code={`//Give a landmark to anyone touching this object
default
{
    touch_start(integer total_number)
    {
        // get the UUID of the person touching this object
        key user = llDetectedKey(0);
        // Give them the first landmark found in the object's contents
        llGiveInventory(user, llGetInventoryName(INVENTORY_LANDMARK, 0) );
    }
}`} lang="lsl" /></div>
