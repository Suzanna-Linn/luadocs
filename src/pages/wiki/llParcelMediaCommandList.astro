        <td colspan="2"><a href="https://wiki.secondlife.com/wiki/PARCEL_MEDIA_COMMAND_STOP" target="_blank">PARCEL_MEDIA_COMMAND_STOP</a></td>
        <td></td>
        <td>Stop the media stream and go back to the first frame.</td>
      </tr>
      <tr>
        <td>1</td>
        <td colspan="2"><a href="https://wiki.secondlife.com/wiki/PARCEL_MEDIA_COMMAND_PAUSE" target="_blank">PARCEL_MEDIA_COMMAND_PAUSE</a></td>
        <td></td>
