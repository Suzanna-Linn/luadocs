
---
import DocsLayout from '/src/layouts/DocsLayout.astro';
import DocsCode from '/src/components/DocsCode.astro';
---

<DocsLayout title="Lua & LSL Docs">
<div class="dashboard summary-event">
  <div class="dashboard-header">
    <span class="lua-section"><span class="tag lua-tag">Lua</span><DocsCode code={`at_rot_target(TargetNumber: number, TargetRotation: rotation, CurrentRotation: rotation)`} lang="slua" /></span>
    <span class="lsl-section"><span class="tag lsl-tag">LSL</span><DocsCode code={`at_rot_target(integer TargetNumber, rotation TargetRotation, rotation CurrentRotation)`} lang="lsl" /></span>
  </div>

  <div class="dashboard-body">
    <div class="dash-col">
      <p>  <p>Result of <a href="https://wiki.secondlife.com/wiki/LlRotTarget" target="_blank">llRotTarget</a> library function call</p>
</p>
      <table class="param-table" id="parameters">
        <tr>
          <td><span class="lua-section"><span class="tag lua-tag">Lua</span>number</span></td>
          <td><span class="lsl-section"><span class="tag lsl-tag">LSL</span>integer</span></td>
          <td>TargetNumber / handle</td>
          <td><a href="https://wiki.secondlife.com/wiki/LlRotTarget" target="_blank">llRotTarget</a> return</td>
        </tr>
        <tr>
          <td><span class="lua-section"><span class="tag lua-tag">Lua</span>rotation</span></td>
          <td><span class="lsl-section"><span class="tag lsl-tag">LSL</span>rotation</span></td>
          <td>TargetRotation / targetrot</td>
          <td><a href="https://wiki.secondlife.com/wiki/LlRotTarget" target="_blank">llRotTarget</a> rot parameter</td>
        </tr>
        <tr>
          <td><span class="lua-section"><span class="tag lua-tag">Lua</span>rotation</span></td>
          <td><span class="lsl-section"><span class="tag lsl-tag">LSL</span>rotation</span></td>
          <td>CurrentRotation / ourrot</td>
          <td>current rotation (similar to <a href="https://wiki.secondlife.com/wiki/LlGetRot" target="_blank">llGetRot</a>)</td>
        </tr>
      </table>
    </div>

    <div class="dash-col">
    </div>

    <div class="dash-col">
      <div class="dash-section-title">Tech Specs</div>

      <div class="label-stack">
      </div>
    </div>
  </div>
</div>
