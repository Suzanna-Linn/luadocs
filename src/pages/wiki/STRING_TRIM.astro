
---
import DocsLayout from '/src/layouts/DocsLayout.astro';
import DocsCode from '/src/components/DocsCode.astro';
---

<DocsLayout title="Lua & LSL Docs">
<div class="dashboard summary-constant">
  <div class="dashboard-header">
    <span class="lua-section"><span class="tag lua-tag">Lua</span><DocsCode code={`STRING_TRIM: number = 3`} lang="slua" /></span>
    <span class="lsl-section"><span class="tag lsl-tag">LSL</span><DocsCode code={`integer STRING_TRIM = 3;`} lang="lsl" /></span>
  </div>

  <div class="dashboard-body">
    <div class="dash-col">
      <p>  <p>The integer constant STRING_TRIM has the value 0x03</p>
  <p>Trim spaces off the beginning and the end. Equal to</p>
</p>
    </div>

    <div class="dash-col">
      <div class="dash-section-title">Member Of</div>
      <ul class="meta-list">
        <li>StringTrimType</li>
      </ul>
    </div>

    <div class="dash-col">
      <div class="dash-section-title">Tech Specs</div>

      <div class="label-stack">
      </div>
    </div>
  </div>
</div>
<div class="lua-block"><span class="tag lua-tag">Lua</span><DocsCode code={`bit32.bor(STRING_TRIM_HEAD, STRING_TRIM_TAIL)`} lang="slua" /></div>
