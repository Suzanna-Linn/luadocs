    <tbody>
      <tr>
        <td>•</td>
        <td><a href="https://wiki.secondlife.com/wiki/LlGetTextureRot" target="_blank">llGetTextureRot</a></td>
        <td>–</td>
        <td>Gets the texture rotation</td>
        <td></td>
      </tr>
      <tr>
        <td>•</td>
        <td><a href="https://wiki.secondlife.com/wiki/LlSetTextureAnim" target="_blank">llSetTextureAnim</a></td>
        <td>–</td>
        <td>Animates the texture</td>
        <td></td>
      </tr>
    </tbody>
  </table>
  <h2>Deep Notes</h2>
  <table>
    <tbody>
      <tr>
        <th>Signature</th>
      </tr>
      <tr>
        <td><div class="lsl-block"><span class="tag lsl-tag">LSL</span><DocsCode code={`
function void llRotateTexture( float angle, integer face );
`} lang="lsl" /></div>

</td>
      </tr>
    </tbody>
  </table>

</DocsLayout>
      