  <h2>Caveats</h2>
  <ul>
    <li>This function causes the script to sleep for 0.2 seconds.</li>
  </ul>
  <h2>Examples</h2>
  <p>Drop this script into a <i>child</i> prim to rotate it in 1 degree increments on each <a href="https://wiki.secondlife.com/wiki/Touch" target="_blank">touch</a>.</p>
<div class="lua-block"><span class="tag lua-tag">Lua</span><DocsCode code={`local rot_xyzs = ZERO_ROTATION

local function main()
    local xyz_angles = vector(0, 1.0, 0)  -- This defines a 1 degree change on the Y axis
    local angles_in_radians = xyz_angles * DEG_TO_RAD  -- Change to radians
    rot_xyzs = ll.Euler2Rot(angles_in_radians)  -- Convert to a rotation
end

function LLEvents.touch_start(events)
    local s = #events
    ll.SetLocalRot(ll.GetLocalRot() * rot_xyzs)  -- Apply the increment rotation to the prim's current rotation ...

end

main()
`} lang="slua" /></div>
<div class="lsl-block"><span class="tag lsl-tag">LSL</span><DocsCode code={`rotation rot_xyzs;
 
default
{
    state_entry()
    {
        vector xyz_angles = <0,1.0,0>; // This defines a 1 degree change on the Y axis
        vector angles_in_radians = xyz_angles*DEG_TO_RAD; // Change to radians
        rot_xyzs = llEuler2Rot(angles_in_radians); // Convert to a rotation
    }
 
    touch_start(integer s)
    {
        llSetLocalRot(llGetLocalRot()*rot_xyzs); // Apply the increment rotation to the prim's current rotation ...
 
    }
}`} lang="lsl" /></div>
