<div class="lua-block"><span class="tag lua-tag">Lua</span><DocsCode code={`ll = llcompat

local function integer(s) return tonumber(string.match(s, "^%s*([-+]?%d+)")) or 0 end

-- Check for a valid existant notecard, and read it into a list
-- On touch, say the total number of lines, number of lines containing data, and say each line
-- Omei Qunhua  7-Jan-2013

local gNotecard = "Config"  -- Name of notecard to be examined
local gLineRequestID = NULL_KEY  -- Identity of expected line count dataserver event
local gReadRequestID = NULL_KEY  -- Identity of expected data read dataserver event
local gLineTotal = 0  -- The number of lines in the NC, as determined by this script
local gLineIndex = 0  -- Index for data read requests
local gDataLines = {}  -- List containing all data lines from notecard, excluding blank and comment lines
local gStatus = ""  -- Will contain EOF when notecard reading has finished

local function main()
    if ll.GetInventoryKey(gNotecard).istruthy then  -- Test if notecard exists and has been saved (returned key will be NULL_KEY otherwise)
        gLineRequestID = ll.GetNumberOfNotecardLines(gNotecard)  -- Kick off a request for the total number of lines that the notecard contains
    else
        ll.OwnerSay("Notecard '" .. gNotecard .. "' does not exist or has no saved data")
    end
end
function LLEvents.changed(change)
    if bit32.btest(change, CHANGED_INVENTORY) then
        ll.ResetScript()
    end
end
function LLEvents.dataserver(requested, data)
    if requested == gLineRequestID then
        gLineTotal = integer(data)  -- Cast the data string to an integer to get the number of lines
        gReadRequestID = ll.GetNotecardLine(gNotecard, gLineIndex)  -- Request a read of the first notecard line
        return
    end
    if requested ~= gReadRequestID then
        return
    end
    if ((function() gStatus = data return gStatus end)()) == EOF then  -- Save and test the current data (so that other code can tell when we've finished too)
        return
    end

    -- A notecard line has been read. Kick off the process of fetching the next line, while we process this line
    gReadRequestID = ll.GetNotecardLine(gNotecard, (function() gLineIndex += 1 return gLineIndex end)())

    data = ll.StringTrim(data, STRING_TRIM)  -- chop off any leading or trailing blanks
    if data == "" or ll.GetSubString(data, 0, 0) == "#" then
        return  -- ignore blank or comment lines
    end

    -- Do any further processing of the data here
    gDataLines = ll.ListInsertList(gDataLines, {data}, #gDataLines)  -- Add this data line to our global list
end
function LLEvents.touch_start(events)
    local total_number = #events
    if gStatus ~= EOF then
        ll.OwnerSay("Please wait")  -- Still reading the notecard
        return
    end
    local count = (#gDataLines)  -- Get list length (efficient shortcut)
    ll.OwnerSay(gNotecard .. " had a total of  " .. tostring(gLineTotal) .. " lines, of which " .. tostring(count) .. " contained data.")

    local x = 0
    while x < count do  -- Loop through the data list
        ll.OwnerSay(ll.List2String(gDataLines, x))
        x += 1
    end
    ll.OwnerSay("---- end of data ----")
end

main()
`} lang="slua" /></div>
<div class="lsl-block"><span class="tag lsl-tag">LSL</span><DocsCode code={`// Check for a valid existant notecard, and read it into a list
// On touch, say the total number of lines, number of lines containing data, and say each line
// Omei Qunhua  7-Jan-2013

string  gNotecard = "Config";       // Name of notecard to be examined
key     gLineRequestID;             // Identity of expected line count dataserver event
key     gReadRequestID;             // Identity of expected data read dataserver event
integer gLineTotal;                 // The number of lines in the NC, as determined by this script
integer gLineIndex;                 // Index for data read requests
list    gDataLines;                 // List containing all data lines from notecard, excluding blank and comment lines
string  gStatus;                    // Will contain EOF when notecard reading has finished

default
{
    state_entry()
    {
        if (llGetInventoryKey(gNotecard) )         // Test if notecard exists and has been saved (returned key will be NULL_KEY otherwise)
            gLineRequestID = llGetNumberOfNotecardLines(gNotecard);       // Kick off a request for the total number of lines that the notecard contains
        else
            llOwnerSay("Notecard '" + gNotecard + "' does not exist or has no saved data");
    }
    changed(integer change)
    {
        if (change & CHANGED_INVENTORY)
            llResetScript();
    }
    dataserver(key requested, string data)
    {
        if (requested == gLineRequestID)
        {
            gLineTotal = (integer) data;           // Cast the data string to an integer to get the number of lines
            gReadRequestID = llGetNotecardLine(gNotecard, gLineIndex);      // Request a read of the first notecard line
            return;
        }
        if (requested != gReadRequestID)
            return;
        if ( (gStatus = data) == EOF)              // Save and test the current data (so that other code can tell when we've finished too)
            return;

        // A notecard line has been read. Kick off the process of fetching the next line, while we process this line
        gReadRequestID = llGetNotecardLine(gNotecard, ++gLineIndex);

        data = llStringTrim(data, STRING_TRIM);    // chop off any leading or trailing blanks
        if (data == "" || llGetSubString(data, 0, 0) == "#")     
            return;                                // ignore blank or comment lines
        
        // Do any further processing of the data here
        gDataLines += data;                        // Add this data line to our global list
    }
    touch_start(integer total_number)
    {
        if (gStatus != EOF)
        {
            llOwnerSay("Please wait");             // Still reading the notecard
            return;
        }
        integer count = (gDataLines != [] );       // Get list length (efficient shortcut)
        llOwnerSay(gNotecard + " had a total of  " + (string) gLineTotal + " lines, of which " + (string) count + " contained data." );

        integer x;
        for ( ; x < count; ++x)                    // Loop through the data list
        {
            llOwnerSay( llList2String(gDataLines, x) );
        }
        llOwnerSay("---- end of data ----");
    }
}`} lang="lsl" /></div>
