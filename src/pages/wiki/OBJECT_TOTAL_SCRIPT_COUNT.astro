  <h2>Examples</h2>
<div class="lua-block"><span class="tag lua-tag">Lua</span><DocsCode code={`ll = llcompat

-- an example that demonstrates running scripts, total scripts, memory usage, and script time usage. 

function LLEvents.touch_start(events)
    local params = #events
    local toucher = ll.DetectedKey(0)

    local scriptInfo = ll.GetObjectDetails(toucher, {OBJECT_TOTAL_SCRIPT_COUNT, OBJECT_RUNNING_SCRIPT_COUNT, OBJECT_SCRIPT_TIME, OBJECT_SCRIPT_MEMORY})

    local displayMessage = ll.GetDisplayName(toucher) .. ", has " .. ll.List2String(scriptInfo, 1) .. " number of scripts running, with a total of " .. ll.List2String(scriptInfo, 0) .. " scripts.\nThese take up " .. tostring(ll.List2Integer(scriptInfo, 3) * 1024) .. " KiB of memory while using up " .. tostring(ll.List2Float(scriptInfo, 2) * 1000) .. "ms of script time."

    ll.SetPrimitiveParams({PRIM_TEXT, displayMessage, vector(0, 1, 1), 1.0})
end
`} lang="slua" /></div>
<div class="lsl-block"><span class="tag lsl-tag">LSL</span><DocsCode code={`// an example that demonstrates running scripts, total scripts, memory usage, and script time usage. 

default
{
    touch_start( integer params )
    {
        key toucher = llDetectedKey(0);
        
        list scriptInfo = llGetObjectDetails( toucher, [OBJECT_TOTAL_SCRIPT_COUNT, OBJECT_RUNNING_SCRIPT_COUNT, OBJECT_SCRIPT_TIME, OBJECT_SCRIPT_MEMORY]);

        string displayMessage = llGetDisplayName( toucher ) + ", has " + llList2String( scriptInfo, 1 ) + 
            " number of scripts running, with a total of " + llList2String( scriptInfo, 0 ) + 
            " scripts.\nThese take up " + (string)(llList2Integer( scriptInfo, 3 ) * 1024) +
            " KiB of memory while using up " + (string)(llList2Float( scriptInfo, 2 ) * 1000) +
            "ms of script time.";
            
        llSetPrimitiveParams([ PRIM_TEXT, displayMessage, <0, 1, 1>, 1.0 ]);
    }
}`} lang="lsl" /></div>
