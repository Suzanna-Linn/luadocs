
---
import DocsLayout from '/src/layouts/DocsLayout.astro';
import DocsCode from '/src/components/DocsCode.astro';
---

<DocsLayout title="Lua & LSL Docs">
<div class="dashboard summary-event">
  <div class="dashboard-header">
    <span class="lua-section"><span class="tag lua-tag">Lua</span><DocsCode code={`final_damage(Detected: {DetectedEvent})`} lang="slua" /></span>
    <span class="lsl-section"><span class="tag lsl-tag">LSL</span><DocsCode code={`final_damage(integer count)`} lang="lsl" /></span>
  </div>

  <div class="dashboard-body">
    <div class="dash-col">
      <p>  <p>This event is triggered after all <a href="https://wiki.secondlife.com/wiki/On_damage" target="_blank">on_damage</a> events in all scripts and attachments have processed and damage has been applied to the avatar or distributed to all seated avatars.</p>
  <p>All llDetected* functions that are normally available within a collision event are available while processing this event. Additionally the <a href="https://wiki.secondlife.com/wiki/LlDetectedDamage" target="_blank">llDetectedDamage</a> methods may be called while processing this event.</p>
</p>
      <table class="param-table" id="parameters">
        <tr>
          <td><span class="lua-section"><span class="tag lua-tag">Lua</span>number</span></td>
          <td><span class="lsl-section"><span class="tag lsl-tag">LSL</span>integer</span></td>
          <td><span class="lua-section"><span class="tag lua-tag">Lua</span>Detected / </span><span class="lsl-section"><span class="tag lsl-tag">LSL</span>count / num_detected</span></td>
          <td><span class="lua-section"><span class="tag lua-tag">Lua</span>Table with the detected events / </span><span class="lsl-section"><span class="tag lsl-tag">LSL</span>The number of damage events applied to the avatar or task.</span></td>
        </tr>
      </table>
    </div>

    <div class="dash-col">
    </div>

    <div class="dash-col">
      <div class="dash-section-title">Tech Specs</div>

      <div class="label-stack">
        <span class="attr-label bg-detected">Detected Event</span>
      </div>
    </div>
  </div>
</div>
  <h2>See Also</h2>
  <h3>Events</h3>
  <table>
    <tbody>
      <tr>
        <td>•</td>
        <td><a href="https://wiki.secondlife.com/wiki/On_death" target="_blank">on_death</a></td>
        <td></td>
        <td></td>
        <td></td>
      </tr>
      <tr>
        <td>•</td>
        <td><a href="https://wiki.secondlife.com/wiki/On_damage" target="_blank">on_damage</a></td>
        <td></td>
        <td></td>
        <td></td>
      </tr>
    </tbody>
  </table>
  <h3>Functions</h3>
  <table>
    <tbody>
      <tr>
        <td>•</td>
        <td><a href="https://wiki.secondlife.com/wiki/LlDetectedDamage" target="_blank">llDetectedDamage</a></td>
        <td></td>
        <td></td>
        <td></td>
      </tr>
    </tbody>
  </table>
  <h2>Deep Notes</h2>
  <table>
    <tbody>
      <tr>
        <th>Signature</th>
      </tr>
      <tr>
        <td><div class="lsl-block"><span class="tag lsl-tag">LSL</span><DocsCode code={`
event void final_damage( integer num_detected );
`} lang="lsl" /></div>

</td>
      </tr>
    </tbody>
  </table>

</DocsLayout>
      