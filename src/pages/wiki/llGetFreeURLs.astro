<DocsLayout title="Lua & LSL Docs">
<div class="dashboard summary-function">
  <div class="dashboard-header">
    <span class="lua-section"><span class="tag lua-tag">Lua</span><DocsCode code={`ll.GetFreeURLs(): number`} lang="slua" /></span>
    <span class="lsl-section"><span class="tag lsl-tag">LSL</span><DocsCode code={`integer llGetFreeURLs();`} lang="lsl" /></span>
  </div>

  <div class="dashboard-body">
    <div class="dash-col">
      <p>  <p>Returns an integer that is the number of available URLs. If attached, return the URLs remaining for the owner. Otherwise, return the available URLs for the region.</p>
</p>
    </div>

    <div class="dash-col">
      <div class="dash-section-title">Categories</div>
      <ul class="meta-list">
        <li>script</li>
        <li>web</li>
      </ul>
    </div>

    <div class="dash-col">
      <div class="dash-section-title">Tech Specs</div>
      <div class="tech-item"><span class="tech-label">Energy</span><span class="tech-val">10</span></div>
      <div class="tech-item"><span class="tech-label">LSO ID</span><span class="tech-val">344</span></div>

      <div class="label-stack">
        <span class="attr-label bg-mandatory">Use Return</span>
      </div>
    </div>
  </div>
</div>
  <h2>Specification</h2>
  <p>There is a separate URL limit for the region, and a limit for each agent. The URL limit is the same as the <a href="https://wiki.secondlife.com/wiki/Land_Impact" target="_blank">Land Impact</a> limit:</p>
  <ul>
    <li>Agent: 38</li>
    <li>Openspace Sim: 1,250</li>
    <li>Homestead Sim: 5,000</li>
    <li>Full Sim: 20,000</li>
    <li>Mainland Sim: 22,500</li>
    <li>30k Sim: 30,000</li>
  </ul>
  <h2>Caveats</h2>
  <ul>
    <li>If called from an attachment, there is no way to get the number of free URLs in the region; it will always return the URL count remaining for the agent.</li>
  </ul>
  <h2>Examples</h2>
  <p>This script will say the number of currently available HTTP-In URLs left in the region.</p>
<div class="lua-block"><span class="tag lua-tag">Lua</span><DocsCode code={`function LLEvents.touch_start(events)
    local num_detected = #events
    local numberOfFreeURLs = ll.GetFreeURLs()

    if numberOfFreeURLs ~= 0 then
        ll.Say(0, "There are " .. tostring(numberOfFreeURLs) .. " available HTTP-In URLs left in this region.")
    else
        ll.Say(0, "WARNING: There are no HTTP-In URLs available anymore.")
    end
end
`} lang="slua" /></div>
<div class="lsl-block"><span class="tag lsl-tag">LSL</span><DocsCode code={`default
{
    touch_start(integer num_detected)
    {
        integer numberOfFreeURLs = llGetFreeURLs();

        if (numberOfFreeURLs)
        {
            llSay(0, "There are " + (string)numberOfFreeURLs + " available HTTP-In URLs left in this region.");
        }
        else
        {
            llSay(0, "WARNING: There are no HTTP-In URLs available anymore.");
        }
    }
}`} lang="lsl" /></div>
<div class="lua-block"><span class="tag lua-tag">Lua</span><DocsCode code={`-- WARNING:
--
--      This script is only for proof-of-concept (demo purposes).
--      DO NOT use it if you don't have the sim owners and/or
--      estate managers OK to test this script.
--      This script can possibly block HTTP communication from and to the sim.
--      ...bringing down all networked vendors and/or similar machines.
--
--      This script allocates all available URLs.
--      Deleting the script and/or derezzing the object containing the script,
--      will release all previously taken URLs.

local function main()
    ll.RequestURL()
end

function LLEvents.http_request(request_id, method, body)
    if method == URL_REQUEST_DENIED then
        ll.SetText("No free URLs!", vector(1.0, 0.0, 0.0), 1.0)
    elseif method == URL_REQUEST_GRANTED then
        ll.SetText(tostring(ll.GetFreeURLs()) .. " URLs left\n" .. body, vector(1.0, 1.0, 1.0), 1.0)
        ll.RequestURL()
    elseif method == "GET" then
        ll.HTTPResponse(id, 200, "Hello there!")
    end
end

main()
`} lang="slua" /></div>
<div class="lsl-block"><span class="tag lsl-tag">LSL</span><DocsCode code={`// WARNING:
//
//      This script is only for proof-of-concept (demo purposes).
//      DO NOT use it if you don't have the sim owners and/or
//      estate managers OK to test this script.
//      This script can possibly block HTTP communication from and to the sim.
//      ...bringing down all networked vendors and/or similar machines.
//
//      This script allocates all available URLs.
//      Deleting the script and/or derezzing the object containing the script,
//      will release all previously taken URLs.
 
default
{
    state_entry()
    {
        llRequestURL();
    }
 
    http_request(key request_id, string method, string body)
    {
        if (method == URL_REQUEST_DENIED)
        {
            llSetText("No free URLs!", <1.0, 0.0, 0.0>, 1.0);
        }
        else if (method == URL_REQUEST_GRANTED)
        {
            llSetText((string)llGetFreeURLs() + " URLs left\n" + body, <1.0, 1.0, 1.0>, 1.0);
            llRequestURL();
        }
        else if (method == "GET")
        {
            llHTTPResponse(id, 200, "Hello there!");
        }
    }
}`} lang="lsl" /></div>
  <h2>Notes</h2>
  <p>URLs are a finite region resource and should be released when no longer needed.</p>
