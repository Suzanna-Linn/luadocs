        <td><div class="lsl-block"><span class="tag lsl-tag">LSL</span><DocsCode code={`
function rotation llAxes2Rot( vector fwd, vector left, vector up );
`} lang="lsl" /></div>

</td>
      </tr>
    </tbody>
  </table>
  <table>
