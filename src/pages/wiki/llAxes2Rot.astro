    <tbody>
      <tr>
        <td>•</td>
        <td><a href="https://wiki.secondlife.com/wiki/User:Dora_Gustafson/llAxes2Rot_right_and_wrong" target="_blank">Visual illustration</a></td>
        <td>–</td>
        <td>Importance of mutually orthogonal unit vectors</td>
        <td></td>
      </tr>
    </tbody>
  </table>
  <table>
    <tbody>
      <tr>
        <th>Signature</th>
      </tr>
