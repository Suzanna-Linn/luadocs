
---
import DocsLayout from '/src/layouts/DocsLayout.astro';
import DocsCode from '/src/components/DocsCode.astro';
---

<DocsLayout title="Lua & LSL Docs">
<div class="dashboard summary-function">
  <div class="dashboard-header">
    <span class="lua-section"><span class="tag lua-tag">Lua</span><DocsCode code={`ll.SetPrimURL(URL: string)`} lang="slua" /></span>
    <span class="lsl-section"><span class="tag lsl-tag">LSL</span><DocsCode code={`llSetPrimURL(string URL);`} lang="lsl" /></span>
  </div>

  <div class="dashboard-body">
    <div class="dash-col">
      <p class="deprecated-text"">Deprecated:  use ll.SetPrimMediaParams</p>
      <p>  <p>Updates the URL for the web page shown on the sides of the object.</p>
</p>
      <table class="param-table" id="parameters">
        <tr>
          <td><span class="lua-section"><span class="tag lua-tag">Lua</span>string</span></td>
          <td><span class="lsl-section"><span class="tag lsl-tag">LSL</span>string</span></td>
          <td>URL / url</td>
          <td></td>
        </tr>
      </table>
    </div>

    <div class="dash-col">
      <div class="dash-section-title">Categories</div>
      <ul class="meta-list">
        <li>media</li>
        <li>prim</li>
        <li>prim_media</li>
        <li>web</li>
      </ul>
    </div>

    <div class="dash-col">
      <div class="dash-section-title">Tech Specs</div>
      <div class="tech-item"><span class="tech-label">Sleep</span><span class="tech-val">20s</span></div>
      <div class="tech-item"><span class="tech-label">Energy</span><span class="tech-val">10</span></div>
      <div class="tech-item"><span class="tech-label">LSO ID</span><span class="tech-val">305</span></div>

      <div class="label-stack">
        <span class="attr-label bg-deprecated">Deprecated</span>
      </div>
    </div>
  </div>
</div>
  <h2>Caveats</h2>
  <ul>
    <li>This function causes the script to sleep for 20.0 seconds.</li>
    <li>This function has been deprecated, please use <a href="https://wiki.secondlife.com/wiki/LlSetPrimMediaParams" target="_blank">LlSetPrimMediaParams</a> instead.</li>
  </ul>
  <h2>Deep Notes</h2>
  <p>History</p>
  <ul>
    <li><a href="http://svn.secondlife.com/trac/linden/changeset/960?new_path=%2F#file43" target="_blank">SVN:960 r93583 Branch:Release&#32;s:1.23.4.93096&#32;Saturday, 02 August 2008</a> - Delay changed from 2.0 seconds to 20.0 seconds.</li>
  </ul>
  <table>
    <tbody>
      <tr>
        <th>Signature</th>
      </tr>
      <tr>
        <td><div class="lsl-block"><span class="tag lsl-tag">LSL</span><DocsCode code={`
function void llSetPrimURL( string url );
`} lang="lsl" /></div>

</td>
      </tr>
    </tbody>
  </table>

</DocsLayout>
      