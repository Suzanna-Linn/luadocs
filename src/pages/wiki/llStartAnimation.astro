  <p>To run this function the script must request the <a href="https://wiki.secondlife.com/wiki/PERMISSION_TRIGGER_ANIMATION" target="_blank">PERMISSION_TRIGGER_ANIMATION</a> permission with <a href="https://wiki.secondlife.com/wiki/LlRequestPermissions" target="_blank">llRequestPermissions</a>.</p>
  <h2>Caveats</h2>
  <table>
    <tbody>
      <tr>
        <th>Permissions</th>
      </tr>
      <tr>
        <td>Do not depend upon the auto-grant status of permissions. <b>Always</b> use the <a href="https://wiki.secondlife.com/wiki/Run_time_permissions" target="_blank">run_time_permissions</a> event.
If the script lacks the permission <a href="https://wiki.secondlife.com/wiki/PERMISSION_TRIGGER_ANIMATION" target="_blank">PERMISSION_TRIGGER_ANIMATION</a>, the script will shout an error on <a href="https://wiki.secondlife.com/wiki/DEBUG_CHANNEL" target="_blank">DEBUG_CHANNEL</a> and the operation fails (but the script continues to run).
Once the <a href="https://wiki.secondlife.com/wiki/PERMISSION_TRIGGER_ANIMATION" target="_blank">PERMISSION_TRIGGER_ANIMATION</a> permission is granted there may be no way to revoke it except from inside the script (for example, with a new <a href="https://wiki.secondlife.com/wiki/LlRequestPermissions" target="_blank">llRequestPermissions</a> call) or if the script is reset.
<i>For Viewer 3.6.7 and up:</i> If the object is <i>not</i> attached to the permission granter but <i>is</i> in the same region, then <b>Me>Movement>Stop Animating Me</b> will revoke both <a href="https://wiki.secondlife.com/wiki/PERMISSION_TRIGGER_ANIMATION" target="_blank">PERMISSION_TRIGGER_ANIMATION</a> and <a href="https://wiki.secondlife.com/wiki/PERMISSION_OVERRIDE_ANIMATIONS" target="_blank">PERMISSION_OVERRIDE_ANIMATIONS</a> (other permissions will remain).</td>
      </tr>
    </tbody>
  </table>
  <ul>
    <li>If <b>anim</b> is missing from the prim's inventory then an error is shouted on <a href="https://wiki.secondlife.com/wiki/DEBUG_CHANNEL" target="_blank">DEBUG_CHANNEL</a>.</li>
    <li>Only 30 animations can be played at a time. (Prior to 1.25.4 the limit was 15 and prior to 1.25.3 there was no limit at all.)</li>
  </ul>
  <h2>Examples</h2>
<div class="lua-block"><span class="tag lua-tag">Lua</span><DocsCode code={`ll = llcompat

function LLEvents.touch_start(events)
    local detected = #events
    ll.RequestPermissions(ll.DetectedKey(0), PERMISSION_TRIGGER_ANIMATION)
end
function LLEvents.run_time_permissions(perm)
    if bit32.btest(perm, PERMISSION_TRIGGER_ANIMATION) then
        ll.StartAnimation("sit")
        ll.OwnerSay("animation will end in 5 seconds")
        ll.SetTimerEvent(5.0)
    end
end
function LLEvents.timer()
    ll.SetTimerEvent(0.0)
    ll.StopAnimation("sit")
end
`} lang="slua" /></div>
<div class="lsl-block"><span class="tag lsl-tag">LSL</span><DocsCode code={`default
{
    touch_start(integer detected)
    {
        llRequestPermissions(llDetectedKey(0), PERMISSION_TRIGGER_ANIMATION);
    }
    run_time_permissions(integer perm)
    {
        if (perm & PERMISSION_TRIGGER_ANIMATION)
        {
            llStartAnimation("sit");
            llOwnerSay("animation will end in 5 seconds");
            llSetTimerEvent(5.0);
        }
    }
    timer()
    {
        llSetTimerEvent(0.0);
        llStopAnimation("sit");
    }
}`} lang="lsl" /></div>
  <p>Add an animation or pose inside the same object as this script:</p>
<div class="lua-block"><span class="tag lua-tag">Lua</span><DocsCode code={`ll = llcompat

local animation = ""  -- the first animation in inventory will automatically be used
-- the animation name must be stored globally to be able to stop the animation when standing up

local function main()
    -- set sit target, otherwise this will not work 
    ll.SitTarget(vector(0.0, 0.0, 0.1), ZERO_ROTATION)
end

function LLEvents.changed(change)
    if bit32.btest(change, CHANGED_LINK) then
        local av = ll.AvatarOnSitTarget()
        if av.istruthy then  --evaluated as true if not NULL_KEY or invalid
            ll.RequestPermissions(av, PERMISSION_TRIGGER_ANIMATION)
        else  -- avatar is standing up
            if animation ~= "" then
                ll.StopAnimation(animation)  -- stop the started animation
            end
            ll.ResetScript()  -- release the avatar animation permissions
        end
    end
end

function LLEvents.run_time_permissions(perm)
    if bit32.btest(perm, PERMISSION_TRIGGER_ANIMATION) then
        animation = ll.GetInventoryName(INVENTORY_ANIMATION, 0)  -- get the first animation from inventory
        if animation ~= "" then
            ll.StopAnimation("sit")  -- stop the default sit animation
            ll.StartAnimation(animation)
        end
    end
end

main()
`} lang="slua" /></div>
<div class="lsl-block"><span class="tag lsl-tag">LSL</span><DocsCode code={`string animation; // the first animation in inventory will automatically be used
  // the animation name must be stored globally to be able to stop the animation when standing up

default
{
    state_entry()
    {
        // set sit target, otherwise this will not work 
        llSitTarget(<0.0, 0.0, 0.1>, ZERO_ROTATION);
    }
 
    changed(integer change)
    {
        if (change & CHANGED_LINK)
        {
            key av = llAvatarOnSitTarget();
            if (av) //evaluated as true if not NULL_KEY or invalid
                llRequestPermissions(av, PERMISSION_TRIGGER_ANIMATION);
            else // avatar is standing up
            {
                if (animation)
                    llStopAnimation(animation); // stop the started animation
                llResetScript(); // release the avatar animation permissions
            }
        }
    }
    
    run_time_permissions(integer perm)
    {
        if (perm & PERMISSION_TRIGGER_ANIMATION)
        {
            animation = llGetInventoryName(INVENTORY_ANIMATION,0); // get the first animation from inventory
            if (animation)
            {
                llStopAnimation("sit"); // stop the default sit animation
                llStartAnimation(animation);
            }
        }
    }
}`} lang="lsl" /></div>
  <p>Common script to play some kind of a "holding animation" while an object is attached to an avatar:</p>
<div class="lua-block"><span class="tag lua-tag">Lua</span><DocsCode code={`local animation_name = "hold"

-- Whenever this object is attached or detached...
function LLEvents.attach(id)
    if id.istruthy then
        -- If it was just attached, request permission to animate.
        ll.RequestPermissions(ll.GetOwner(), PERMISSION_TRIGGER_ANIMATION)
    else
        -- It's being detached...
        if bit32.btest(ll.GetPermissions(), PERMISSION_TRIGGER_ANIMATION) then
            -- If we have permission to animate, stop the animation.
            ll.StopAnimation(animation_name)
        end
    end
end

-- Whenever permissions change...
function LLEvents.run_time_permissions(permissions)
    if bit32.btest(permissions, PERMISSION_TRIGGER_ANIMATION) then
        -- If permission to animate was granted, start the animation.
        ll.StartAnimation(animation_name)
    end
end
`} lang="slua" /></div>
<div class="lsl-block"><span class="tag lsl-tag">LSL</span><DocsCode code={`string animation_name = "hold";

default
{
    // Whenever this object is attached or detached...
    attach(key id)
    {
        if (id)
        {   // If it was just attached, request permission to animate.
            llRequestPermissions(llGetOwner(), PERMISSION_TRIGGER_ANIMATION);
        }
        else
        {   // It's being detached...
            if (llGetPermissions() & PERMISSION_TRIGGER_ANIMATION)
            {   // If we have permission to animate, stop the animation.
                llStopAnimation(animation_name);
            }
        }
    }

    // Whenever permissions change...
    run_time_permissions(integer permissions)
    {
        if (permissions & PERMISSION_TRIGGER_ANIMATION)
        {   // If permission to animate was granted, start the animation.
            llStartAnimation(animation_name);
        }
    }
}`} lang="lsl" /></div>
