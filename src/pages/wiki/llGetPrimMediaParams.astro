  <h2>Caveats</h2>
  <ul>
    <li>This function causes the script to sleep for 1.0 seconds.</li>
    <li>If <b>face</b> indicates a face that does not exist the return is an empty list.</li>
  </ul>
  <h2>Useful Snippets</h2>
<div class="lua-block"><span class="tag lua-tag">Lua</span><DocsCode code={`ll = llcompat

local function GetPrimMediaParams(face, input)
    --Returns a list that can be fed to llSetLinkMedia or llSetPrimMediaParams
    local output = {}
    local c = bit32.bnot(#input)
    while ((function() c = -bit32.bnot(c) return c end)()) ~= 0 do
        local flag = ll.List2List(input, c, c)
        output = ll.ListInsertList(output, ll.ListInsertList(flag, ll.GetLinkMedia(LINK_THIS, face, flag), #flag), #output)
    end
    if #output == #input then
        return {}
    end
    return output
end
`} lang="slua" /></div>
<div class="lsl-block"><span class="tag lsl-tag">LSL</span><DocsCode code={`list GetPrimMediaParams(integer face, list input)
{//Returns a list that can be fed to llSetLinkMedia or llSetPrimMediaParams
    list output;
    integer c = ~llGetListLength(input);
    while((c = - ~c))
    {
        list flag = llList2List(input, c, c);
        output += flag + llGetLinkMedia(LINK_THIS, face, flag);
    }
    if(output == input)
        return [];
    return output;
}`} lang="lsl" /></div>
