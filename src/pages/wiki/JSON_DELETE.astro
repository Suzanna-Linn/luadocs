  <h2>Examples</h2>
<div class="lua-block"><span class="tag lua-tag">Lua</span><DocsCode code={`function LLEvents.touch_start(events)
    local num_detected = #events
    local jsonString = "[1,2,3,4,5]"

    ll.Say(PUBLIC_CHANNEL, "Original: " .. jsonString)

    --  we remove the first item (list has zero-based index!)
    jsonString = ll.JsonSetValue(jsonString, {0}, JSON_DELETE)

    --  "[2,3,4,5]"
    ll.Say(PUBLIC_CHANNEL, "Modified: " .. jsonString)
end
`} lang="slua" /></div>
<div class="lsl-block"><span class="tag lsl-tag">LSL</span><DocsCode code={`default
{
    touch_start(integer num_detected)
    {
        string jsonString = "[1,2,3,4,5]";

        llSay(PUBLIC_CHANNEL, "Original: " + jsonString);

    //  we remove the first item (list has zero-based index!)
        jsonString = llJsonSetValue(jsonString, [0], JSON_DELETE);

    //  "[2,3,4,5]"
        llSay(PUBLIC_CHANNEL, "Modified: " + jsonString);
    }
}`} lang="lsl" /></div>
