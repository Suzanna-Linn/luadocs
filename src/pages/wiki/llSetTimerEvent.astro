<div class="lua-block"><span class="tag lua-tag">Lua</span><DocsCode code={`ll = llcompat

-- The timer event will never fire.
local function main()
    ll.SetTimerEvent(5.0)
    -- Sensor every 2.5 seconds
    ll.SensorRepeat("", NULL_KEY, false, 0.0, 0.0, 2.5)
end

function LLEvents.no_sensor()
    ll.SetTimerEvent(5.0)
end

function LLEvents.timer()
    ll.Say(0, "I will never happen.")
    ll.Say(0, "Well, unless llSensorRepeat() magically finds something," .. "or maybe there's 2.5+ seconds of lag and the timer()" .. "event queues.")
end

main()
`} lang="slua" /></div>
<div class="lsl-block"><span class="tag lsl-tag">LSL</span><DocsCode code={`// The timer event will never fire.
default
{
    state_entry()
    {
        llSetTimerEvent(5.0);
        // Sensor every 2.5 seconds
        llSensorRepeat("", NULL_KEY, FALSE, 0.0, 0.0, 2.5);
    }

    no_sensor()
    {
        llSetTimerEvent(5.0);
    }
    
    timer()
    {
        llSay(0, "I will never happen.");
        llSay(0, "Well, unless llSensorRepeat() magically finds something,"+
                    "or maybe there's 2.5+ seconds of lag and the timer()"+
                    "event queues.");
    }
}`} lang="lsl" /></div>
<div class="lua-block"><span class="tag lua-tag">Lua</span><DocsCode code={`ll = llcompat

-- Using a timer to simulate multiple timers
local counter_a = 0
local counter_b = 0

local function main()
    --Starting Timer Event
    ll.SetTimerEvent(1.0)
end

function LLEvents.timer()
    --Increment counters
    counter_a += 1
    counter_b += 1

    if counter_a >= 100 then
        --Resetting Counter A
        counter_a = 0
        ll.OwnerSay("Counter a has reached 100")
    end

    if counter_b >= 200 then
        --Resetting counter B
        counter_b = 0
        ll.OwnerSay("Counter b has reached 200")
    end

end

main()
`} lang="slua" /></div>
<div class="lsl-block"><span class="tag lsl-tag">LSL</span><DocsCode code={`// Using a timer to simulate multiple timers
integer counter_a = 0;
integer counter_b = 0;

default
{
    state_entry()
    {
        //Starting Timer Event
        llSetTimerEvent(1.0);
    }

    timer()
    {
        //Increment counters
        counter_a++;
        counter_b++;

        if(counter_a >= 100)
        {
            //Resetting Counter A
            counter_a = 0;
            llOwnerSay("Counter a has reached 100");
        }

        if(counter_b >= 200)
        {
            //Resetting counter B
            counter_b = 0;
            llOwnerSay("Counter b has reached 200");
        }

    }
}`} lang="lsl" /></div>
