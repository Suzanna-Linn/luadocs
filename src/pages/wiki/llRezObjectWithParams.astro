
---
import DocsLayout from '/src/layouts/DocsLayout.astro';
import DocsCode from '/src/components/DocsCode.astro';
---

<DocsLayout title="Lua & LSL Docs">
<div class="dashboard summary-function">
  <div class="dashboard-header">
    <span class="lua-section"><span class="tag lua-tag">Lua</span><DocsCode code={`ll.RezObjectWithParams(InventoryItem: string, Params: {any}): uuid`} lang="slua" /></span>
    <span class="lsl-section"><span class="tag lsl-tag">LSL</span><DocsCode code={`key llRezObjectWithParams(string InventoryItem, list Params);`} lang="lsl" /></span>
  </div>

  <div class="dashboard-body">
    <div class="dash-col">
      <p>Instantiate owner's InventoryItem with the given parameters.</p>
      <table class="param-table" id="parameters">
        <tr>
          <td><span class="lua-section"><span class="tag lua-tag">Lua</span>string</span></td>
          <td><span class="lsl-section"><span class="tag lsl-tag">LSL</span>string</span></td>
          <td>InventoryItem</td>
          <td></td>
        </tr>
        <tr>
          <td><span class="lua-section"><span class="tag lua-tag">Lua</span>{`{any}`}</span></td>
          <td><span class="lsl-section"><span class="tag lsl-tag">LSL</span>list</span></td>
          <td>Params</td>
          <td></td>
        </tr>
      </table>
    </div>

    <div class="dash-col">
      <div class="dash-section-title">Categories</div>
      <ul class="meta-list">
        <li>combat</li>
        <li>prim_inventory</li>
        <li>rez</li>
      </ul>
    </div>

    <div class="dash-col">
      <div class="dash-section-title">Tech Specs</div>
      <div class="tech-item"><span class="tech-label">Sleep</span><span class="tech-val">0.1s</span></div>
      <div class="tech-item"><span class="tech-label">Energy</span><span class="tech-val">200</span></div>
      <div class="tech-item"><span class="tech-label">LSO ID</span><span class="tech-val">544</span></div>

      <div class="label-stack">
      </div>
    </div>
  </div>
</div>

</DocsLayout>
      