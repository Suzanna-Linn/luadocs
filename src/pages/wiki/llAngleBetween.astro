    local currentRootRotation = ll.GetRootRotation()
    local angle = ll.AngleBetween(ZERO_ROTATION, currentRootRotation)

    -- PUBLIC_CHANNEL has the integer value 0
    ll.Say(PUBLIC_CHANNEL, "llAngleBetween(ZERO_ROTATION, " .. tostring(currentRootRotation) .. ") = " .. tostring(angle))
end
`} lang="slua" /></div>
