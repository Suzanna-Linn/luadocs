  <h2>Deep Notes</h2>
  <h3>Reference</h3>
<div class="lua-block"><span class="tag lua-tag">Lua</span><DocsCode code={`local function AngleBetween(a, b)  --simple but turns out to not be very accurate.
    return 2.0 * ll.Acos(ll.Fabs(a.x * b.x + a.y * b.y + a.z * b.z + a.s * b.s) / ll.Sqrt((a.x * a.x + a.y * a.y + a.z * a.z + a.s * a.s) * (b.x * b.x + b.y * b.y + b.z * b.z + b.s * b.s)))
end
`} lang="slua" /></div>
<div class="lsl-block"><span class="tag lsl-tag">LSL</span><DocsCode code={`float AngleBetween(rotation a, rotation b)//simple but turns out to not be very accurate.
{
    return 2.0 * llAcos( llFabs(a.x * b.x + a.y * b.y + a.z * b.z + a.s * b.s)
                      / llSqrt((a.x * a.x + a.y * a.y + a.z * a.z + a.s * a.s)
                             * (b.x * b.x + b.y * b.y + b.z * b.z + b.s * b.s)));
}`} lang="lsl" /></div>
<div class="lua-block"><span class="tag lua-tag">Lua</span><DocsCode code={`local function AngleBetween(a, b)  --more complex implementation but more accurate, and reasonably fast.
    local r = b / a  -- calculate the rotation between the two arguments as quaternion
    local s2 = r.s * r.s  -- square of the s-element
    local v2 = r.x * r.x + r.y * r.y + r.z * r.z  -- sum of the squares of the v-elements

    if s2 < v2 then  -- compare the s-component to the v-component
        return 2.0 * ll.Acos(ll.Sqrt(s2 / (s2 + v2)))  -- use arccos if the v-component is dominant
    end
    if v2 ~= 0 then  -- make sure the v-component is non-zero
        return 2.0 * ll.Asin(ll.Sqrt(v2 / (s2 + v2)))  -- use arcsin if the s-component is dominant
    end

    return 0.0  -- one or both arguments are scaled too small to be meaningful, or the values are the same, so return zero
end  --Written by Moon Metty & Miranda Umino. Minor optimizations by Strife Onizuka
`} lang="slua" /></div>
<div class="lsl-block"><span class="tag lsl-tag">LSL</span><DocsCode code={`float AngleBetween(rotation a, rotation b)//more complex implementation but more accurate, and reasonably fast.
{
    rotation r = b / a; // calculate the rotation between the two arguments as quaternion
    float s2 = r.s * r.s; // square of the s-element
    float v2 = r.x * r.x + r.y * r.y + r.z * r.z; // sum of the squares of the v-elements

    if (s2 < v2) // compare the s-component to the v-component
        return 2.0 * llAcos(llSqrt(s2 / (s2 + v2))); // use arccos if the v-component is dominant
    if (v2) // make sure the v-component is non-zero
        return 2.0 * llAsin(llSqrt(v2 / (s2 + v2))); // use arcsin if the s-component is dominant

    return 0.0; // one or both arguments are scaled too small to be meaningful, or the values are the same, so return zero
}//Written by Moon Metty & Miranda Umino. Minor optimizations by Strife Onizuka`} lang="lsl" /></div>
