  <h2>Examples</h2>
<div class="lua-block"><span class="tag lua-tag">Lua</span><DocsCode code={`--Changing the prim size and rotation
function LLEvents.touch_start(events)
    local total_number = #events
    ll.SetPrimitiveParams({PRIM_SIZE, vector(0.25, 0.5, 1.0), PRIM_ROTATION, rotation(1.0, 0.0, 0.0, 0.0)})
end
`} lang="slua" /></div>
<div class="lsl-block"><span class="tag lsl-tag">LSL</span><DocsCode code={`//Changing the prim size and rotation
default
{
  touch_start(integer total_number)
  {
    llSetPrimitiveParams([
        PRIM_SIZE, <0.25,0.5,1.0>,
        PRIM_ROTATION, <1.0, 0.0, 0.0, 0.0>
      ]);
  }
}`} lang="lsl" /></div>
