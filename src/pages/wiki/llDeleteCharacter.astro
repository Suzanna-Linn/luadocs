
---
import DocsLayout from '/src/layouts/DocsLayout.astro';
import DocsCode from '/src/components/DocsCode.astro';
---

<DocsLayout title="Lua & LSL Docs">
<div class="dashboard summary-function">
  <div class="dashboard-header">
    <span class="lua-section"><span class="tag lua-tag">Lua</span><DocsCode code={`ll.DeleteCharacter()`} lang="slua" /></span>
    <span class="lsl-section"><span class="tag lsl-tag">LSL</span><DocsCode code={`llDeleteCharacter();`} lang="lsl" /></span>
  </div>

  <div class="dashboard-body">
    <div class="dash-col">
      <p>  <p>Convert the object back to a standard object, removing all pathfinding properties.</p>
</p>
    </div>

    <div class="dash-col">
      <div class="dash-section-title">Categories</div>
      <ul class="meta-list">
        <li>pathfinding</li>
      </ul>
    </div>

    <div class="dash-col">
      <div class="dash-section-title">Tech Specs</div>
      <div class="tech-item"><span class="tech-label">Energy</span><span class="tech-val">10</span></div>
      <div class="tech-item"><span class="tech-label">LSO ID</span><span class="tech-val">405</span></div>

      <div class="label-stack">
      </div>
    </div>
  </div>
</div>
  <h2>Examples</h2>
<div class="lua-block"><span class="tag lua-tag">Lua</span><DocsCode code={`local function create_character()
    --  Clear any previous character behaviors
    ll.DeleteCharacter()

    --  default speed is 20
    ll.CreateCharacter({CHARACTER_DESIRED_SPEED, 10.0})
    ll.WanderWithin(ll.GetPos(), vector(10.0, 10.0, 2.0), {})
end

function LLEvents.on_rez(start_param)
    ll.ResetScript()
end

local function main()
    create_character()
end

function LLEvents.touch_start(events)
    local num_detected = #events
    --  Clear any previous character behaviors
    ll.DeleteCharacter()
end

main()
`} lang="slua" /></div>
<div class="lsl-block"><span class="tag lsl-tag">LSL</span><DocsCode code={`create_character()
{
//  Clear any previous character behaviors
    llDeleteCharacter();

//  default speed is 20
    llCreateCharacter([CHARACTER_DESIRED_SPEED, 10.0]);
    llWanderWithin(llGetPos(), <10.0, 10.0, 2.0>, []);
}

default
{
    on_rez(integer start_param)
    {
        llResetScript();
    }

    state_entry()
    {
        create_character();
    }
 
    touch_start(integer num_detected)
    {
    //  Clear any previous character behaviors
        llDeleteCharacter();
    }
}`} lang="lsl" /></div>
