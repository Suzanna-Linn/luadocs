  <h3>Reference Implementation</h3>
<div class="lua-block"><span class="tag lua-tag">Lua</span><DocsCode code={`local function uRot2Euler(rot)
    local ret = ZERO_VECTOR
    local temp = ZERO_VECTOR

    --x-axis
    temp = vector(0, 0, 1) * rot
    ret = vector(ll.Atan2(temp.z, temp.y) - PI / 2, ret.y, ret.z)
    rot = rot / ll.Euler2Rot(vector(ret.x, 0, 0))
    --y-axis
    temp = vector(0, 0, 1) * rot
    ret = vector(ret.x, -ll.Atan2(temp.z, temp.x) + PI / 2, ret.z)
    rot = rot / ll.Euler2Rot(vector(0, ret.y, 0))
    --z-axis
    temp = vector(1, 0, 0) * rot
    ret = vector(ret.x, ret.y, ll.Atan2(temp.y, temp.x))
    return ret
end
`} lang="slua" /></div>
<div class="lsl-block"><span class="tag lsl-tag">LSL</span><DocsCode code={`vector uRot2Euler(rotation rot)
{
        vector ret;
        vector temp;

        //x-axis
        temp = <0,0,1>*rot;
        ret.x = llAtan2(temp.z,temp.y)-PI/2;
        rot = rot/llEuler2Rot(<ret.x,0,0>);
        //y-axis
        temp = <0,0,1>*rot;
        ret.y = -llAtan2(temp.z,temp.x)+PI/2;
        rot = rot/llEuler2Rot(<0,ret.y,0>);
        //z-axis
        temp = <1,0,0>*rot;
        ret.z = llAtan2(temp.y,temp.x);
        return ret;
}`} lang="lsl" /></div>
