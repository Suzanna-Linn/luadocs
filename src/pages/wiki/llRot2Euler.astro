      <div class="tech-item"><span class="tech-label">LSO ID</span><span class="tech-val">15</span></div>

      <div class="label-stack">
        <span class="attr-label bg-pure">Side-Effect Free</span>
      </div>
    </div>
  </div>
</div>
  <h2>Specification</h2>
  <p>The <a href="https://wiki.secondlife.com/wiki/Category:LSL_Euler" target="_blank">Euler</a> angle vector (in radians) is converted from a rotation by doing the rotations around the 3 axes in Z, Y, X order.</p>
  <h2>Caveats</h2>
  <ul>
    <li>Angles greater than <a href="https://wiki.secondlife.com/wiki/PI" target="_blank">PI</a> radians (180 degrees) are returned as negative angles.</li>
  </ul>
  <h2>Examples</h2>
<div class="lua-block"><span class="tag lua-tag">Lua</span><DocsCode code={`local function main()
    local input = ll.GetRot()
    ll.Say(0, "The Rot2Euler of " .. tostring(input) .. " is: " .. tostring(ll.Rot2Euler(input)))
end

main()
`} lang="slua" /></div>
<div class="lsl-block"><span class="tag lsl-tag">LSL</span><DocsCode code={`default
{
    state_entry()
    {
        rotation input = llGetRot();
        llSay(0, "The Rot2Euler of " + (string)input + " is: " + (string) llRot2Euler(input) );
    }
}`} lang="lsl" /></div>
<div class="lua-block"><span class="tag lua-tag">Lua</span><DocsCode code={`-- This script rotates a prim by 15 degrees each time the prim is touched

-- While not the best way of achieving the result,
-- this script demonstrates the use of llRot2Euler and llEuler2Rot
-- and the use of more human-friendly degrees rather than radians

function LLEvents.touch_start(events)
    local total_number = #events
    -- Get the object's current rotation as a quarternion
    local rot = ll.GetRot()
    -- Convert the rotation to a euler with roll, pitch, and yaw in radians
    local euler = ll.Rot2Euler(rot)
    -- convert the angles from radians to degrees
    euler *= RAD_TO_DEG
    -- Add 15 degrees on the Z axis        
    euler += vector(0, 0, 15)
    -- Say the current euler values in degrees
    ll.Say(0, tostring(euler))
    -- convert degrees back to radians
    euler *= DEG_TO_RAD
    -- Convert the euler back to a rotation quarternion
    rot = ll.Euler2Rot(euler)
    -- Apply the updated rotation to the prim   
    ll.SetRot(rot)
end
`} lang="slua" /></div>
<div class="lsl-block"><span class="tag lsl-tag">LSL</span><DocsCode code={`// This script rotates a prim by 15 degrees each time the prim is touched

// While not the best way of achieving the result,
// this script demonstrates the use of llRot2Euler and llEuler2Rot
// and the use of more human-friendly degrees rather than radians

default
{
    touch_start(integer total_number)
    {
        // Get the object's current rotation as a quarternion
        rotation rot = llGetRot();
        // Convert the rotation to a euler with roll, pitch, and yaw in radians
        vector euler = llRot2Euler(rot);
        // convert the angles from radians to degrees
        euler *= RAD_TO_DEG;
        // Add 15 degrees on the Z axis        
        euler += <0, 0, 15>;
        // Say the current euler values in degrees
        llSay(0, (string) euler);         
        // convert degrees back to radians
        euler *= DEG_TO_RAD;
        // Convert the euler back to a rotation quarternion
        rot =  llEuler2Rot (euler);
        // Apply the updated rotation to the prim   
        llSetRot( rot ); 
    }
}`} lang="lsl" /></div>
