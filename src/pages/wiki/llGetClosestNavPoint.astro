
---
import DocsLayout from '/src/layouts/DocsLayout.astro';
import DocsCode from '/src/components/DocsCode.astro';
---

<DocsLayout title="Lua & LSL Docs">
<div class="dashboard summary-function">
  <div class="dashboard-header">
    <span class="lua-section"><span class="tag lua-tag">Lua</span><DocsCode code={`ll.GetClosestNavPoint(Point: vector, Options: {any}): {any}`} lang="slua" /></span>
    <span class="lsl-section"><span class="tag lsl-tag">LSL</span><DocsCode code={`list llGetClosestNavPoint(vector Point, list Options);`} lang="lsl" /></span>
  </div>

  <div class="dashboard-body">
    <div class="dash-col">
      <p>  <p>Used to get a point on the navmesh that is the closest point to <b>point</b>.</p>
  <p>Returns a list containing a single vector which is the closest point on the navmesh to the point provided or an empty list.</p>
</p>
      <table class="param-table" id="parameters">
        <tr>
          <td><span class="lua-section"><span class="tag lua-tag">Lua</span>vector</span></td>
          <td><span class="lsl-section"><span class="tag lsl-tag">LSL</span>vector</span></td>
          <td>Point / point</td>
          <td>A point in <a href="https://wiki.secondlife.com/wiki/Viewer_coordinate_frames#Region" target="_blank">region-local</a> space</td>
        </tr>
        <tr>
          <td><span class="lua-section"><span class="tag lua-tag">Lua</span>{`{any}`}</span></td>
          <td><span class="lsl-section"><span class="tag lsl-tag">LSL</span>list</span></td>
          <td>Options / <a href="https://wiki.secondlife.com/wiki/Category:LSL_List/instructions" target="_blank">options</a></td>
          <td>GCNP_* and other flags with their parameters. See <a href="#Options" target="_blank">options</a> table</td>
        </tr>
      </table>
    </div>

    <div class="dash-col">
