      <tr>
        <th>Options</th>
        <th>V</th>
        <th>Parameters</th>
        <th>Default</th>
        <th>Description</th>
      </tr>
      <tr>
        <td><a href="https://wiki.secondlife.com/w/index.php?title=GCNP_RADIUS&action=edit&redlink=1" target="_blank"> [GCNP_RADIUS</a> ]</td>
        <td>0</td>
        <td><a href="https://wiki.secondlife.com/wiki/Float" target="_blank"> [float</a> distance ]</td>
        <td>[ 20.0 ]</td>
        <td>Limits how far out to search for a navigation point.</td>
      </tr>
