  <h2>Examples</h2>
  <p>Showing use to form a Json object:</p>
<div class="lua-block"><span class="tag lua-tag">Lua</span><DocsCode code={`local jsonText = ""

local function main()
    -- NOTE: All even numbered elements in the supplied list MUST be strings or JSON_INVALID will be returned!
    jsonText = ll.List2Json(JSON_OBJECT, {"A", 3, "B", vector(1.0, 1.0, 1.0), "C", "A phrase", "D", PI})
end
function LLEvents.touch_start(events)
    local total_number = #events
    -- In the resulting Json object, "Keys" are separarted from Values by a colon (:)
    -- and "Key":Value pairs by a comma (,).
    ll.OwnerSay(jsonText)  --  {"A":3,"B":"<1.000000, 1.000000, 1.000000>","C":"A phrase","D":3.141593}
end

main()
`} lang="slua" /></div>
<div class="lsl-block"><span class="tag lsl-tag">LSL</span><DocsCode code={`string jsonText;

default
{
	state_entry()
	{
		// NOTE: All even numbered elements in the supplied list MUST be strings or JSON_INVALID will be returned!
		jsonText = llList2Json(JSON_OBJECT, ["A", 3, "B", <1.0,1.0,1.0>, "C", "A phrase", "D", PI]);
	}
	touch_start(integer total_number)
	{
		// In the resulting Json object, "Keys" are separarted from Values by a colon (:)
		// and "Key":Value pairs by a comma (,).
		llOwnerSay(jsonText); //  {"A":3,"B":"<1.000000, 1.000000, 1.000000>","C":"A phrase","D":3.141593}
	}
}`} lang="lsl" /></div>
  <p>Showing usage to determine if a Value within a Json text is an object:</p>
<div class="lua-block"><span class="tag lua-tag">Lua</span><DocsCode code={`local jsonText = ""

local function main()
    -- Set jsonText to [3,{"A":77,"B":66},"A phrase"]
    -- A Json array whose second element is a Json object
    jsonText = "[3,{\"A\":77,\"B\":66},\"A phrase\"]"
    ll.OwnerSay(jsonText)
end
function LLEvents.touch_start(events)
    local total_number = #events
    -- Test the entirety of the Json text to see if it's an object
    -- Note use of the empty list for this
    if ll.JsonValueType(jsonText, {}) == JSON_OBJECT then
        ll.OwnerSay("The supplied string is a Json object.")
    else
        ll.OwnerSay("The supplied string is not a Json object.")  -- TRUE
    end

    -- Test second element of the array
    if ll.JsonValueType(jsonText, {1}) == JSON_OBJECT then
        ll.OwnerSay("The second element of the array is a Json object.")  -- TRUE
    else
        ll.OwnerSay("The second element of the array is not a Json object.")
    end
end

main()
`} lang="slua" /></div>
<div class="lsl-block"><span class="tag lsl-tag">LSL</span><DocsCode code={`string jsonText;

default
{
	state_entry()
	{
		// Set jsonText to [3,{"A":77,"B":66},"A phrase"]
		// A Json array whose second element is a Json object
		jsonText = "[3,{\"A\":77,\"B\":66},\"A phrase\"]";
		llOwnerSay(jsonText);
	}
	touch_start(integer total_number)
	{
		// Test the entirety of the Json text to see if it's an object
		// Note use of the empty list for this
		if (llJsonValueType(jsonText, []) == JSON_OBJECT)
		{
			llOwnerSay("The supplied string is a Json object.");
		} else {
			llOwnerSay("The supplied string is not a Json object."); // TRUE
		}

		// Test second element of the array
		if (llJsonValueType(jsonText, [1]) == JSON_OBJECT)
		{
			llOwnerSay("The second element of the array is a Json object."); // TRUE
		} else {
			llOwnerSay("The second element of the array is not a Json object.");
		}
	}
}`} lang="lsl" /></div>
