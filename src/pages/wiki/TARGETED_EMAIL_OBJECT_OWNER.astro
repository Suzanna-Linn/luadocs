
---
import DocsLayout from '/src/layouts/DocsLayout.astro';
import DocsCode from '/src/components/DocsCode.astro';
---

<DocsLayout title="Lua & LSL Docs">
<div class="dashboard summary-constant">
  <div class="dashboard-header">
    <span class="lua-section"><span class="tag lua-tag">Lua</span><DocsCode code={`TARGETED_EMAIL_OBJECT_OWNER: number = 2`} lang="slua" /></span>
    <span class="lsl-section"><span class="tag lsl-tag">LSL</span><DocsCode code={`integer TARGETED_EMAIL_OBJECT_OWNER = 2;`} lang="lsl" /></span>
  </div>

  <div class="dashboard-body">
    <div class="dash-col">
      <p>  <p>The integer constant TARGETED_EMAIL_OBJECT_OWNER has the value 2</p>
  <p>Causes the message to be sent to the owner of the calling object</p>
</p>
    </div>

    <div class="dash-col">
      <div class="dash-section-title">Member Of</div>
      <ul class="meta-list">
        <li>EmailTarget</li>
      </ul>
    </div>

    <div class="dash-col">
      <div class="dash-section-title">Tech Specs</div>

      <div class="label-stack">
      </div>
    </div>
  </div>
</div>
