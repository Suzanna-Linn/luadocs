TARGETED_EMAIL_OBJECT_OWNER = 2
`} lang="slua" /></div>
<div class="lsl-block"><span class="tag lsl-tag">LSL</span><DocsCode code={`
integer TARGETED_EMAIL_OBJECT_OWNER = 2;
`} lang="lsl" /></div>

</td>
      </tr>
    </tbody>
  </table>

</DocsLayout>
      