  <div class="dashboard-header">
    <span class="lua-section"><span class="tag lua-tag">Lua</span><DocsCode code={`ll.SetTextureAnim(Mode: number, Face: number, SizeX: number, SizeY: number, Start: number, Length: number, Rate: number)`} lang="slua" /></span>
