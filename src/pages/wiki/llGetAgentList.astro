<div class="lua-block"><span class="tag lua-tag">Lua</span><DocsCode code={`ll = llcompat

--Displays up to 100 avatar key: name pairs detected in the entire region

function LLEvents.touch_start(events)
    local total_number = #events
    local avatarsInRegion = ll.GetAgentList(AGENT_LIST_REGION, {})
    local numOfAvatars = #avatarsInRegion

    -- if no avatars, abort avatar listing process and give a short notice
    if not (numOfAvatars ~= 0) then
        ll.OwnerSay("No avatars found within the region!")
        return
    end

    local index = 0
    while index < numOfAvatars do
        local id = ll.List2Key(avatarsInRegion, index)
        local name = ll.Key2Name(id)

        ll.OwnerSay(name .. " [ " .. tostring(id) .. " ]")
        index += 1
    end
end
`} lang="slua" /></div>
<div class="lsl-block"><span class="tag lsl-tag">LSL</span><DocsCode code={`//Displays up to 100 avatar key: name pairs detected in the entire region

default
{
    touch_start(integer total_number)
    {
        list avatarsInRegion = llGetAgentList(AGENT_LIST_REGION, []);
        integer numOfAvatars = llGetListLength(avatarsInRegion);

        // if no avatars, abort avatar listing process and give a short notice
        if (!numOfAvatars)
        {
            llOwnerSay("No avatars found within the region!");
            return;
        }

        integer index;
        while (index < numOfAvatars)
        {
            key id = llList2Key(avatarsInRegion, index);
            string name = llKey2Name(id);

            llOwnerSay(name + " [ " + (string)id + " ]");
            ++index;
        }
    }
}`} lang="lsl" /></div>
<div class="lua-block"><span class="tag lua-tag">Lua</span><DocsCode code={`ll = llcompat

--  Orders new list based on distance
--  and returns names and distances on touch

function LLEvents.touch_start(events)
    local num_detected = #events
    local keys = ll.GetAgentList(AGENT_LIST_REGION, {})
    local numberOfKeys = #keys

    local currentPos = ll.GetPos()
    local newkeys = {}
    local thisAvKey = NULL_KEY

    local i = 0
    i = 0
    while i < numberOfKeys do
        thisAvKey = ll.List2Key(keys, i)
        newkeys = ll.ListInsertList(newkeys, {ll.Round(ll.VecDist(currentPos, ll.List2Vector(ll.GetObjectDetails(thisAvKey, {OBJECT_POS}), 0))), thisAvKey}, #newkeys)
        i += 1
    end

    newkeys = ll.ListSort(newkeys, 2, false)  --  sort strided list by descending distance

    i = 0
    while i < (numberOfKeys * 2) do
        ll.OwnerSay(ll.GetDisplayName(ll.List2Key(newkeys, i + 1)) .. " [" .. tostring(ll.List2Integer(newkeys, i)) .. "m]")
        i += 2
    end
end
`} lang="slua" /></div>
<div class="lsl-block"><span class="tag lsl-tag">LSL</span><DocsCode code={`//  Orders new list based on distance
//  and returns names and distances on touch

default
{
    touch_start(integer num_detected)
    {
        list keys = llGetAgentList(AGENT_LIST_REGION, []);
        integer numberOfKeys = llGetListLength(keys);

        vector currentPos = llGetPos();
        list newkeys;
        key thisAvKey;

        integer i;
        for (i = 0; i < numberOfKeys; ++i) {
            thisAvKey = llList2Key(keys,i);
            newkeys += [llRound(llVecDist(currentPos,
                            llList2Vector(llGetObjectDetails(thisAvKey, [OBJECT_POS]), 0))),
                        thisAvKey];
        }
  
        newkeys = llListSort(newkeys, 2, FALSE);     //  sort strided list by descending distance

        for (i = 0; i < (numberOfKeys * 2); i += 2) {
            llOwnerSay(llGetDisplayName(llList2Key(newkeys, i+1))
                +" ["+ (string) llList2Integer(newkeys, i) + "m]");
        }
    }
}`} lang="lsl" /></div>
