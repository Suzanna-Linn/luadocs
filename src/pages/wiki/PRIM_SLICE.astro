  <h2>Examples</h2>
<div class="lua-block"><span class="tag lua-tag">Lua</span><DocsCode code={`--updated findings show the difference can be as small as 0.02 not 0.05 (Tomos.Halsey)
local function main()
    ll.SetLinkPrimitiveParams(LINK_THIS, {PRIM_SLICE, vector(0.0, 0.02, 0.0)})
end

main()
`} lang="slua" /></div>
