  <h3>Top-size (taper)</h3>
<div class="lua-block"><span class="tag lua-tag">Lua</span><DocsCode code={`local function main()
    local scale = ll.GetScale()
    local X = scale.x
    local Y = scale.y

    -- keep the prim thin
    ll.SetPrimitiveParams({PRIM_SIZE, vector(X, Y, 0.1), PRIM_TYPE, PRIM_TYPE_BOX, 0, vector(0.0, 1.0, 0.0), 0.0, ZERO_VECTOR, vector(1.0 - (0.4 / X), 1.0 - (0.4 / Y), 0.0), ZERO_VECTOR})
-- We used the equation "answer = 1 - desired_taper"

-- The proportions of the top-size (taper) will be maintained (as close as possible)
-- whenever the prim is resized. The proportion above will produce a reasonably
-- pleasing picture frame kinda thing.
end

function LLEvents.changed(change)
    if bit32.btest(change, CHANGED_SCALE) then
        ll.ResetScript()
    end
end

main()
`} lang="slua" /></div>
<div class="lsl-block"><span class="tag lsl-tag">LSL</span><DocsCode code={`default
