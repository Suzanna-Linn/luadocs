<div class="lua-block"><span class="tag lua-tag">Lua</span><DocsCode code={`local ItemName = "MyTexture"
local function main()
    if ll.GetInventoryType(ItemName) == INVENTORY_NONE then
        ll.OwnerSay("There is nothing named '" .. ItemName .. "' in this prim's contents")
    end
end

main()
`} lang="slua" /></div>
