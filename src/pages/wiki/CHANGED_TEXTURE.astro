  <h2>Examples</h2>
<div class="lua-block"><span class="tag lua-tag">Lua</span><DocsCode code={`function LLEvents.changed(change)
    if bit32.btest(change, CHANGED_TEXTURE) then  --note that it's & and not &&... it's bitwise!
        ll.OwnerSay("The prims texture or texture attributes have changed.")
    end
end
`} lang="slua" /></div>
<div class="lsl-block"><span class="tag lsl-tag">LSL</span><DocsCode code={`default
{
    changed(integer change)
    {
        if (change & CHANGED_TEXTURE) //note that it's & and not &&... it's bitwise!
        {
            llOwnerSay("The prims texture or texture attributes have changed.");
        }
    }
}`} lang="lsl" /></div>
