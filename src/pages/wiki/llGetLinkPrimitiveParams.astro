<div class="dashboard summary-function">
  <div class="dashboard-header">
    <span class="lua-section"><span class="tag lua-tag">Lua</span><DocsCode code={`ll.GetLinkPrimitiveParams(LinkNumber: number, Parameters: {number}): {any}`} lang="slua" /></span>
    <span class="lsl-section"><span class="tag lsl-tag">LSL</span><DocsCode code={`list llGetLinkPrimitiveParams(integer LinkNumber, list Parameters);`} lang="lsl" /></span>
  </div>

  <div class="dashboard-body">
    <div class="dash-col">
      <p>  <p>Returns <a href="https://wiki.secondlife.com/w/index.php?title=Category:LSL_List/parameter_values&action=edit&redlink=1" target="_blank">attribute values</a> (a <a href="https://wiki.secondlife.com/wiki/List" target="_blank">list</a>) for the attributes requested in the <b>params</b> list.</p>
</p>
      <table class="param-table" id="parameters">
        <tr>
          <td><span class="lua-section"><span class="tag lua-tag">Lua</span>number</span></td>
          <td><span class="lsl-section"><span class="tag lsl-tag">LSL</span>integer</span></td>
          <td>LinkNumber / <a href="https://wiki.secondlife.com/wiki/Category:LSL_List/instructions" target="_blank">params</a></td>
          <td>PRIM_* flags</td>
        </tr>
        <tr>
          <td><span class="lua-section"><span class="tag lua-tag">Lua</span>{`{number}`}</span></td>
          <td><span class="lsl-section"><span class="tag lsl-tag">LSL</span>list</span></td>
          <td>Parameters</td>
          <td>PRIM_* flags.</td>
        </tr>
      </table>
    </div>

    <div class="dash-col">
      <div class="dash-section-title">Categories</div>
      <ul class="meta-list">
        <li>linkset</li>
        <li>prim_appearance</li>
      </ul>
    </div>

    <div class="dash-col">
      <div class="dash-section-title">Tech Specs</div>
      <div class="tech-item"><span class="tech-label">Energy</span><span class="tech-val">10</span></div>
