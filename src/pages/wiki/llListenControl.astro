  <h2>Caveats</h2>
  <ul>
    <li>On <a href="https://wiki.secondlife.com/wiki/State" target="_blank">state</a> change or <a href="https://wiki.secondlife.com/wiki/LlResetScript" target="_blank">script reset</a> all listens are removed automaticaly.</li>
  </ul>
  <h2>Examples</h2>
  <p>a small example of an on and off switchable listen by use of llListenControl()</p>
<div class="lua-block"><span class="tag lua-tag">Lua</span><DocsCode code={`local handle = 0
local toggle = false
local function main()
    handle = ll.Listen(5, "", NULL_KEY, "")  -- Establish a listener to listen to anything on channel 5 ...
    ll.ListenControl(handle, false)  -- ... but make the listener inactive for now
    ll.SetText("not listening", vector(0.0, 0.0, 0.0), 1.0)
end

function LLEvents.touch_start(events)
    local total_number = #events
    toggle = not toggle
    ll.ListenControl(handle, toggle)  -- Make the listener active or inactive as required

    if toggle then
        ll.Say(0, "now listening on channel 5")
        ll.SetText("listening on ch 5", vector(1.0, 0.0, 0.0), 1.0)
    else
        ll.Say(0, "not listening any more")
        ll.SetText("not listening", vector(0.0, 0.0, 0.0), 1.0)
    end
end

function LLEvents.listen(channel, name, id, message)
    ll.Say(0, name .. " just said " .. message)
end

main()
`} lang="slua" /></div>
<div class="lsl-block"><span class="tag lsl-tag">LSL</span><DocsCode code={`integer handle;
integer toggle;
default
{
    state_entry()
    {
        handle = llListen(5, "", NULL_KEY, "");    // Establish a listener to listen to anything on channel 5 ...
        llListenControl(handle, FALSE);            // ... but make the listener inactive for now
        llSetText("not listening", <0.0,0.0,0.0>, 1.0);
    }

    touch_start(integer total_number)
    {
        toggle = !toggle;
        llListenControl(handle, toggle);           // Make the listener active or inactive as required

        if(toggle)
        {
            llSay(0, "now listening on channel 5");
            llSetText("listening on ch 5", <1.0,0.0,0.0>, 1.0);
        }
        else
        {
            llSay(0, "not listening any more");
            llSetText("not listening", <0.0,0.0,0.0>, 1.0);
        }     
    }
    
    listen(integer channel, string name, key id, string message)
    {
        llSay(0, name + " just said " + message);
    }
}`} lang="lsl" /></div>
