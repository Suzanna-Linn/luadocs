  <h2>Examples</h2>
<div class="lua-block"><span class="tag lua-tag">Lua</span><DocsCode code={`ll = llcompat

--Gives inventory only to agents with the same active group as the object the script is in is assigned to
function LLEvents.touch_start(events)
    local total_number = #events
    local user = ll.DetectedKey(0)
    if ll.DetectedGroup(0) ~= 0 then  --same as llSameGroup(llDetectedKey(0)) (with llSameGroup, detected must be in the sim)
        -- Mind you, if they're not in the same SIM they shouldn't be trying to touch this object!
        ll.GiveInventory(user, ll.GetInventoryName(INVENTORY_GESTURE, 0))
    else
        ll.RegionSayTo(user, 0, "Wrong active group!")
    end
end
`} lang="slua" /></div>
<div class="lsl-block"><span class="tag lsl-tag">LSL</span><DocsCode code={`//Gives inventory only to agents with the same active group as the object the script is in is assigned to
default
{
    touch_start(integer total_number)
    {
        key user = llDetectedKey(0);
        if (llDetectedGroup(0) ) //same as llSameGroup(llDetectedKey(0)) (with llSameGroup, detected must be in the sim)
                                 // Mind you, if they're not in the same SIM they shouldn't be trying to touch this object!
            llGiveInventory(user, llGetInventoryName(INVENTORY_GESTURE, 0) );
        else
            llRegionSayTo(user, 0, "Wrong active group!");
    }
}`} lang="lsl" /></div>
