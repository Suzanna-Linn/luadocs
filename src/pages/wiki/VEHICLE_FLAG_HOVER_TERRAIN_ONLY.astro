      <tr>
        <td><a href="https://wiki.secondlife.com/wiki/VEHICLE_FLAG_HOVER_WATER_ONLY" target="_blank">VEHICLE_FLAG_HOVER_WATER_ONLY</a></td>
        <td>0x004</td>
        <td>Ignore terrain height when hovering.</td>
