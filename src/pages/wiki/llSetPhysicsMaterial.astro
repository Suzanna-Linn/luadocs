<DocsLayout title="Lua & LSL Docs">
<div class="dashboard summary-function">
  <div class="dashboard-header">
    <span class="lua-section"><span class="tag lua-tag">Lua</span><DocsCode code={`ll.SetPhysicsMaterial(MaterialBits: number, GravityMultiplier: number, Restitution: number, Friction: number, Density: number)`} lang="slua" /></span>
    <span class="lsl-section"><span class="tag lsl-tag">LSL</span><DocsCode code={`llSetPhysicsMaterial(integer MaterialBits, float GravityMultiplier, float Restitution, float Friction, float Density);`} lang="lsl" /></span>
  </div>

  <div class="dashboard-body">
    <div class="dash-col">
      <p>  <p>Used to set the physical characteristics of an object.</p>
</p>
      <table class="param-table" id="parameters">
        <tr>
          <td><span class="lua-section"><span class="tag lua-tag">Lua</span>number</span></td>
          <td><span class="lsl-section"><span class="tag lsl-tag">LSL</span>integer</span></td>
          <td>MaterialBits / mask</td>
          <td>bitwise combination of <a href="https://wiki.secondlife.com/w/index.php?title=DENSITY&action=edit&redlink=1" target="_blank">DENSITY</a>, <a href="https://wiki.secondlife.com/w/index.php?title=FRICTION&action=edit&redlink=1" target="_blank">FRICTION</a>, <a href="https://wiki.secondlife.com/wiki/RESTITUTION" target="_blank">RESTITUTION</a>, and <a href="https://wiki.secondlife.com/wiki/GRAVITY_MULTIPLIER" target="_blank">GRAVITY_MULTIPLIER</a> and specifies which floats to actually apply</td>
        </tr>
        <tr>
          <td><span class="lua-section"><span class="tag lua-tag">Lua</span>number</span></td>
          <td><span class="lsl-section"><span class="tag lsl-tag">LSL</span>float</span></td>
          <td>GravityMultiplier / gravity_multiplier</td>
          <td>range [-1.0, +28.0], default: 1.0</td>
        </tr>
        <tr>
          <td><span class="lua-section"><span class="tag lua-tag">Lua</span>number</span></td>
          <td><span class="lsl-section"><span class="tag lsl-tag">LSL</span>float</span></td>
          <td>Restitution / restitution</td>
          <td>range [0.0, 1.0], default: [0.3, 0.9] [[1]](#footnote_1)</td>
        </tr>
        <tr>
          <td><span class="lua-section"><span class="tag lua-tag">Lua</span>number</span></td>
          <td><span class="lsl-section"><span class="tag lsl-tag">LSL</span>float</span></td>
          <td>Friction / friction</td>
          <td>range [0.0, 255.0], default: [0.2, 0.9][[1]](#footnote_1)</td>
        </tr>
        <tr>
          <td><span class="lua-section"><span class="tag lua-tag">Lua</span>number</span></td>
          <td><span class="lsl-section"><span class="tag lsl-tag">LSL</span>float</span></td>
          <td>Density / density</td>
          <td>range [1.0, 22587.0] <a href="https://wiki.secondlife.com/wiki/LlGetMassMKS" target="_blank">kg</a>/m^3, default: 1000.0</td>
        </tr>
      </table>
    </div>

    <div class="dash-col">
      <div class="dash-section-title">Categories</div>
      <ul class="meta-list">
        <li>physics</li>
        <li>prim</li>
        <li>prim_properties</li>
      </ul>
    </div>

    <div class="dash-col">
      <div class="dash-section-title">Tech Specs</div>
      <div class="tech-item"><span class="tech-label">Energy</span><span class="tech-val">10</span></div>
