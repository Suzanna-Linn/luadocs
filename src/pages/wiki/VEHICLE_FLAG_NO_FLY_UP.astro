
---
import DocsLayout from '/src/layouts/DocsLayout.astro';
import DocsCode from '/src/components/DocsCode.astro';
---

<DocsLayout title="Lua & LSL Docs">
<div class="dashboard summary-constant">
  <div class="dashboard-header">
    <span class="lua-section"><span class="tag lua-tag">Lua</span><DocsCode code={`VEHICLE_FLAG_NO_FLY_UP: number = 1`} lang="slua" /></span>
    <span class="lsl-section"><span class="tag lsl-tag">LSL</span><DocsCode code={`integer VEHICLE_FLAG_NO_FLY_UP = 1;`} lang="lsl" /></span>
  </div>

  <div class="dashboard-body">
    <div class="dash-col">
      <p class="deprecated-text"">Deprecated:  use VEHICLE_FLAG_NO_DEFLECTION_UP</p>
      <p>Old, changed to VEHICLE_FLAG_NO_DEFLECTION_UP</p>
    </div>

    <div class="dash-col">
      <div class="dash-section-title">Member Of</div>
      <ul class="meta-list">
        <li>VehicleFlag</li>
      </ul>
    </div>

    <div class="dash-col">
      <div class="dash-section-title">Tech Specs</div>

      <div class="label-stack">
        <span class="attr-label bg-deprecated">Deprecated</span>
      </div>
    </div>
  </div>
</div>

</DocsLayout>
      