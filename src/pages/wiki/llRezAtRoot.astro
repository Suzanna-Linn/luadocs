<div class="lua-block"><span class="tag lua-tag">Lua</span><DocsCode code={`ll = llcompat

--[[ 
    NO COPY Rezzer Example by Daemonika Nightfire
    Always rez the first object at touch, removing it from the content,
    when the first one is removed, the next object automatically moves to the first position.

    Content example:
    object (no copy)
    object 1 (no copy)
    object 2 (no copy)
    object 3 (no copy)
    object 4 (no copy)
    ...

]]
local relativePosOffset = vector(2.0, 0.0, 1.0)  -- "Forward" and a little "above" this prim
local relativeVel = vector(1.0, 0.0, 0.0)  -- Traveling in this prim's "forward" direction at 1m/s
local relativeRot = vector(90, 0, 0)  -- Rotated 90 degrees on the x-axis compared to this prim
local startParam = 10

function LLEvents.touch_start(events)
    local a = #events
    if ll.GetInventoryNumber(INVENTORY_OBJECT) > 0 then  -- checks if at least 1 object is present.
        local object = ll.GetInventoryName(INVENTORY_OBJECT, 0)  -- name of the first object in inventory
        local myPos = ll.GetPos()
        local myRot = ll.GetRot()

        local rezPos = myPos + relativePosOffset * myRot
        local rezVel = relativeVel * myRot
        local rezRot = ll.Euler2Rot(relativeRot * DEG_TO_RAD) * myRot

        ll.RezAtRoot(object, rezPos, rezVel, rezRot, startParam)
    else
        ll.Say(0, "This rezzer is empty")
    end
end
`} lang="slua" /></div>
<div class="lsl-block"><span class="tag lsl-tag">LSL</span><DocsCode code={`/* 
    NO COPY Rezzer Example by Daemonika Nightfire
    Always rez the first object at touch, removing it from the content,
    when the first one is removed, the next object automatically moves to the first position.

    Content example:
    object (no copy)
    object 1 (no copy)
    object 2 (no copy)
    object 3 (no copy)
    object 4 (no copy)
    ...
    
*/

vector relativePosOffset = <2.0, 0.0, 1.0>; // "Forward" and a little "above" this prim
vector relativeVel = <1.0, 0.0, 0.0>; // Traveling in this prim's "forward" direction at 1m/s
vector relativeRot = <90, 0, 0>; // Rotated 90 degrees on the x-axis compared to this prim
integer startParam = 10;
 
default
{
    touch_start(integer a)
    {
        if(llGetInventoryNumber(INVENTORY_OBJECT) > 0) // checks if at least 1 object is present.
        {
            string object = llGetInventoryName(INVENTORY_OBJECT, 0); // name of the first object in inventory
            vector myPos = llGetPos();
            rotation myRot = llGetRot();
     
            vector rezPos = myPos+relativePosOffset*myRot;
            vector rezVel = relativeVel*myRot;
            rotation rezRot = llEuler2Rot(relativeRot*DEG_TO_RAD)*myRot;
     
            llRezAtRoot(object, rezPos, rezVel, rezRot, startParam);
        }
        else
        {
            llSay(0, "This rezzer is empty");
        }
    }
}`} lang="lsl" /></div>
