    <span class="lua-section"><span class="tag lua-tag">Lua</span><DocsCode code={`ll.SetLinkMedia(Link: number, Face: number, Parameters: {any}): number`} lang="slua" /></span>
    <span class="lsl-section"><span class="tag lsl-tag">LSL</span><DocsCode code={`integer llSetLinkMedia(integer Link, integer Face, list Parameters);`} lang="lsl" /></span>
