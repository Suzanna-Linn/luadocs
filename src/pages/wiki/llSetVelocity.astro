      </tr>
    </tbody>
  </table>
  <h2>Deep Notes</h2>
  <p>History</p>
  <p>Date of Release <a href="https://wiki.secondlife.com/wiki/Release_Notes/Second_Life_Server/11#11.08.10.238207" target="_blank"> 10/08/2011 </a></p>
  <table>
    <tbody>
      <tr>
        <th>Signature</th>
      </tr>
      <tr>
        <td><div class="lsl-block"><span class="tag lsl-tag">LSL</span><DocsCode code={`
function void llSetVelocity( vector velocity, integer local );
`} lang="lsl" /></div>

</td>
