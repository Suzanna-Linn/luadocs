        <td>•</td>
        <td><a href="https://wiki.secondlife.com/wiki/LlSetAngularVelocity" target="_blank">llSetAngularVelocity</a></td>
        <td></td>
        <td></td>
        <td></td>
      </tr>
      <tr>
        <td>•</td>
        <td><a href="https://wiki.secondlife.com/wiki/LlApplyImpulse" target="_blank">llApplyImpulse</a></td>
        <td></td>
