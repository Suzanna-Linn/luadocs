  <h2>Examples</h2>
  <p>Set the prim's color and the color of the light it emits to the same color:-</p>
<div class="lua-block"><span class="tag lua-tag">Lua</span><DocsCode code={`local switch = false

local gLampCol = vector(255, 190, 121)  --Light colour in regular (0-255) sRGB space. This will be converted to LSL later.

local function main()
    gLampCol /= 255  --Convert to LSL colour.
end

function LLEvents.touch_start(events)
    local total_number = #events
    switch = not switch  --toggle the switch
    --Convert colour to linear RGB as PRIM_POINT_LIGHT requires, using llsRGB2Linear
    ll.SetLinkPrimitiveParamsFast(LINK_THIS, {PRIM_POINT_LIGHT, if switch then 1 else 0, ll.sRGB2Linear(gLampCol), 1, 20, 0, PRIM_COLOR, ALL_SIDES, gLampCol, 1, PRIM_GLOW, ALL_SIDES, if switch then 1 else 0, PRIM_FULLBRIGHT, ALL_SIDES, if switch then 1 else 0})
end

main()
`} lang="slua" /></div>
<div class="lsl-block"><span class="tag lsl-tag">LSL</span><DocsCode code={`integer switch;

vector gLampCol = <255,190,121>; //Light colour in regular (0-255) sRGB space. This will be converted to LSL later.

default
{
    state_entry()
    {
        gLampCol /= 255; //Convert to LSL colour.
    }

    touch_start(integer total_number)
    {
        switch = !switch; //toggle the switch
        llSetLinkPrimitiveParamsFast(LINK_THIS,[
            PRIM_POINT_LIGHT,switch,llsRGB2Linear(gLampCol),1,20,0, //Convert colour to linear RGB as PRIM_POINT_LIGHT requires, using llsRGB2Linear
            PRIM_COLOR,ALL_SIDES,gLampCol,1,
            PRIM_GLOW,ALL_SIDES,switch,
            PRIM_FULLBRIGHT,ALL_SIDES,switch]);
    }
}`} lang="lsl" /></div>
  <p>Basic light script:-</p>
<div class="lua-block"><span class="tag lua-tag">Lua</span><DocsCode code={`local isLightTurnedOn = false

function LLEvents.touch_start(events)
    local total_number = #events
    --      toggle isLightTurnedOn between TRUE and FALSE
    isLightTurnedOn = not isLightTurnedOn

    if isLightTurnedOn then
        ll.SetPrimitiveParams({PRIM_FULLBRIGHT, ALL_SIDES, if false then 1 else 0, PRIM_POINT_LIGHT, if false then 1 else 0, ZERO_VECTOR, 1.0, 10.0, 0.6})
    else
        local COLOR_ORANGE = vector(1.000, 0.522, 0.106)

        ll.SetPrimitiveParams({PRIM_FULLBRIGHT, ALL_SIDES, if true then 1 else 0, PRIM_POINT_LIGHT, if true then 1 else 0, COLOR_ORANGE, 1.0, 10.0, 0.6})
    end
end
`} lang="slua" /></div>
<div class="lsl-block"><span class="tag lsl-tag">LSL</span><DocsCode code={`integer isLightTurnedOn;

default
{
    touch_start(integer total_number)
    {
//      toggle isLightTurnedOn between TRUE and FALSE
        isLightTurnedOn = !isLightTurnedOn;

        if (isLightTurnedOn)
        {
            llSetPrimitiveParams([
                PRIM_FULLBRIGHT, ALL_SIDES, FALSE,
                PRIM_POINT_LIGHT, FALSE, ZERO_VECTOR, 1.0, 10.0, 0.6]);
        }
        else
        {
            vector COLOR_ORANGE  = <1.000, 0.522, 0.106>;

            llSetPrimitiveParams([
                PRIM_FULLBRIGHT, ALL_SIDES, TRUE,
                PRIM_POINT_LIGHT, TRUE, COLOR_ORANGE, 1.0, 10.0, 0.6]);
        }
    }
}`} lang="lsl" /></div>
  <p>A compact version of the above:-</p>
<div class="lua-block"><span class="tag lua-tag">Lua</span><DocsCode code={`local switch = 0
function LLEvents.touch_start(events)
    local total_number = #events
    ll.SetPrimitiveParams({PRIM_FULLBRIGHT, ALL_SIDES, (function() switch = (if not (switch ~= 0) then 1 else 0) return switch end)(), PRIM_POINT_LIGHT, switch, vector(1, 0.5, 0.1) * switch, 1, 10, 0.6})
end
`} lang="slua" /></div>
<div class="lsl-block"><span class="tag lsl-tag">LSL</span><DocsCode code={`integer switch;
default
{
    touch_start(integer total_number)
    {
        llSetPrimitiveParams(
        [       PRIM_FULLBRIGHT, ALL_SIDES, switch = !switch,
                PRIM_POINT_LIGHT, switch, <1, 0.5, 0.1> *  switch, 1, 10, 0.6 ] );      
    }
}`} lang="lsl" /></div>
