  <h2>Examples</h2>
  <p>Increase the prim&#39;s reflection probe ambiance when an agent is detected in the sensor range of the prim. Decrease the probe ambiance when an agent is no longer detected.</p>
<div class="lua-block"><span class="tag lua-tag">Lua</span><DocsCode code={`local probe_enabled = true
local probe_no_agent_ambiance = 0.0
local probe_agent_ambiance = 1.0
local probe_clip_distance = 0.0
local probe_flags = 0

local function main()
    local sensor_type = AGENT
    local sensor_range = 3.0
    local sensor_rate = 5.0
    ll.SensorRepeat("", "", sensor_type, sensor_range, PI, sensor_rate)
end

function LLEvents.sensor(events)
    local num_detected = #events
    ll.SetPrimitiveParams({PRIM_REFLECTION_PROBE, if probe_enabled then 1 else 0, probe_agent_ambiance, probe_clip_distance, probe_flags})
end

function LLEvents.no_sensor()
    ll.SetPrimitiveParams({PRIM_REFLECTION_PROBE, if probe_enabled then 1 else 0, probe_no_agent_ambiance, probe_clip_distance, probe_flags})
end

main()
`} lang="slua" /></div>
<div class="lsl-block"><span class="tag lsl-tag">LSL</span><DocsCode code={`integer probe_enabled = TRUE;
float probe_no_agent_ambiance = 0.0;
float probe_agent_ambiance = 1.0;
float probe_clip_distance = 0.0;
integer probe_flags = 0;

default
{
    state_entry()
    {
        integer sensor_type = AGENT;
        float sensor_range = 3.0;
        float sensor_rate = 5.0;
        llSensorRepeat("", "", sensor_type, sensor_range, PI, sensor_rate);
    }

    sensor(integer num_detected)
    {
        llSetPrimitiveParams([PRIM_REFLECTION_PROBE, probe_enabled, probe_agent_ambiance, probe_clip_distance, probe_flags]);
    }
    
    no_sensor()
    {
        llSetPrimitiveParams([PRIM_REFLECTION_PROBE, probe_enabled, probe_no_agent_ambiance, probe_clip_distance, probe_flags]);
    }
}`} lang="lsl" /></div>
