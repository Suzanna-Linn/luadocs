  <h2>Specification</h2>
  <p>This function&#39;s behavior is dependent upon the VM the script is using. <a href="#Mono" target="_blank">Mono</a> is the new VM, <a href="#LSO" target="_blank">LSO</a> is the old VM.</p>
  <p>Mono
Sets the memory limit for the script.</p>
  <ul>
    <li>The memory limit can be set up to 64k.</li>
    <li>The memory limit can not be set lower than the memory currently in use by the script.</li>
    <li>All new scripts start with a limit of 64k</li>
    <li>Mono scripts compiled before this function was introduced continue to use the 64k limit.</li>
    <li>A lower limit will effect the amount of memory reported in the viewer UI and by <a href="https://wiki.secondlife.com/wiki/LlGetObjectDetails" target="_blank">llGetObjectDetails</a>.</li>
    <li>The memory limit is not the amount of real memory actually used by the script, just the upper limit on it.</li>
  </ul>
  <p>LSO
Has no effect on LSO scripts which will always use exactly 16k</p>
  <h2>Caveats</h2>
  <p>Mono
When <i><b>n</b></i> is too small, llSetMemoryLimit(<i><b>n</b></i>) is ignored and the memory limit is not changed</p>
  <h2>Examples</h2>
<div class="lua-block"><span class="tag lua-tag">Lua</span><DocsCode code={`ll = llcompat

-- Memory-walkthrough by Daemonika Nightfire (daemonika.nightfire)

local limit = 20000  -- <- bytes

local function Test()
    ll.SetText("Limited Memory " .. tostring(ll.GetMemoryLimit()) .. "\nUsed Memory " .. tostring(ll.GetUsedMemory()) .. "\nFree Memory " .. tostring(ll.GetFreeMemory()), vector(1, 1, 1), 1)
end

local function main()
    ll.SetMemoryLimit(limit)

    ll.ScriptProfiler(PROFILE_SCRIPT_MEMORY)
    Test()
    ll.ScriptProfiler(PROFILE_NONE)

    ll.Say(0, "This script used at most " .. tostring(ll.GetSPMaxMemory()) .. " bytes of memory during Test.")
end

main()
`} lang="slua" /></div>
<div class="lsl-block"><span class="tag lsl-tag">LSL</span><DocsCode code={`// Memory-walkthrough by Daemonika Nightfire (daemonika.nightfire)

integer limit = 20000; // <- bytes

Test()
{
    llSetText("Limited Memory " + (string)llGetMemoryLimit() +
              "\nUsed Memory " + (string)llGetUsedMemory() +
              "\nFree Memory " + (string)llGetFreeMemory(),<1,1,1>,1);
}

default
{
    state_entry()
    {
        llSetMemoryLimit(limit);
        
        llScriptProfiler(PROFILE_SCRIPT_MEMORY);
        Test();
        llScriptProfiler(PROFILE_NONE);
        
        llSay(0,"This script used at most " + (string)llGetSPMaxMemory() + " bytes of memory during Test.");
    }
}

// Result:
        
// Floating Text:
// Limited Memory 20000
// Used Memory 4972
// Free Memory 15100
        
// Chat:
// [05:11] Object: This script used at most 4972 bytes of memory during Test.`} lang="lsl" /></div>
