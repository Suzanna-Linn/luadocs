local function main()
    ll.SetClickAction(CLICK_ACTION_PAY)

    --  enabled edit field to put own amount, all quick-pay-buttons hidden
    ll.SetPayPrice(PAY_DEFAULT, {PAY_HIDE, PAY_HIDE, PAY_HIDE, PAY_HIDE})
end

function LLEvents.money(id, amount)
    local name = ll.Key2Name(id)

    ll.InstantMessage(id, "Thank you for the tip, " .. name .. "!")
end

main()
`} lang="slua" /></div>
