<div class="lua-block"><span class="tag lua-tag">Lua</span><DocsCode code={`ll = llcompat

--Sit Only with Permission

local gAvWhitelist = {"953d10f1-44ce-462a-8bc1-f634333ee031", "599dce91-a2b8-48c5-b96d-54965433022b"}

local function main()
    ll.SitTarget(vector(0.0, 0.0, 0.5), ZERO_ROTATION)
end

function LLEvents.changed(change)
    if bit32.btest(change, CHANGED_LINK) then
        local Properties = ll.GetObjectDetails(ll.GetKey(), {OBJECT_CLICK_ACTION})
        local Click = ll.List2Integer(Properties, 0)
        local Av = ll.AvatarOnSitTarget()
        if (Av ~= NULL_KEY) and (not (Click ~= 0)) then
            ll.Say(0, "Please click first for permission to sit.")
            ll.UnSit(Av)
        end
    end
end
function LLEvents.touch_start(events)
    local total_number = #events
    local Properties = ll.GetObjectDetails(ll.GetKey(), {OBJECT_CLICK_ACTION})
    local Click = ll.List2Integer(Properties, 0)
    if not (Click ~= 0) and (bit32.bnot(ll.ListFindList(gAvWhitelist, {tostring(ll.DetectedKey(0))})) ~= 0) then
        ll.SetClickAction(CLICK_ACTION_SIT)
        ll.SetTimerEvent(10.0)
        ll.Say(0, "Please take a seat.")
    else
        ll.SetClickAction(CLICK_ACTION_TOUCH)
        if ll.AvatarOnSitTarget() ~= NULL_KEY then
            ll.Say(0, "Good bye!")
        else
            ll.Say(0, "Sorry.  You are not allowed to sit here.")
        end
        ll.UnSit(ll.DetectedKey(0))
    end
end

function LLEvents.timer()
    ll.SetTimerEvent(0.0)
    ll.SetClickAction(CLICK_ACTION_TOUCH)
end

main()
`} lang="slua" /></div>
<div class="lsl-block"><span class="tag lsl-tag">LSL</span><DocsCode code={`//Sit Only with Permission

list gAvWhitelist = ["953d10f1-44ce-462a-8bc1-f634333ee031", "599dce91-a2b8-48c5-b96d-54965433022b"];

default
{
    state_entry()
    {
        llSitTarget(<0.0, 0.0, 0.5>, ZERO_ROTATION);
    }
    
    changed(integer change)
    {
        if (change & CHANGED_LINK)
        {
            list Properties = llGetObjectDetails(llGetKey(), [OBJECT_CLICK_ACTION]);
            integer Click = llList2Integer(Properties, 0);
            key Av = llAvatarOnSitTarget();
            if ((Av != NULL_KEY) && (!Click))
            {
                llSay(0, "Please click first for permission to sit.");
                llUnSit(Av);
            }
        }
    }
    touch_start(integer total_number)
    {
        list Properties = llGetObjectDetails(llGetKey(), [OBJECT_CLICK_ACTION]);
        integer Click = llList2Integer(Properties, 0);
        if (!Click && (~llListFindList(gAvWhitelist, [(string)llDetectedKey(0)])))
        {
            llSetClickAction(CLICK_ACTION_SIT);
            llSetTimerEvent(10.0);
            llSay(0, "Please take a seat.");
        }
        else
        {
            llSetClickAction(CLICK_ACTION_TOUCH);
            if (llAvatarOnSitTarget() != NULL_KEY)
            {
                llSay(0, "Good bye!");
            }
            else
            {
                llSay(0, "Sorry.  You are not allowed to sit here.");
            }
            llUnSit(llDetectedKey(0));
        }            
    }
    
    timer()
    {
        llSetTimerEvent(0.0);
        llSetClickAction(CLICK_ACTION_TOUCH);
    }
}`} lang="lsl" /></div>
