-- Because ownership changes when the object is attached, the initial PERMISSION_ATTACH is revoked, and new permissions need to be requested.

function LLEvents.touch_start(events)
    local num = #events
    if not (ll.GetAttached() ~= 0) then
        ll.RequestPermissions(ll.DetectedKey(0), PERMISSION_ATTACH)
    elseif bit32.btest(ll.GetPermissions(), PERMISSION_ATTACH) then
