    end
end
function LLEvents.run_time_permissions(perm)
    if not (ll.GetAttached() ~= 0) and bit32.btest(perm, PERMISSION_ATTACH) then
        ll.AttachToAvatarTemp(ATTACH_NOSE)
    end
    if bit32.btest(perm, PERMISSION_TRIGGER_ANIMATION) then
