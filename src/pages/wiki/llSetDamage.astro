
---
import DocsLayout from '/src/layouts/DocsLayout.astro';
import DocsCode from '/src/components/DocsCode.astro';
---

<DocsLayout title="Lua & LSL Docs">
<div class="dashboard summary-function">
  <div class="dashboard-header">
    <span class="lua-section"><span class="tag lua-tag">Lua</span><DocsCode code={`ll.SetDamage(Damage: number)`} lang="slua" /></span>
    <span class="lsl-section"><span class="tag lsl-tag">LSL</span><DocsCode code={`llSetDamage(float Damage);`} lang="lsl" /></span>
  </div>

  <div class="dashboard-body">
    <div class="dash-col">
      <p>  <p>Sets the amount of <b>damage</b> that will be done when this object hits an avatar.</p>
</p>
      <table class="param-table" id="parameters">
        <tr>
          <td><span class="lua-section"><span class="tag lua-tag">Lua</span>number</span></td>
          <td><span class="lsl-section"><span class="tag lsl-tag">LSL</span>float</span></td>
          <td>Damage / damage</td>
          <td>range: -100.0 (full heal) ~ 100.0 (instant kill)</td>
        </tr>
      </table>
    </div>

    <div class="dash-col">
      <div class="dash-section-title">Categories</div>
      <ul class="meta-list">
        <li>combat</li>
      </ul>
    </div>

    <div class="dash-col">
      <div class="dash-section-title">Tech Specs</div>
      <div class="tech-item"><span class="tech-label">Energy</span><span class="tech-val">10</span></div>
      <div class="tech-item"><span class="tech-label">LSO ID</span><span class="tech-val">157</span></div>

      <div class="label-stack">
      </div>
    </div>
  </div>
</div>
  <h2>Specification</h2>
  <p>For an avatar to take damage when the object collides with an avatar...</p>
  <ul>
    <li>The object must not be <a href="https://wiki.secondlife.com/wiki/STATUS_PHANTOM" target="_blank">phantom</a> or <a href="https://wiki.secondlife.com/wiki/LlVolumeDetect" target="_blank">llVolumeDetect</a>(<a href="https://wiki.secondlife.com/wiki/TRUE" target="_blank">TRUE</a>)</li>
    <li>The avatar must be on the land where &quot;Safe (no damage)&quot; is disabled.
    <ul>
      <li>The object however does not need to be on or even partially over damage enabled land.</li>
    </ul>
  
    </li>
  </ul>
  <p>When these preconditions are met, the avatar receives the damage, and the object will <a href="https://wiki.secondlife.com/wiki/LlDie" target="_blank">die</a> without calling the <a href="https://wiki.secondlife.com/wiki/Category:LSL_Collision" target="_blank">collision</a> events.</p>
  <h2>Caveats</h2>
  <ul>
    <li><b>damage</b> is a <a href="https://wiki.secondlife.com/wiki/Prim_Properties" target="_blank">Prim Property</a>, and may be applied even if there is no running script.</li>
    <li>If <b>damage</b> is 100.0 or greater, the object will instantly <a href="https://wiki.secondlife.com/wiki/Death" target="_blank">kill</a> even a fully healthy avatar.</li>
    <li>If <b>damage</b> is less than zero, the avatar will he healed for the indicated amount.</li>
    <li>If a damage enabled object hits a physics enabled object that one or more avatars are sitting on, damage will be distributed to all seated avatars.</li>
  </ul>
  <h2>Examples</h2>
<div class="lua-block"><span class="tag lua-tag">Lua</span><DocsCode code={`ll = llcompat

--Simple autokiller bullet:
-- This will instantly "kill" on collision if contact is made with avatar on damage enabled land.

function LLEvents.on_rez(param)  -- Becomes active when rezzed.
    ll.SetDamage(100.0)  -- Set the damage to maximum.
    ll.Sensor("", "", AGENT, 96.0, PI)  -- Sweep a 96 meter sphere searching for agents.
end
function LLEvents.sensor(events)  -- If an agent is detected...
    local num = #events
    ll.SetStatus(STATUS_PHYSICS, true)  -- Enable physics to allow physical movement.
    ll.SetTimerEvent(10.0)  -- Set a 10 second timer.
    ll.MoveToTarget(ll.DetectedPos(0), 0.5)  -- Move to the detected position.
end
function LLEvents.no_sensor()  -- If no agents are detected...
    ll.Die()  -- Auto destruct.
end
function LLEvents.timer()  -- If we missed our target...
    ll.Die()  -- Auto destruct.
end
`} lang="slua" /></div>
<div class="lsl-block"><span class="tag lsl-tag">LSL</span><DocsCode code={`//Simple autokiller bullet:
// This will instantly "kill" on collision if contact is made with avatar on damage enabled land.

default
{
    on_rez(integer param) // Becomes active when rezzed.
    {
        llSetDamage(100.0); // Set the damage to maximum.
        llSensor("", "", AGENT, 96.0, PI); // Sweep a 96 meter sphere searching for agents.
    }
    sensor(integer num) // If an agent is detected...
    {
        llSetStatus(STATUS_PHYSICS, TRUE); // Enable physics to allow physical movement.
        llSetTimerEvent(10.0); // Set a 10 second timer.
        llMoveToTarget(llDetectedPos(0), 0.5); // Move to the detected position.
    }
    no_sensor() // If no agents are detected...
    {
        llDie(); // Auto destruct.
    }
    timer() // If we missed our target...
    {
        llDie(); // Auto destruct.
    }
}`} lang="lsl" /></div>
